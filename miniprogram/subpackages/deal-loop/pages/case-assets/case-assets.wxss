.deal-page {
  min-height: 100vh;
  padding: 32rpx;
  background: #F6F7F8;
  box-sizing: border-box;
}

.hero,
.card,
.draft-card {
  border-radius: 16rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 28rpx rgba(15, 23, 42, 0.04);
}

.hero,
.card {
  padding: 30rpx;
}

.card {
  margin-top: 18rpx;
}

.draft-card {
  padding: 22rpx;
  margin-top: 16rpx;
  background: #FAFBFC;
  box-shadow: none;
}

.kicker {
  color: #1B7A56;
  font-size: 24rpx;
  font-weight: 700;
}

.title {
  margin-top: 10rpx;
  color: #111827;
  font-size: 44rpx;
  font-weight: 800;
}

.desc,
.muted,
.draft-body,
.asset-label {
  color: #6B7280;
  font-size: 25rpx;
  line-height: 1.5;
}

.section-title {
  margin-bottom: 18rpx;
  color: #111827;
  font-size: 30rpx;
  font-weight: 800;
}

.picker-row,
.draft-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.case-title,
.material-title,
.draft-title {
  color: #111827;
  font-size: 28rpx;
  font-weight: 800;
}

.picker-action {
  color: #1B7A56;
  font-size: 25rpx;
  font-weight: 700;
}

.field-row {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  padding: 14rpx 0;
  border-top: 1rpx solid #EEF1F3;
  color: #111827;
  font-size: 25rpx;
}

.field-row text:first-child {
  flex-shrink: 0;
  color: #6B7280;
}

.asset-row {
  padding: 18rpx 0;
  border-top: 1rpx solid #EEF1F3;
}

.asset-label {
  font-size: 22rpx;
}

.asset-value {
  margin-top: 8rpx;
  color: #111827;
  font-size: 26rpx;
  line-height: 1.5;
  font-weight: 700;
}

.privacy-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.privacy-pill,
.target-pill,
.check-pill {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #FFF7ED;
  color: #B45309;
  font-size: 22rpx;
}

.target-pill {
  background: #EAF6F0;
  color: #1B7A56;
}

.checklist {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.check-pill {
  background: #F3F4F6;
  color: #4B5563;
}

.material-item {
  padding: 16rpx 0;
  border-top: 1rpx solid #EEF1F3;
}

.draft-body {
  margin-top: 12rpx;
}

.secondary-btn {
  margin-top: 18rpx;
  height: 76rpx;
  border-radius: 12rpx;
  background: #EEF5F1;
  color: #1B7A56;
  font-size: 26rpx;
  line-height: 76rpx;
}

.disabled-btn {
  margin-top: 18rpx;
  height: 76rpx;
  border-radius: 12rpx;
  background: #E5E7EB;
  color: #6B7280;
  font-size: 26rpx;
  line-height: 76rpx;
}
