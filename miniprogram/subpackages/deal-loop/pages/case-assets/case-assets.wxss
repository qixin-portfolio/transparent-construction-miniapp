.deal-page {
  min-height: 100vh;
  padding: 32rpx;
  background: #F6F7F8;
  box-sizing: border-box;
}

.hero,
.card,
.draft-card,
.guard-card {
  border-radius: 16rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 28rpx rgba(15, 23, 42, 0.04);
}

.hero,
.card {
  padding: 30rpx;
}

.card,
.guard-card {
  margin-top: 18rpx;
}

.error-card {
  background: #FEF2F2;
}

.source-row {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
  margin-top: 22rpx;
  padding: 18rpx;
  border-radius: 12rpx;
  background: #F3F4F6;
}

.source-row.real {
  background: #EAF6F0;
}

.source-row.error {
  background: #FEF2F2;
}

.source-dot {
  width: 16rpx;
  height: 16rpx;
  margin-top: 10rpx;
  border-radius: 50%;
  background: #9CA3AF;
}

.source-row.real .source-dot {
  background: #1B7A56;
}

.source-row.error .source-dot {
  background: #DC2626;
}

.source-title {
  color: #111827;
  font-size: 26rpx;
  font-weight: 800;
}

.source-hint {
  margin-top: 4rpx;
  color: #6B7280;
  font-size: 23rpx;
  line-height: 1.45;
}

.kicker {
  color: #1B7A56;
  font-size: 24rpx;
  font-weight: 700;
}

.title {
  margin-top: 10rpx;
  color: #111827;
  font-size: 44rpx;
  font-weight: 800;
}

.desc,
.muted,
.draft-body,
.asset-value,
.guard-item,
.qa-answer {
  color: #6B7280;
  font-size: 25rpx;
  line-height: 1.5;
}

.section-title {
  margin-bottom: 18rpx;
  color: #111827;
  font-size: 30rpx;
  font-weight: 800;
}

.customer-name {
  color: #111827;
  font-size: 32rpx;
  font-weight: 800;
}

.summary-row {
  margin-top: 12rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #F3F4F6;
  color: #111827;
  font-size: 26rpx;
  line-height: 1.45;
  font-weight: 700;
}

.field-row {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  padding: 14rpx 0;
  border-top: 1rpx solid #EEF1F3;
  color: #111827;
  font-size: 25rpx;
}

.field-row text:first-child {
  flex-shrink: 0;
  color: #6B7280;
}

.field-row text:last-child {
  flex: 1;
  text-align: right;
  word-break: break-all;
}

.draft-line {
  margin-top: 12rpx;
  padding: 18rpx;
  border-radius: 12rpx;
  background: #FAFBFC;
  color: #111827;
  font-size: 27rpx;
  line-height: 1.45;
  font-weight: 800;
}

.qa-item,
.material-item {
  padding: 16rpx 0;
  border-top: 1rpx solid #EEF1F3;
}

.qa-question,
.material-title,
.draft-title {
  color: #111827;
  font-size: 27rpx;
  font-weight: 800;
}

.qa-answer,
.draft-body {
  margin-top: 10rpx;
}

.checklist,
.privacy-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.privacy-list {
  margin-top: 16rpx;
  margin-bottom: 0;
}

.check-pill,
.privacy-pill,
.target-pill {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #F3F4F6;
  color: #4B5563;
  font-size: 22rpx;
}

.privacy-pill {
  background: #FFF7ED;
  color: #B45309;
}

.target-pill {
  flex-shrink: 0;
  background: #EAF6F0;
  color: #1B7A56;
}

.draft-card {
  padding: 22rpx;
  margin-top: 16rpx;
  background: #FAFBFC;
  box-shadow: none;
}

.draft-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.safe-note {
  margin-top: 20rpx;
  padding: 18rpx;
  border-radius: 12rpx;
  background: #FFF7ED;
  color: #92400E;
  font-size: 24rpx;
  line-height: 1.5;
}

.secondary-btn {
  margin-top: 18rpx;
  height: 76rpx;
  border-radius: 12rpx;
  background: #EEF5F1;
  color: #1B7A56;
  font-size: 26rpx;
  line-height: 76rpx;
}

.secondary-btn::after,
.mock-primary-btn::after {
  border: none;
}

.mock-primary-btn {
  margin-top: 18rpx;
  height: 82rpx;
  border-radius: 12rpx;
  background: #1B7A56;
  color: #FFFFFF;
  font-size: 27rpx;
  font-weight: 800;
  line-height: 82rpx;
  box-shadow: 0 10rpx 20rpx rgba(27, 122, 86, 0.16);
}

.guard-card.weak {
  padding: 22rpx 24rpx;
  background: #F3F4F6;
  box-shadow: none;
}

.guard-title {
  color: #4B5563;
  font-size: 24rpx;
  font-weight: 700;
}

.guard-item {
  margin-top: 10rpx;
  color: #6B7280;
  font-size: 23rpx;
}
