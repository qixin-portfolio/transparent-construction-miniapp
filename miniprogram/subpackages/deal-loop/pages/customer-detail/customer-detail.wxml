<view class="deal-page" wx:if="{{customer}}">
  <view class="hero">
    <view class="hero-top">
      <view class="title">{{customer.name}}</view>
      <view class="stage-pill {{riskClass}}">{{pipelineLabel}} ｜ {{riskLevel}}</view>
    </view>
    <view class="desc">{{community}} · {{area}} · {{stylePreference}}</view>
    <view class="source-row {{dataSourceClass}}">
      <view class="source-dot"></view>
      <view>
        <view class="source-title">{{dataSourceLabel}}</view>
        <view class="source-hint">{{dataSourceHint}}</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">成交画像</view>
    <view class="field-row"><text>来源</text><text>{{customer.source}}</text></view>
    <view class="field-row"><text>预算</text><text>{{customer.budgetRange}}</text></view>
    <view class="field-row"><text>装修需求</text><text>{{customer.need}}</text></view>
    <view class="field-row"><text>当前顾虑</text><text>{{customer.concern}}</text></view>
    <view class="field-row"><text>阶段</text><text>{{customer.stage}} / {{customer.dealStatus}}</text></view>
    <view class="next-box">
      <view class="next-label">今日动作</view>
      <view class="next-text">{{customer.todayAction}}</view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">示例跟进记录</view>
    <view wx:for="{{followRecords}}" wx:key="followId" class="timeline-item">
      <view class="timeline-head">
        <view class="timeline-title">{{item.typeLabel}} · {{item.createdByName}}</view>
        <view class="muted">{{item.dateText}}</view>
      </view>
      <view class="timeline-text">{{item.content}}</view>
      <view class="feedback">客户反馈：{{item.customerFeedback}}</view>
      <view class="next-box small">
        <view class="next-label">建议动作</view>
        <view class="next-text">{{item.nextAction}}</view>
      </view>
    </view>
    <view wx:if="{{!followRecords.length}}" class="muted">暂无示例跟进记录。</view>
  </view>

  <view class="card">
    <view class="section-title">销售助手建议</view>
    <view class="mock-note">当前为示例建议，不调用真实 AI。</view>
    <view class="assistant-grid">
      <view class="assistant-row">
        <view class="assistant-label">客户当前顾虑</view>
        <view class="assistant-value">{{suggestion.customerConcern}}</view>
      </view>
      <view class="assistant-row">
        <view class="assistant-label">推荐跟进方式</view>
        <view class="assistant-value">{{suggestion.recommendedApproach}}</view>
      </view>
      <view class="assistant-row">
        <view class="assistant-label">可发送素材</view>
        <view class="assistant-value">{{suggestion.materialSendPlan}}</view>
      </view>
      <view class="assistant-row">
        <view class="assistant-label">建议话术</view>
        <view class="suggestion">{{suggestion.recommendedMessage}}</view>
      </view>
    </view>
    <view class="risk-note" wx:for="{{suggestion.riskNotes}}" wx:key="*this">{{item}}</view>
    <view class="button-row">
      <button class="primary-btn" bindtap="goAssistant">打开 AI 话术</button>
      <button class="secondary-btn" bindtap="goMaterials">推荐素材</button>
    </view>
  </view>

  <view class="card">
    <view class="section-title">推荐素材</view>
    <view wx:for="{{materials}}" wx:key="materialId" class="material-item">
      <view class="material-title">{{item.title}}</view>
      <view class="muted">{{item.typeLabel}} · {{item.summary}}</view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">客户安全说明</view>
    <view class="muted">本页只读展示客户资料，仅用于内部成交跟进；完整手机号、身份证、微信身份标识、详细门牌地址均已脱敏隐藏。</view>
  </view>

  <view class="guard-card weak" bindtap="toggleGuards">
    <view class="guard-title">V2 试验功能保护说明</view>
    <view class="guard-hint">{{showGuards ? '收起' : '展开查看'}}</view>
    <view wx:if="{{showGuards}}" wx:for="{{guards}}" wx:key="*this" class="guard-item">{{item}}</view>
  </view>
</view>
