<view class="deal-page">
  <view class="hero">
    <view class="kicker">V2 试验功能</view>
    <view class="title">信任证据库</view>
    <view class="desc">把已审核的工地记录整理成内部成交跟进参考，公开使用需先确认授权。</view>
    <view class="risk-note">仅用于内部成交跟进，不影响现有客户、工地和日报数据。</view>
    <view class="source-row {{dataSourceClass}}">
      <view class="source-dot"></view>
      <view>
        <view class="source-title">{{dataSourceLabel}}</view>
        <view class="source-hint">{{dataSourceHint}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{contextError}}" class="material-card error-card">
    <view class="material-title">{{contextError}}</view>
    <view class="muted">请返回客户列表重新打开，避免使用错误客户的推荐素材。</view>
  </view>

  <view wx:if="{{customer}}" class="material-card">
    <view class="material-head">
      <view>
        <view class="material-title">{{customer.name}}</view>
        <view class="muted">{{customer.stage}} / {{customer.dealStatus}} · {{customer.budgetRange}} · {{customer.community}}</view>
      </view>
      <view class="auth-pill">{{customer.riskLevel}}</view>
    </view>
    <view class="evidence-block">
      <view class="mini-label">当前顾虑</view>
      <view class="summary">{{customer.concern}}</view>
    </view>
    <view class="evidence-block">
      <view class="mini-label">推荐理由</view>
      <view class="summary">{{recommendationSummary}}</view>
    </view>
  </view>

  <view wx:if="{{customer}}" class="material-card evidence-summary-card">
    <view class="material-head">
      <view>
        <view class="material-title">真实证据摘要</view>
        <view class="muted">仅统计已审核、业主可见的工地记录，不展示原始照片和日报正文。</view>
      </view>
      <view class="readonly-pill">只读摘要</view>
    </view>
    <view class="evidence-status-row">
      <view class="evidence-status {{evidenceSummaryView.statusClass}}">{{evidenceSummaryView.statusLabel}}</view>
      <view class="auth-pill {{evidenceSummaryView.authClass}}">{{evidenceSummaryView.authLabel}}</view>
    </view>
    <view class="source-hint">{{evidenceSummaryView.statusHint}}</view>
    <view class="auth-note {{evidenceSummaryView.authClass}}">
      <view class="mini-label">公开授权提示</view>
      <view class="summary">{{evidenceSummaryView.authorizationHint}}</view>
    </view>
    <view wx:if="{{evidenceLoading}}" class="evidence-block">
      <view class="summary">正在读取摘要...</view>
    </view>
    <view wx:else>
      <view wx:if="{{evidenceSummaryView.metrics.length}}" class="evidence-grid">
        <view wx:for="{{evidenceSummaryView.metrics}}" wx:key="label" class="evidence-metric">
          <view class="metric-value">{{item.value}}</view>
          <view class="mini-label">{{item.label}}</view>
        </view>
      </view>
      <view class="evidence-block">
        <view class="mini-label">阶段覆盖</view>
        <view class="summary">{{evidenceSummaryView.stageCoverageText}}</view>
      </view>
      <view class="evidence-block">
        <view class="mini-label">可用证据类型</view>
        <view class="summary">{{evidenceSummaryView.proofTypesText}}</view>
      </view>
      <view class="evidence-block">
        <view class="mini-label">公开使用状态</view>
        <view class="summary">{{evidenceSummaryView.platformText}}</view>
      </view>
      <view wx:if="{{evidenceSummaryView.blockedReasonText}}" class="evidence-block warning-block">
        <view class="mini-label">使用限制</view>
        <view class="summary">{{evidenceSummaryView.blockedReasonText}}</view>
      </view>
    </view>
    <view class="safe-row">
      <view wx:for="{{evidenceSummaryView.safetyItems}}" wx:key="*this" class="safe-chip">{{item}}</view>
    </view>
    <view class="safe-note">本区只展示脱敏摘要，不展示原始照片、文件地址、日报正文和个人隐私。</view>
  </view>

  <scroll-view class="tabs" scroll-x enable-flex>
    <view class="tabs-inner">
      <view
        wx:for="{{materialTypes}}"
        wx:key="code"
        class="tab {{activeType == item.code ? 'active' : ''}}"
        data-type="{{item.code}}"
        bindtap="switchType"
      >{{item.label}}</view>
    </view>
  </scroll-view>

  <view class="material-list">
    <view class="section-title">示例推荐素材</view>
    <view class="section-desc">仅供话术和跟进思路参考，不代表当前客户的真实工地证据。</view>
    <view wx:for="{{materials}}" wx:key="materialId" class="material-card">
      <view class="material-head">
        <view>
          <view class="material-title">{{item.title}}</view>
          <view class="muted">{{item.typeLabel}} · {{item.stageName}}</view>
        </view>
        <view class="auth-pill">{{item.authorizationLabel}}</view>
      </view>
      <view class="evidence-block highlight">
        <view class="mini-label">推荐原因</view>
        <view class="summary">{{item.recommendationReason}}</view>
      </view>
      <view class="evidence-block">
        <view class="mini-label">解决的客户顾虑</view>
        <view class="summary">{{item.matchedConcern || item.concernSolved}}</view>
      </view>
      <view class="evidence-block">
        <view class="mini-label">参考跟进场景</view>
        <view class="summary">{{item.recommendedSendScene || item.sendScene}}</view>
      </view>
      <view class="stage-row">
        <view class="mini-label">适合阶段</view>
        <view class="stage-tags">
          <view wx:for="{{item.suitableStages}}" wx:key="*this" class="stage-tag">{{item}}</view>
        </view>
      </view>
      <view class="tag-row">
        <view wx:for="{{item.tags}}" wx:key="*this" class="tag">{{item}}</view>
      </view>
      <view class="meta-row">
        <view>来源：示例素材</view>
        <view>示例可见性：{{item.ownerVisible ? '业主可见' : '内部参考'}}</view>
      </view>
      <button class="secondary-btn" data-id="{{item.materialId}}" bindtap="previewExampleMaterial">查看示例话术</button>
    </view>
    <view wx:if="{{!materials.length && !contextError}}" class="material-card">
      <view class="material-title">暂无匹配素材</view>
      <view class="muted">当前筛选下没有示例推荐素材，可以切换到“全部”查看。</view>
    </view>
  </view>
</view>
