.deal-page {
  min-height: 100vh;
  padding: 32rpx;
  background: #F6F7F8;
  box-sizing: border-box;
}

.hero,
.material-card {
  border-radius: 16rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 28rpx rgba(15, 23, 42, 0.04);
}

.hero,
.material-card {
  padding: 30rpx;
}

.kicker {
  color: #1B7A56;
  font-size: 24rpx;
  font-weight: 700;
}

.title {
  margin-top: 10rpx;
  color: #111827;
  font-size: 44rpx;
  font-weight: 800;
}

.desc,
.muted,
.meta-row {
  color: #6B7280;
  font-size: 25rpx;
  line-height: 1.5;
}

.tabs {
  margin-top: 24rpx;
  white-space: nowrap;
}

.tabs-inner {
  display: flex;
  gap: 14rpx;
  width: max-content;
}

.tab {
  padding: 18rpx 26rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #4B5563;
  font-size: 25rpx;
}

.tab.active {
  background: #1B7A56;
  color: #FFFFFF;
  font-weight: 700;
}

.material-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 24rpx;
}

.material-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.material-title {
  color: #111827;
  font-size: 31rpx;
  font-weight: 800;
}

.auth-pill {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #EEF5F1;
  color: #1B7A56;
  font-size: 21rpx;
}

.summary {
  color: #111827;
  font-size: 27rpx;
  line-height: 1.55;
}

.evidence-block {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 12rpx;
  background: #FAFBFC;
}

.mini-label {
  color: #6B7280;
  font-size: 22rpx;
  line-height: 1.4;
}

.stage-row {
  margin-top: 18rpx;
}

.stage-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 10rpx;
}

.stage-tag {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #EAF6F0;
  color: #1B7A56;
  font-size: 22rpx;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.tag {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #FAFBFC;
  color: #4B5563;
  font-size: 22rpx;
}

.meta-row {
  display: flex;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 18rpx;
}

.secondary-btn {
  margin-top: 20rpx;
  height: 76rpx;
  border-radius: 12rpx;
  background: #EEF5F1;
  color: #1B7A56;
  font-size: 26rpx;
  line-height: 76rpx;
}
