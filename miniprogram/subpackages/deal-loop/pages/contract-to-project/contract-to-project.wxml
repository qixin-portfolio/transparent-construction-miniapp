<view class="deal-page">
  <view class="hero">
    <view class="kicker">草案预览 / 内部参考</view>
    <view class="title">签约转工地草案</view>
    <view class="desc">根据客户资料整理工地创建草案，当前不会写入正式工地，不影响现有项目数据。</view>
    <view class="source-row {{dataSourceClass}}">
      <view class="source-dot"></view>
      <view>
        <view class="source-title">{{dataSourceLabel}}</view>
        <view class="source-hint">{{dataSourceHint}}</view>
      </view>
    </view>
  </view>

  <view wx:if="{{contextError}}" class="card error-card">
    <view class="section-title">{{contextError}}</view>
    <view class="muted">请返回客户列表重新打开，避免用错误客户生成工地草案。</view>
  </view>

  <view wx:if="{{customer}}" class="card">
    <view class="section-title">客户</view>
    <view class="customer-name">{{customer.name}}</view>
    <view class="muted">{{customer.community}} · {{customer.area}} · {{customer.stylePreference}}</view>
    <view class="muted">{{customer.stage}} / {{customer.dealStatus}} · {{customer.budgetRange}}</view>
    <view class="next-box">
      <view class="next-label">当前动作</view>
      <view class="next-text">{{customer.nextAction}}</view>
    </view>
  </view>

  <view wx:if="{{mappingRows.length}}" class="card">
    <view class="section-title">草案字段对应</view>
    <view wx:for="{{mappingRows}}" wx:key="from" class="mapping-row">
      <view class="mapping-head">
        <text>{{item.from}}</text>
        <text>→</text>
        <text>{{item.to}}</text>
      </view>
      <view class="mapping-value">{{item.value}}</view>
    </view>
  </view>

  <view wx:if="{{projectDraft}}" class="card">
    <view class="section-title">工地创建草案</view>
    <view class="field-row"><text>关联客户</text><text>{{projectDraft.customerName}}</text></view>
    <view class="field-row"><text>业主姓名草案</text><text>{{projectDraft.ownerName}}</text></view>
    <view class="field-row"><text>工地小区草案</text><text>{{projectDraft.projectCommunity}}</text></view>
    <view class="field-row"><text>工地面积草案</text><text>{{projectDraft.projectArea}}</text></view>
    <view class="field-row"><text>装修风格草案</text><text>{{projectDraft.projectStyle}}</text></view>
    <view class="field-row"><text>预算备注</text><text>{{projectDraft.budgetNote}}</text></view>
    <view class="field-row"><text>客户来源备注</text><text>{{projectDraft.sourceNote}}</text></view>
    <view class="field-row"><text>转工地前置状态</text><text>{{projectDraft.preProjectStatus}}</text></view>
    <view class="field-row"><text>项目备注草案</text><text>{{projectDraft.projectRemarkDraft}}</text></view>
    <view class="safe-note">当前仅为草案预览，不会创建真实工地，不影响现有项目数据。</view>
    <button class="secondary-btn" bindtap="copyDraft">复制草案内容</button>
    <button class="mock-primary-btn" bindtap="mockGenerateDraft">预览工地草案</button>
  </view>

  <view wx:if="{{checklist.length}}" class="card">
    <view class="section-title">风险检查</view>
    <view wx:for="{{checklist}}" wx:key="label" class="check-row">
      <view class="check-dot {{item.ok ? 'ok' : ''}}">{{item.ok ? '通过' : '待补'}}</view>
      <view class="check-label">{{item.label}}</view>
    </view>
    <view class="gate-box">{{gateMessage}}</view>
  </view>

  <view class="guard-card weak" bindtap="toggleGuards">
    <view class="guard-title">V2 试验功能保护说明</view>
    <view class="guard-hint">{{showGuards ? '收起' : '展开查看'}}</view>
    <view wx:if="{{showGuards}}" wx:for="{{guards}}" wx:key="*this" class="guard-item">{{item}}</view>
  </view>
</view>
