.deal-page {
  min-height: 100vh;
  padding: 32rpx;
  background: #F6F7F8;
  box-sizing: border-box;
}

.hero,
.card,
.guard-card {
  padding: 30rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 28rpx rgba(15, 23, 42, 0.04);
}

.card {
  margin-top: 18rpx;
}

.error-card {
  background: #FEF2F2;
}

.source-row {
  display: flex;
  gap: 16rpx;
  align-items: flex-start;
  margin-top: 22rpx;
  padding: 18rpx;
  border-radius: 12rpx;
  background: #F3F4F6;
}

.source-row.real {
  background: #EAF6F0;
}

.source-row.error {
  background: #FEF2F2;
}

.source-dot {
  width: 16rpx;
  height: 16rpx;
  margin-top: 10rpx;
  border-radius: 50%;
  background: #9CA3AF;
}

.source-row.real .source-dot {
  background: #1B7A56;
}

.source-row.error .source-dot {
  background: #DC2626;
}

.source-title {
  color: #111827;
  font-size: 26rpx;
  font-weight: 800;
}

.source-hint {
  margin-top: 4rpx;
  color: #6B7280;
  font-size: 23rpx;
  line-height: 1.45;
}

.kicker {
  color: #B45309;
  font-size: 24rpx;
  font-weight: 700;
}

.title {
  margin-top: 10rpx;
  color: #111827;
  font-size: 44rpx;
  font-weight: 800;
}

.desc,
.muted,
.guard-item,
.mapping-value {
  color: #6B7280;
  font-size: 25rpx;
  line-height: 1.5;
}

.section-title {
  margin-bottom: 18rpx;
  color: #111827;
  font-size: 30rpx;
  font-weight: 800;
}

.customer-name {
  color: #111827;
  font-size: 32rpx;
  font-weight: 800;
}

.next-box,
.gate-box {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 12rpx;
  background: #FFF7ED;
}

.next-label {
  color: #92400E;
  font-size: 22rpx;
}

.next-text,
.gate-box {
  color: #111827;
  font-size: 26rpx;
  line-height: 1.5;
  font-weight: 700;
}

.field-row,
.check-row,
.guard-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 14rpx 0;
  border-top: 1rpx solid #EEF1F3;
  color: #111827;
  font-size: 25rpx;
}

.field-row text:last-child {
  flex: 1;
  text-align: right;
  word-break: break-all;
}

.mapping-row {
  padding: 18rpx 0;
  border-top: 1rpx solid #EEF1F3;
}

.mapping-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  color: #111827;
  font-size: 25rpx;
  font-weight: 800;
}

.mapping-value {
  margin-top: 8rpx;
}

.field-row text:first-child {
  color: #6B7280;
  flex-shrink: 0;
}

.safe-note {
  margin-top: 20rpx;
  padding: 18rpx;
  border-radius: 12rpx;
  background: #FFF7ED;
  color: #92400E;
  font-size: 24rpx;
  line-height: 1.5;
}

.secondary-btn {
  margin-top: 20rpx;
  height: 76rpx;
  border-radius: 12rpx;
  background: #EEF5F1;
  color: #1B7A56;
  font-size: 26rpx;
  line-height: 76rpx;
}

.mock-primary-btn {
  margin-top: 16rpx;
  height: 84rpx;
  border-radius: 12rpx;
  background: #B45309;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 84rpx;
  box-shadow: 0 10rpx 20rpx rgba(180, 83, 9, 0.18);
}

.mock-primary-btn::after {
  border: none;
}

.disabled-btn {
  margin-top: 14rpx;
  height: 76rpx;
  border-radius: 12rpx;
  background: #E5E7EB;
  color: #6B7280;
  font-size: 26rpx;
  line-height: 76rpx;
}

.check-dot {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #FEE2E2;
  color: #B91C1C;
  font-size: 22rpx;
}

.check-dot.ok {
  background: #EAF6F0;
  color: #1B7A56;
}

.check-label {
  flex: 1;
  text-align: right;
}

.guard-card.weak {
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
  background: #F3F4F6;
  box-shadow: none;
}

.guard-title {
  color: #4B5563;
  font-size: 24rpx;
  font-weight: 700;
}

.guard-hint {
  margin-top: 6rpx;
  color: #9CA3AF;
  font-size: 22rpx;
}
