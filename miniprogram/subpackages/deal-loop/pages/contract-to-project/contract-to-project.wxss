.deal-page {
  min-height: 100vh;
  padding: 32rpx;
  background: #F6F7F8;
  box-sizing: border-box;
}

.hero,
.card {
  padding: 30rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 28rpx rgba(15, 23, 42, 0.04);
}

.card {
  margin-top: 18rpx;
}

.kicker {
  color: #B45309;
  font-size: 24rpx;
  font-weight: 700;
}

.title {
  margin-top: 10rpx;
  color: #111827;
  font-size: 44rpx;
  font-weight: 800;
}

.desc,
.muted,
.guard-item {
  color: #6B7280;
  font-size: 25rpx;
  line-height: 1.5;
}

.section-title {
  margin-bottom: 18rpx;
  color: #111827;
  font-size: 30rpx;
  font-weight: 800;
}

.customer-name {
  color: #111827;
  font-size: 32rpx;
  font-weight: 800;
}

.next-box,
.gate-box {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 12rpx;
  background: #FFF7ED;
}

.next-label {
  color: #92400E;
  font-size: 22rpx;
}

.next-text,
.gate-box {
  color: #111827;
  font-size: 26rpx;
  line-height: 1.5;
  font-weight: 700;
}

.field-row,
.check-row,
.guard-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 14rpx 0;
  border-top: 1rpx solid #EEF1F3;
  color: #111827;
  font-size: 25rpx;
}

.field-row text:first-child {
  color: #6B7280;
  flex-shrink: 0;
}

.secondary-btn {
  margin-top: 20rpx;
  height: 76rpx;
  border-radius: 12rpx;
  background: #EEF5F1;
  color: #1B7A56;
  font-size: 26rpx;
  line-height: 76rpx;
}

.check-dot {
  flex-shrink: 0;
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: #FEE2E2;
  color: #B91C1C;
  font-size: 22rpx;
}

.check-dot.ok {
  background: #EAF6F0;
  color: #1B7A56;
}

.check-label {
  flex: 1;
  text-align: right;
}
