.deal-page {
  min-height: 100vh;
  padding: 32rpx;
  background: #F6F7F8;
  box-sizing: border-box;
}

.hero,
.customer-card,
.feedback-card,
.followup-card,
.guard-card,
.stat-card {
  border-radius: 16rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 28rpx rgba(15, 23, 42, 0.04);
}

.hero {
  padding: 34rpx;
}

.hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.kicker {
  flex-shrink: 0;
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  background: #F3F4F6;
  color: #6B7280;
  font-size: 20rpx;
}

.title {
  color: #111827;
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.25;
}

.desc,
.muted,
.info-row,
.guard-item {
  color: #6B7280;
  font-size: 25rpx;
  line-height: 1.5;
}

.desc {
  margin-top: 12rpx;
}

.safe-note {
  margin-top: 16rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  background: #EAF6F0;
  color: #1B7A56;
  font-size: 23rpx;
  line-height: 1.45;
  font-weight: 700;
}

.source-row {
  display: flex;
  align-items: flex-start;
  gap: 14rpx;
  margin-top: 20rpx;
  padding: 16rpx;
  border-radius: 12rpx;
  background: #F3F4F6;
}

.source-row.real {
  background: #EAF6F0;
}

.source-dot {
  width: 14rpx;
  height: 14rpx;
  margin-top: 10rpx;
  border-radius: 50%;
  background: #9CA3AF;
}

.source-row.real .source-dot {
  background: #1B7A56;
}

.source-title {
  color: #111827;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.4;
}

.source-hint {
  margin-top: 4rpx;
  color: #6B7280;
  font-size: 22rpx;
  line-height: 1.45;
}

.stats-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
  margin-top: 20rpx;
}

.stat-card {
  padding: 22rpx 10rpx;
  text-align: center;
}

.stat-num {
  color: #111827;
  font-size: 36rpx;
  font-weight: 800;
}

.stat-num.warn {
  color: #B45309;
}

.stat-num.success {
  color: #1B7A56;
}

.stat-num.danger {
  color: #B91C1C;
}

.stat-label {
  margin-top: 8rpx;
  color: #6B7280;
  font-size: 22rpx;
}

.tabs {
  margin-top: 24rpx;
  white-space: nowrap;
}

.tabs-inner {
  display: flex;
  gap: 14rpx;
  width: max-content;
}

.tab {
  padding: 18rpx 26rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #4B5563;
  font-size: 25rpx;
}

.tab.active {
  background: #1B7A56;
  color: #FFFFFF;
  font-weight: 700;
}

.section-title {
  margin-top: 28rpx;
  margin-bottom: 16rpx;
  color: #111827;
  font-size: 30rpx;
  font-weight: 800;
}

.section-title.inline {
  margin-top: 0;
}

.feedback-card,
.followup-card {
  margin-top: 18rpx;
  padding: 26rpx;
}

.feedback-desc {
  color: #6B7280;
  font-size: 25rpx;
  line-height: 1.5;
}

.feedback-question {
  margin-top: 14rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  background: #FAFBFC;
  color: #111827;
  font-size: 24rpx;
  line-height: 1.45;
  font-weight: 700;
}

.copy-btn {
  margin-top: 18rpx;
  height: 72rpx;
  border-radius: 12rpx;
  background: #EEF5F1;
  color: #1B7A56;
  font-size: 25rpx;
  line-height: 72rpx;
  font-weight: 700;
}

.tip-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
}

.tip-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 14rpx 16rpx;
  border-radius: 12rpx;
  background: #F8FAF9;
  color: #374151;
  font-size: 24rpx;
  line-height: 1.4;
  font-weight: 700;
}

.tip-dot {
  flex-shrink: 0;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #1B7A56;
}

.customer-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.customer-card {
  padding: 28rpx;
}

.customer-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.customer-name {
  color: #111827;
  font-size: 32rpx;
  font-weight: 800;
}

.stage-pill {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #EAF6F0;
  color: #1B7A56;
  font-size: 23rpx;
  font-weight: 700;
}

.info-row {
  margin-top: 14rpx;
}

.action-label {
  display: inline-flex;
  margin-top: 16rpx;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  background: #FFF7ED;
  color: #B45309;
  font-size: 22rpx;
  font-weight: 700;
}

.next-box {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 12rpx;
  background: #FAFBFC;
}

.next-label {
  color: #6B7280;
  font-size: 22rpx;
}

.next-text {
  margin-top: 6rpx;
  color: #111827;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.45;
}

.deal-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 14rpx;
  margin-top: 16rpx;
}

.mini-label {
  color: #6B7280;
  font-size: 22rpx;
}

.mini-value {
  margin-top: 4rpx;
  color: #111827;
  font-size: 25rpx;
  line-height: 1.45;
}

.risk-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
}

.risk-pill {
  flex-shrink: 0;
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
}

.risk-pill.risk-high {
  background: #FEE2E2;
  color: #B91C1C;
}

.risk-pill.risk-medium {
  background: #FEF3C7;
  color: #B45309;
}

.risk-pill.risk-low {
  background: #EAF6F0;
  color: #1B7A56;
}

.risk-reason {
  color: #6B7280;
  font-size: 23rpx;
  line-height: 1.4;
}

.sales-action-card {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 12rpx;
  background: #F8FAF9;
}

.sales-action-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}

.sales-action-title {
  color: #111827;
  font-size: 25rpx;
  font-weight: 800;
}

.sales-action-tag {
  flex-shrink: 0;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #EEF5F1;
  color: #1B7A56;
  font-size: 21rpx;
  font-weight: 700;
}

.sales-action-main {
  margin-top: 10rpx;
  color: #111827;
  font-size: 26rpx;
  line-height: 1.45;
  font-weight: 800;
}

.sales-action-row {
  display: grid;
  grid-template-columns: 120rpx 1fr;
  gap: 12rpx;
  margin-top: 10rpx;
  color: #4B5563;
  font-size: 23rpx;
  line-height: 1.45;
}

.sales-action-row text:first-child {
  color: #6B7280;
}

.card-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 18rpx;
}

.mock-btn {
  flex: 1;
  height: 68rpx;
  border-radius: 12rpx;
  background: #F3F4F6;
  color: #374151;
  font-size: 24rpx;
  line-height: 68rpx;
}

.mock-btn.primary {
  background: #1B7A56;
  color: #FFFFFF;
}

.guard-card {
  margin-top: 24rpx;
  padding: 28rpx;
}

.guard-card.weak {
  padding: 22rpx 24rpx;
  background: #F3F4F6;
  box-shadow: none;
}

.guard-title {
  color: #4B5563;
  font-size: 24rpx;
  font-weight: 700;
}

.guard-hint {
  margin-top: 6rpx;
  color: #9CA3AF;
  font-size: 22rpx;
}

.guard-item {
  padding: 10rpx 0;
  border-top: 1rpx solid #EEF1F3;
}
