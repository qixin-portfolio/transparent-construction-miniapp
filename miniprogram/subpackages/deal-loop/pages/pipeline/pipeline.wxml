<view class="deal-page">
  <view class="hero">
    <view class="hero-top">
      <view class="title">今日成交跟进</view>
      <view class="kicker">V2 试验功能 / 只读客户资料 / 不影响现有数据</view>
    </view>
    <view class="desc">看清客户阶段、下一步动作和可发送的信任素材</view>
    <view class="source-row {{dataSourceClass}}">
      <view class="source-dot"></view>
      <view>
        <view class="source-title">{{dataSourceLabel}}</view>
        <view class="source-hint">{{dataSourceHint}}</view>
      </view>
    </view>
  </view>

  <view class="stats-grid">
    <view class="stat-card">
      <view class="stat-num">{{stats.todayFollow}}</view>
      <view class="stat-label">今日待跟进</view>
    </view>
    <view class="stat-card">
      <view class="stat-num warn">{{stats.keyPush}}</view>
      <view class="stat-label">重点推进</view>
    </view>
    <view class="stat-card">
      <view class="stat-num success">{{stats.closing}}</view>
      <view class="stat-label">临门一脚</view>
    </view>
    <view class="stat-card">
      <view class="stat-num danger">{{stats.highRisk}}</view>
      <view class="stat-label">高风险</view>
    </view>
  </view>

  <scroll-view class="tabs" scroll-x enable-flex>
    <view class="tabs-inner">
      <view
        wx:for="{{stageTabs}}"
        wx:key="code"
        class="tab {{activeFilter == item.code ? 'active' : ''}}"
        data-code="{{item.code}}"
        bindtap="switchStage"
      >{{item.label}}</view>
    </view>
  </scroll-view>

  <view class="section-title">成交作战队列</view>
  <view class="customer-list">
    <view wx:for="{{visibleCustomers}}" wx:key="customerId" class="customer-card">
      <view class="customer-head">
        <view>
          <view class="customer-name">{{item.name}}</view>
          <view class="muted">{{item.community}} · {{item.area}} · {{item.stylePreference}}</view>
        </view>
        <view class="stage-pill">{{item.pipelineLabel}}</view>
      </view>
      <view class="info-row">预算：{{item.budgetRange}} ｜ 来源：{{item.source}}</view>
      <view class="action-label">{{item.actionBucketLabel}}</view>
      <view class="next-box">
        <view class="next-label">今日动作</view>
        <view class="next-text">{{item.todayAction}}</view>
      </view>
      <view class="deal-grid">
        <view>
          <view class="mini-label">推荐素材</view>
          <view class="mini-value">{{item.recommendedMaterial}}</view>
        </view>
        <view>
          <view class="mini-label">建议话术</view>
          <view class="mini-value">{{item.suggestedTalk}}</view>
        </view>
      </view>
      <view class="risk-row">
        <view class="risk-pill {{item.riskClass}}">{{item.riskLevel}}</view>
        <view class="risk-reason">{{item.primaryRiskReason}}</view>
      </view>
      <view class="card-actions">
        <button class="mock-btn" data-id="{{item.customerId}}" bindtap="goCustomerDetail">看客户</button>
        <button class="mock-btn primary" data-id="{{item.customerId}}" bindtap="goAssistant">AI 话术</button>
        <button class="mock-btn" data-id="{{item.customerId}}" bindtap="goMaterials">推荐素材</button>
      </view>
    </view>
  </view>

  <view class="guard-card weak" bindtap="toggleGuards">
    <view class="guard-title">V2 试验功能保护说明</view>
    <view class="guard-hint">{{showGuards ? '收起' : '展开查看'}}</view>
    <view wx:if="{{showGuards}}" wx:for="{{guards}}" wx:key="*this" class="guard-item">{{item}}</view>
  </view>
</view>
