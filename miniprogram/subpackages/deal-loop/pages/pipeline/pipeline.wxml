<view class="deal-page">
  <view class="hero">
    <view class="kicker">Phase 2 Mock</view>
    <view class="title">客户成交管道</view>
    <view class="desc">本页面只读取本地 mock 数据，不调用云函数，不写入真实数据库。</view>
  </view>

  <view class="stats-grid">
    <view class="stat-card">
      <view class="stat-num">{{stats.total}}</view>
      <view class="stat-label">客户总数</view>
    </view>
    <view class="stat-card">
      <view class="stat-num warn">{{stats.hot}}</view>
      <view class="stat-label">重点跟进</view>
    </view>
    <view class="stat-card">
      <view class="stat-num success">{{stats.signed}}</view>
      <view class="stat-label">已签约</view>
    </view>
    <view class="stat-card">
      <view class="stat-num danger">{{stats.highRisk}}</view>
      <view class="stat-label">高风险</view>
    </view>
  </view>

  <scroll-view class="tabs" scroll-x enable-flex>
    <view class="tabs-inner">
      <view
        wx:for="{{stageTabs}}"
        wx:key="code"
        class="tab {{activeStage == item.code ? 'active' : ''}}"
        data-code="{{item.code}}"
        bindtap="switchStage"
      >{{item.label}}</view>
    </view>
  </scroll-view>

  <view class="section-title">客户列表</view>
  <view class="customer-list">
    <view wx:for="{{visibleCustomers}}" wx:key="customerId" class="customer-card" data-id="{{item.customerId}}" bindtap="goCustomerDetail">
      <view class="customer-head">
        <view>
          <view class="customer-name">{{item.name}}</view>
          <view class="muted">{{item.community}} · {{item.area}} · {{item.stylePreference}}</view>
        </view>
        <view class="stage-pill">{{item.pipelineLabel}}</view>
      </view>
      <view class="info-row">预算：{{item.budgetRange}} ｜ 来源：{{item.source}}</view>
      <view class="next-box">
        <view class="next-label">下一步</view>
        <view class="next-text">{{item.nextAction}}</view>
      </view>
      <view class="card-actions">
        <view class="text-action" data-id="{{item.customerId}}" catchtap="goAssistant">AI mock 建议</view>
        <view class="risk {{item.riskLevel}}">{{item.riskLevel}}</view>
      </view>
    </view>
  </view>

  <view class="guard-card">
    <view class="section-title">Phase 2 保护规则</view>
    <view wx:for="{{guards}}" wx:key="*this" class="guard-item">{{item}}</view>
  </view>
</view>
