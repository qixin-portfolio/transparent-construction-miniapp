<view class="deal-page" wx:if="{{customer}}">
  <view class="hero">
    <view class="kicker">Mock only</view>
    <view class="title">AI 跟进助手</view>
    <view class="desc">当前为本地 mock 建议，不调用真实 AI。</view>
  </view>

  <view class="card">
    <view class="section-title">客户上下文</view>
    <view class="muted">当前 URL customerId：{{urlCustomerId ? urlCustomerId : '无'}}</view>
    <view class="muted">当前客户姓名：{{currentCustomerName}}</view>
    <view class="muted">数据源状态：{{contextStatus}}</view>
    <view wx:if="{{contextError}}" class="risk-note">{{contextError}}</view>
  </view>

  <view class="card">
    <view class="section-title">选择客户</view>
    <picker range="{{customers}}" range-key="name" value="{{selectedIndex}}" bindchange="onCustomerChange">
      <view class="picker-row">
        <view>
          <view class="customer-name">{{customer.name}}</view>
          <view class="muted">{{customer.stage}} · {{customer.budgetRange}} · {{customer.community}}</view>
        </view>
        <view class="picker-action">更换</view>
      </view>
    </picker>
  </view>

  <view class="card">
    <view class="section-title">客户顾虑</view>
    <view class="concern">{{suggestion.customerConcern}}</view>
    <view class="muted">触发阶段：{{suggestion.triggerStage}} ｜ 生成方式：{{suggestion.generatedBy}}</view>
  </view>

  <view class="card">
    <view class="section-title">推荐跟进方式</view>
    <view class="strategy">{{suggestion.recommendedApproach}}</view>
    <view class="next-box">
      <view class="next-label">可发送素材</view>
      <view class="next-text">{{suggestion.materialSendPlan}}</view>
    </view>
  </view>

  <view class="card output-card">
    <view class="section-title">建议话术</view>
    <view class="message">{{suggestion.recommendedMessage}}</view>
    <view class="next-box">
      <view class="next-label">下一步动作</view>
      <view class="next-text">{{suggestion.nextAction}}</view>
    </view>
    <view class="button-row">
      <button class="primary-btn" bindtap="copyMessage">复制话术</button>
      <button class="secondary-btn" bindtap="regenerate">重新生成 mock</button>
    </view>
  </view>

  <view class="card">
    <view class="section-title">推荐素材</view>
    <view wx:for="{{suggestion.materials}}" wx:key="materialId" class="material-item">
      <view class="material-title">{{item.title}}</view>
      <view class="muted">{{item.typeLabel}} · {{item.concernSolved}}</view>
      <view class="send-scene">{{item.sendScene}}</view>
    </view>
  </view>

  <view class="card">
    <view class="section-title">风险提示</view>
    <view wx:for="{{suggestion.riskNotes}}" wx:key="*this" class="risk-note">{{item}}</view>
  </view>

  <view class="guard-card weak" bindtap="toggleGuards">
    <view class="guard-title">Phase 2.5 本地 mock 保护规则</view>
    <view class="guard-hint">{{showGuards ? '收起' : '展开查看'}}</view>
    <view wx:if="{{showGuards}}" wx:for="{{guards}}" wx:key="*this" class="guard-item">{{item}}</view>
  </view>
</view>
