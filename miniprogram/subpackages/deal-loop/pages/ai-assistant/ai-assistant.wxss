.deal-page {
  min-height: 100vh;
  padding: 32rpx;
  background: #F6F7F8;
  box-sizing: border-box;
}

.hero,
.card,
.guard-card {
  padding: 30rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 28rpx rgba(15, 23, 42, 0.04);
}

.card {
  margin-top: 18rpx;
}

.kicker {
  color: #1B7A56;
  font-size: 24rpx;
  font-weight: 700;
}

.title {
  margin-top: 10rpx;
  color: #111827;
  font-size: 44rpx;
  font-weight: 800;
}

.desc,
.muted,
.guard-item,
.send-scene {
  color: #6B7280;
  font-size: 25rpx;
  line-height: 1.5;
}

.section-title {
  margin-bottom: 18rpx;
  color: #111827;
  font-size: 30rpx;
  font-weight: 800;
}

.picker-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  padding: 20rpx;
  border-radius: 12rpx;
  background: #FAFBFC;
}

.customer-name,
.material-title {
  color: #111827;
  font-size: 28rpx;
  font-weight: 800;
}

.picker-action {
  color: #1B7A56;
  font-size: 25rpx;
  font-weight: 700;
}

.concern {
  color: #B45309;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 1.4;
}

.message {
  color: #111827;
  font-size: 30rpx;
  line-height: 1.65;
  font-weight: 700;
}

.strategy {
  color: #111827;
  font-size: 29rpx;
  line-height: 1.6;
  font-weight: 800;
}

.next-box {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 12rpx;
  background: #FAFBFC;
}

.next-label {
  color: #6B7280;
  font-size: 22rpx;
}

.next-text {
  margin-top: 6rpx;
  color: #111827;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.45;
}

.button-row {
  display: flex;
  gap: 14rpx;
  margin-top: 22rpx;
}

.primary-btn,
.secondary-btn {
  flex: 1;
  height: 78rpx;
  border-radius: 12rpx;
  font-size: 26rpx;
  line-height: 78rpx;
}

.primary-btn {
  background: #1B7A56;
  color: #FFFFFF;
}

.secondary-btn {
  background: #EEF5F1;
  color: #1B7A56;
}

.material-item,
.guard-item,
.risk-note {
  padding: 14rpx 0;
  border-top: 1rpx solid #EEF1F3;
}

.risk-note {
  color: #B45309;
  font-size: 24rpx;
}

.send-scene {
  margin-top: 8rpx;
}

.guard-card.weak {
  margin-top: 18rpx;
  padding: 22rpx 24rpx;
  background: #F3F4F6;
  box-shadow: none;
}

.guard-title {
  color: #4B5563;
  font-size: 24rpx;
  font-weight: 700;
}

.guard-hint {
  margin-top: 6rpx;
  color: #9CA3AF;
  font-size: 22rpx;
}
