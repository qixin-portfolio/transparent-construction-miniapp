.page {
  min-height: 100vh;
  padding: 0 28rpx calc(48rpx + env(safe-area-inset-bottom));
  background: #FAFBFC;
  box-sizing: border-box;
}

.hero {
  margin: 0 -28rpx 28rpx;
  padding: 52rpx 32rpx 44rpx;
  color: #FFFFFF;
  background: linear-gradient(150deg, #0D4D36 0%, #1B7A56 58%, #2AA876 100%);
}

.hero-eyebrow {
  display: inline-flex;
  min-height: 44rpx;
  align-items: center;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  font-size: 23rpx;
  font-weight: 700;
}

.hero-title {
  margin-top: 18rpx;
  font-size: 44rpx;
  line-height: 1.18;
  font-weight: 800;
}

.hero-desc {
  margin-top: 14rpx;
  max-width: 620rpx;
  color: rgba(255, 255, 255, 0.84);
  font-size: 25rpx;
  line-height: 1.55;
}

.card {
  margin-bottom: 24rpx;
  padding: 32rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 32rpx rgba(13, 77, 54, 0.05);
  box-sizing: border-box;
}

.card-title {
  color: #1A1A1A;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.35;
}

.card-desc {
  margin-top: 8rpx;
  color: #6B7280;
  font-size: 24rpx;
  line-height: 1.5;
}

.form-group {
  margin-top: 24rpx;
}

.form-label {
  margin-bottom: 12rpx;
  color: #374151;
  font-size: 26rpx;
  font-weight: 700;
}

.form-input {
  width: 100%;
  min-height: 88rpx;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background: #F8FAF9;
  color: #1A1A1A;
  font-size: 28rpx;
  box-sizing: border-box;
}

.picker-display {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
  min-height: 88rpx;
  padding: 22rpx 24rpx;
  border-radius: 22rpx;
  background: #F8FAF9;
  box-sizing: border-box;
}

.picker-value {
  color: #1A1A1A;
  font-size: 28rpx;
}

.picker-value.placeholder {
  color: #9CA3AF;
}

.picker-arrow {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: #1B7A56;
  color: #FFFFFF;
  font-size: 23rpx;
  font-weight: 600;
}

.photo-uploader {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 20rpx;
}

.photo-thumb {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  border-radius: 18rpx;
  overflow: hidden;
}

.photo-thumb image {
  width: 100%;
  height: 100%;
}

.photo-remove {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #FFFFFF;
  font-size: 28rpx;
  line-height: 36rpx;
  text-align: center;
}

.photo-add {
  width: 180rpx;
  height: 180rpx;
  border-radius: 18rpx;
  background: #E8F5EE;
  color: #1B7A56;
  font-size: 56rpx;
  line-height: 180rpx;
  text-align: center;
  font-weight: 300;
}

.action-area {
  margin-top: 36rpx;
}

.btn-primary {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #1B7A56, #2AA876);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.btn-primary::after {
  border: none;
}

.action-tip {
  margin-top: 16rpx;
  color: #9CA3AF;
  font-size: 23rpx;
  line-height: 1.5;
  text-align: center;
}
