/* ================================================================
   审核日报
   ================================================================ */
.review-page {
  padding: 0 32rpx 56rpx;
}

.page-header {
  margin: 24rpx 0 24rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #111827;
  line-height: 1.3;
}

.review-count {
  margin-top: 16rpx;
}

/* 审核列表 */
.review-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.review-card {
  padding: 32rpx;
}

.review-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F3F4F6;
}

.review-project-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
  line-height: 1.3;
  flex: 1;
}

.review-content {
  margin-bottom: 16rpx;
}

.form-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #6B7280;
  margin-bottom: 10rpx;
  line-height: 1.4;
}

.review-text {
  font-size: 28rpx;
  color: #111827;
  line-height: 1.6;
}

.risk-box {
  margin-bottom: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: #FEE2E2;
  color: #B91C1C;
  font-size: 26rpx;
  line-height: 1.5;
}

/* 照片 */
.review-photos {
  margin-bottom: 20rpx;
}

.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 12rpx;
}

.photo-wrap {
  width: 100%;
  height: 200rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.photo-wrap:active {
  opacity: 0.88;
}

.photo {
  width: 100%;
  height: 100%;
}

/* 审核操作 */
.review-actions {
  display: grid;
  grid-template-columns: 1fr 1.2fr;
  gap: 16rpx;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #F3F4F6;
}

/* 空状态 */
.review-empty {
  margin-top: 40rpx;
}

/* UI 1.1 · 审核日报 */
.review-page {
  min-height: 100vh;
  padding: 24rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
  background: #F8F4EA;
  box-sizing: border-box;
}

.page-title {
  color: #173E33;
  font-size: 40rpx;
  font-weight: 800;
}

.review-card,
.review-empty {
  border: 1rpx solid #E9DDC8;
  border-radius: 12rpx;
  background: #FFFDF7;
  box-shadow: none;
}

.review-project-name,
.review-text {
  color: #173E33;
}

.risk-box {
  border-radius: 10rpx;
  background: #F7E3DF;
  color: #C24E45;
}

.photo-wrap {
  border-radius: 10rpx;
  background: #D7CDB8;
}

.review-actions {
  border-top-color: #F1E8D8;
}

.review-actions .button-secondary,
.review-actions .button-primary {
  border-radius: 12rpx;
}

/* UI 1.2 · 审核日报 */
.review-page {
  min-height: 100vh;
  padding: 32rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  background: #F8FAF9;
}

.page-title {
  color: #111827;
  font-size: 44rpx;
  font-weight: 800;
}

.review-card,
.review-empty {
  border: none;
  border-radius: 40rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.02);
}

.photo-wrap {
  border-radius: 24rpx;
}

.review-actions .button-secondary,
.review-actions .button-primary {
  border-radius: 28rpx;
}

/* Stage 1 · 审核发布说明 */
.review-flow-card {
  margin-bottom: 24rpx;
  padding: 32rpx;
  border-radius: 32rpx;
  background: #0F6A4A;
  color: #FFFFFF;
}

.review-flow-title {
  font-size: 30rpx;
  font-weight: 800;
}

.review-flow-desc {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
  line-height: 1.5;
}

.review-meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: -6rpx 0 24rpx;
}

.review-meta-item {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #F8FAF9;
  color: #6B7280;
  font-size: 22rpx;
  font-weight: 700;
}

.confirm-box,
.tomorrow-box {
  margin-bottom: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.confirm-box {
  background: #FEF3C7;
  color: #92400E;
}

.tomorrow-box {
  background: #F8FAF9;
  color: #6B7280;
}
