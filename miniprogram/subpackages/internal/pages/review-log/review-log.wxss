/* ================================================================
   审核日报
   ================================================================ */
.review-page {
  padding: 0 32rpx 56rpx;
}

.page-header {
  margin: 24rpx 0 24rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #111827;
  line-height: 1.3;
}

.review-count {
  margin-top: 16rpx;
}

/* 审核列表 */
.review-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.review-card {
  padding: 32rpx;
}

.review-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #F3F4F6;
}

.review-project-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
  line-height: 1.3;
  flex: 1;
}

.review-content {
  margin-bottom: 16rpx;
}

.form-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #6B7280;
  margin-bottom: 10rpx;
  line-height: 1.4;
}

.review-text {
  font-size: 28rpx;
  color: #111827;
  line-height: 1.6;
}

.risk-box {
  margin-bottom: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  background: #FEE2E2;
  color: #B91C1C;
  font-size: 26rpx;
  line-height: 1.5;
}

/* 照片 */
.review-photos {
  margin-bottom: 20rpx;
}

.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 12rpx;
}

.photo-wrap {
  width: 100%;
  height: 200rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.photo-wrap:active {
  opacity: 0.88;
}

.photo {
  width: 100%;
  height: 100%;
}

/* 审核操作 */
.review-actions {
  display: grid;
  grid-template-columns: 1fr 1.2fr;
  gap: 16rpx;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #F3F4F6;
}

/* 空状态 */
.review-empty {
  margin-top: 40rpx;
}

/* UI 1.1 · 审核日报 */
.review-page {
  min-height: 100vh;
  padding: 24rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
  background: #FAFBFC;
  box-sizing: border-box;
}

.page-title {
  color: #1A1A1A;
  font-size: 40rpx;
  font-weight: 800;
}

.review-card,
.review-empty {
  border: 1rpx solid #E8ECF0;
  border-radius: 12rpx;
  background: #FFFFFF;
  box-shadow: none;
}

.review-project-name,
.review-text {
  color: #1A1A1A;
}

.risk-box {
  border-radius: 10rpx;
  background: #FEE2E2;
  color: #DC2626;
}

.photo-wrap {
  border-radius: 10rpx;
  background: #E8ECF0;
}

.review-actions {
  border-top-color: #F1E8D8;
}

.review-actions .button-secondary,
.review-actions .button-primary {
  border-radius: 12rpx;
}

/* UI 1.2 · 审核日报 */
.review-page {
  min-height: 100vh;
  padding: 32rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  background: #FAFBFC;
}

.page-title {
  color: #111827;
  font-size: 44rpx;
  font-weight: 800;
}

.review-card,
.review-empty {
  border: none;
  border-radius: 40rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.02);
}

.photo-wrap {
  border-radius: 24rpx;
}

.review-actions .button-secondary,
.review-actions .button-primary {
  border-radius: 28rpx;
}

/* Stage 1 · 审核发布说明 */
.review-flow-card {
  margin-bottom: 24rpx;
  padding: 32rpx;
  border-radius: 32rpx;
  background: #1B7A56;
  color: #FFFFFF;
}

.review-flow-title {
  font-size: 30rpx;
  font-weight: 800;
}

.review-flow-desc {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
  line-height: 1.5;
}

.review-flow-helper {
  display: inline-flex;
  margin-top: 18rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  color: #FFFFFF;
  font-size: 22rpx;
  line-height: 1.35;
  font-weight: 800;
}

.review-meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: -6rpx 0 24rpx;
}

.review-meta-item {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #FAFBFC;
  color: #6B7280;
  font-size: 22rpx;
  font-weight: 700;
}

.confirm-box,
.tomorrow-box {
  margin-bottom: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.confirm-box {
  background: #FEF3C7;
  color: #92400E;
}

.tomorrow-box {
  background: #FAFBFC;
  color: #6B7280;
}

/* UI 4.0 · 管理诊断型审核卡 */
.review-page {
  padding: 28rpx 28rpx calc(56rpx + env(safe-area-inset-bottom));
}

.page-header {
  margin-top: 8rpx;
}

.review-flow-card {
  position: relative;
  overflow: hidden;
  border-radius: 32rpx;
  background: linear-gradient(150deg, #0D4D36 0%, #1B7A56 58%, #2AA876 100%);
  box-shadow: 0 18rpx 48rpx rgba(13, 77, 54, 0.12);
}

.review-flow-card::after {
  content: "";
  position: absolute;
  top: -88rpx;
  right: -88rpx;
  width: 240rpx;
  height: 240rpx;
  border-radius: 50%;
  background: rgba(255, 184, 0, 0.12);
}

.review-card,
.review-empty {
  border-radius: 32rpx;
}

.review-card {
  padding: 28rpx;
}

.review-card-head {
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
}

.review-project-name {
  font-weight: 800;
}

.review-diagnostic-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin: 0 0 24rpx;
}

.review-diagnostic-pill {
  padding: 9rpx 16rpx;
  border-radius: 999rpx;
  background: #F3F4F6;
  color: #5C5C5C;
  font-size: 22rpx;
  line-height: 1.2;
  font-weight: 800;
}

.review-diagnostic-pill.pending {
  background: #FFF8E1;
  color: #A16207;
}

.review-diagnostic-pill.risk {
  background: #FFF1F1;
  color: #B91C1C;
}

.review-diagnostic-pill.confirm {
  background: #FEF3C7;
  color: #92400E;
}

.review-diagnostic-pill.evidence {
  background: #E8F5EE;
  color: #1B7A56;
}

.review-diagnostic-pill.ai {
  background: #E0F2FE;
  color: #0369A1;
}

.risk-box,
.confirm-box,
.tomorrow-box,
.review-focus-box,
.owner-summary-box,
.voice-transcript-box {
  border-radius: 18rpx;
  font-weight: 700;
}

.risk-box {
  background: #FFF1F1;
  color: #B91C1C;
}

.confirm-box {
  background: #FFF8E1;
  color: #A16207;
}

.review-focus-box,
.owner-summary-box,
.voice-transcript-box {
  margin-bottom: 16rpx;
  padding: 18rpx 20rpx;
  font-size: 25rpx;
  line-height: 1.55;
}

.review-focus-box {
  background: #EFF6FF;
  color: #1D4ED8;
}

.owner-summary-box {
  background: #F6FBF8;
  color: #166534;
}

.voice-transcript-box {
  background: #FAFBFC;
  color: #4B5563;
  font-weight: 500;
}

.voice-transcript-title {
  color: #111827;
  font-size: 24rpx;
  font-weight: 800;
}

.voice-transcript-text {
  margin-top: 8rpx;
  color: #6B7280;
  font-size: 24rpx;
  line-height: 1.55;
}

.photo-grid {
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}

.photo-wrap {
  height: 220rpx;
  border-radius: 20rpx;
  transition: opacity 0.15s ease, transform 0.15s ease;
}

.photo-wrap:active {
  opacity: 0.9;
  transform: scale(0.985);
}

.review-actions {
  grid-template-columns: 1fr 1.35fr;
  gap: 14rpx;
}

.reject-mask {
  position: fixed;
  inset: 0;
  z-index: 50;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
  background: rgba(15, 23, 42, 0.36);
}

.reject-panel {
  width: 100%;
  padding: 32rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 24rpx 80rpx rgba(15, 23, 42, 0.18);
}

.reject-title {
  color: #1A1A1A;
  font-size: 34rpx;
  font-weight: 800;
}

.reject-desc {
  margin-top: 10rpx;
  color: #5C5C5C;
  font-size: 24rpx;
  line-height: 1.45;
}

.reject-textarea {
  margin-top: 24rpx;
  min-height: 180rpx;
}

.reject-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 24rpx;
}

/* UI 4.2 · P4 审核空状态与安全操作 */
.review-page {
  background: #F7F8F4;
}

.review-flow-card::after {
  display: none;
}

.review-flow-card {
  background: linear-gradient(150deg, #0B573D 0%, #127A55 58%, #23966C 100%);
  box-shadow: 0 18rpx 48rpx rgba(12, 87, 61, 0.12);
}

.review-card,
.review-empty {
  box-shadow: 0 10rpx 34rpx rgba(15, 55, 39, 0.045);
}

.review-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 360rpx;
  padding: 64rpx 36rpx;
  box-sizing: border-box;
  text-align: center;
}

.review-empty-icon {
  width: 86rpx;
  height: 86rpx;
  margin-bottom: 22rpx;
  border-radius: 50%;
  background: #E8F5EE;
  color: #127A55;
  font-size: 44rpx;
  line-height: 86rpx;
  font-weight: 900;
  text-align: center;
}

.review-empty .empty-title {
  color: #111827;
  font-size: 32rpx;
  line-height: 1.3;
  font-weight: 900;
}

.review-empty-note {
  margin-top: 18rpx;
  padding: 16rpx 22rpx;
  border-radius: 999rpx;
  background: #F7F8F4;
  color: #6B7280;
  font-size: 23rpx;
  line-height: 1.35;
  font-weight: 700;
}

.review-actions .button-secondary,
.review-actions .button-primary {
  min-height: 88rpx;
  line-height: 88rpx;
  font-size: 27rpx;
  font-weight: 900;
}

.reject-panel {
  border-radius: 30rpx 30rpx 0 0;
}

/* Phase 4C · AI 业主摘要区域 */
.owner-summary-section {
  margin-bottom: 16rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #F6FBF8;
}

.owner-summary-input {
  min-height: 140rpx;
  font-size: 26rpx;
  color: #1A1A1A;
  border: 1rpx solid #D1D5DB;
  border-radius: 14rpx;
  padding: 16rpx;
  box-sizing: border-box;
  background: #FFFFFF;
  line-height: 1.55;
}

.ai-summary-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 12rpx;
}

.button-ai-summary {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  padding: 14rpx 24rpx;
  border-radius: 10rpx;
  background: #1B7A56;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 800;
  line-height: 1.2;
  border: none;
  transition: background 0.15s ease;
}

.button-ai-summary:active {
  background: #0D4D36;
}

.button-ai-summary[disabled] {
  opacity: 0.5;
}

.ai-summary-hint {
  color: #6B7280;
  font-size: 22rpx;
  line-height: 1.4;
  flex: 1;
}
