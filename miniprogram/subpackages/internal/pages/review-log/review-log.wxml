<view class="review-page">
  <!-- 标题区 -->
  <view class="page-header">
    <view class="page-title">审核日报</view>
    <view class="muted">通过后业主才能看到该工序和照片。</view>
    <view class="review-count tag tag-warning" wx:if="{{items.length}}">{{items.length}} 条待审核</view>
  </view>

  <view class="review-flow-card">
    <view class="review-flow-title">审核是业主可见前的最后一道门</view>
    <view class="review-flow-desc">通过：同步当前阶段和进度，照片对业主可见；退回：保留内部记录，不展示给业主。</view>
  </view>

  <!-- 待审核列表 -->
  <view wx:if="{{items.length}}" class="review-list">
    <view wx:for="{{items}}" wx:key="_id" class="card review-card">
      <!-- 工地信息 -->
      <view class="review-card-head">
        <view class="review-project-name">{{item.projectName || '未命名工地'}}</view>
        <view class="tag tag-warning">{{item.stage}}</view>
      </view>
      <view class="review-meta-row">
        <view class="review-meta-item">提交人：{{item.submitterText}}</view>
        <view class="review-meta-item">{{item.dateText || '待确认时间'}}</view>
      </view>

      <view class="review-diagnostic-row">
        <view class="review-diagnostic-pill pending">待发布</view>
        <view class="review-diagnostic-pill {{item.issue ? 'risk' : ''}}">{{item.issue ? '有现场问题' : '无现场问题'}}</view>
        <view class="review-diagnostic-pill {{item.needConfirm ? 'confirm' : ''}}">{{item.needConfirm ? '需确认' : '无需确认'}}</view>
        <view class="review-diagnostic-pill evidence">{{item.photoFileIDs.length}} 张照片</view>
        <view wx:if="{{item.aiGenerated}}" class="review-diagnostic-pill ai">AI整理</view>
      </view>

      <!-- 日报内容 -->
      <view class="review-content">
        <view class="form-label">今日完成</view>
        <view class="review-text">{{item.workContent}}</view>
      </view>

      <view wx:if="{{item.reviewFocus}}" class="review-focus-box">审核重点：{{item.reviewFocus}}</view>

      <!-- 业主摘要区域 -->
      <view class="owner-summary-section">
        <view class="form-label">业主摘要</view>
        <textarea class="textarea owner-summary-input" value="{{item.ownerSummary}}" placeholder="业主可见的文案，AI 可辅助生成" maxlength="200" data-id="{{item._id}}" bindinput="onOwnerSummaryInput"></textarea>
        <view class="ai-summary-row" wx:if="{{userRole === 'admin' || userRole === 'boss_qi' || userRole === 'boss_hu'}}">
          <button class="button-ai-summary" data-id="{{item._id}}" loading="{{item.aiSummaryLoading}}" disabled="{{item.aiSummaryLoading || reviewingId}}" bindtap="generateAiSummary">AI 生成业主摘要</button>
          <text class="ai-summary-hint">生成内容仅作参考</text>
        </view>
      </view>

      <view wx:if="{{item.issue}}" class="risk-box">⚠ 现场问题：{{item.issue}}</view>
      <view wx:if="{{item.needConfirm}}" class="confirm-box">需确认：{{item.needConfirm}}</view>
      <view wx:if="{{item.tomorrowPlan}}" class="tomorrow-box">明日计划：{{item.tomorrowPlan}}</view>
      <view wx:if="{{item.voiceTranscriptText}}" class="voice-transcript-box">
        <view class="voice-transcript-title">语音识别原文</view>
        <view class="voice-transcript-text">{{item.voiceTranscriptText}}</view>
      </view>

      <!-- 现场照片 -->
      <view wx:if="{{item.photoFileIDs.length}}" class="review-photos">
        <view class="form-label">现场照片</view>
        <view class="photo-grid">
          <view
            wx:for="{{item.photoFileIDs}}"
            wx:for-item="photo"
            wx:key="*this"
            class="photo-wrap"
            data-urls="{{item.photoFileIDs}}"
            data-url="{{photo}}"
            bindtap="previewPhoto">
            <image class="photo" src="{{photo}}" mode="aspectFill" lazy-load></image>
          </view>
        </view>
      </view>

      <!-- 审核操作 -->
      <view class="review-actions">
        <button class="button-secondary" data-id="{{item._id}}" data-action="reject" loading="{{reviewingId === item._id}}" disabled="{{reviewingId}}" bindtap="review">退回修改</button>
        <button class="button-primary" data-id="{{item._id}}" data-action="approve" loading="{{reviewingId === item._id}}" disabled="{{reviewingId}}" bindtap="review">通过并发布</button>
      </view>
    </view>
  </view>

  <!-- 空状态 -->
  <view wx:else class="card empty review-empty">
    <view class="review-empty-icon">✓</view>
    <view class="empty-title">{{loading ? '正在加载' : '暂无待审核'}}</view>
    <view class="muted">{{loading ? '待审核日报加载中...' : '所有日报已审核完毕'}}</view>
    <view wx:if="{{!loading}}" class="review-empty-note">工长提交新日报后，会自动出现在这里。</view>
  </view>

  <view wx:if="{{rejectDialogVisible}}" class="reject-mask" bindtap="hideRejectDialog">
    <view class="reject-panel" catchtap="noop">
      <view class="reject-title">退回原因</view>
      <view class="reject-desc">填写清楚需要修改的地方，工长重新提交时能直接对照处理。</view>
      <textarea class="textarea reject-textarea" maxlength="120" placeholder="例如：照片缺少水电定位全景，请补拍后重新提交。" value="{{rejectReason}}" bindinput="onRejectReasonInput"></textarea>
      <view class="reject-actions">
        <button class="button-secondary" bindtap="hideRejectDialog" disabled="{{reviewingId}}">取消</button>
        <button class="button-primary" loading="{{!!reviewingId}}" disabled="{{!!reviewingId}}" bindtap="confirmReject">确认退回</button>
      </view>
    </view>
  </view>
</view>
