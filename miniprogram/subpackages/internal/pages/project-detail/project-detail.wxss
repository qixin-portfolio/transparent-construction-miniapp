/* ================================================================
   工地详情页 · 核心页面
   ================================================================ */
.manager-detail-page {
  padding: 0 32rpx 56rpx;
}

/* 管理端 Hero */
.manager-hero {
  margin-top: 24rpx;
  margin-bottom: 24rpx;
  padding: 36rpx 32rpx;
  box-sizing: border-box;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #1B7A56 0%, #2AA876 100%);
  color: #FFFFFF;
}

.manager-hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.manager-copy {
  min-width: 0;
  flex: 1;
}

.manager-eyebrow {
  color: rgba(255, 255, 255, 0.76);
  font-size: 24rpx;
  line-height: 1.3;
}

.manager-project-title {
  margin-top: 12rpx;
  color: #FFFFFF;
  font-size: 40rpx;
  line-height: 1.25;
  font-weight: 600;
}

.manager-address {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 24rpx;
  line-height: 1.4;
}

.manager-status {
  flex-shrink: 0;
  min-height: 48rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #FFFFFF;
  font-size: 24rpx;
  line-height: 48rpx;
  font-weight: 600;
}

.manager-progress-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 22rpx;
  margin-top: 40rpx;
}

.manager-progress-left {
  flex: 1;
}

.manager-progress-number {
  color: #FFFFFF;
  font-size: 80rpx;
  line-height: 1;
  font-weight: 700;
}

.manager-progress-unit {
  font-size: 36rpx;
  font-weight: 600;
}

.manager-progress-label {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
}

.manager-stage-panel {
  width: 260rpx;
  min-height: 112rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.14);
  box-sizing: border-box;
}

.manager-stage-label {
  color: rgba(255, 255, 255, 0.68);
  font-size: 22rpx;
  line-height: 1.25;
}

.manager-stage-name {
  display: -webkit-box;
  margin-top: 8rpx;
  overflow: hidden;
  color: #FFFFFF;
  font-size: 28rpx;
  line-height: 1.25;
  font-weight: 600;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.manager-progress {
  height: 16rpx;
  margin-top: 32rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
}

.manager-progress-bar {
  height: 100%;
  border-radius: 999rpx;
  background: #FFFFFF;
}

.manager-metrics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 28rpx;
}

.manager-metric {
  min-height: 112rpx;
  padding: 20rpx 16rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.14);
}

.metric-value {
  color: #FFFFFF;
  font-size: 36rpx;
  line-height: 1.2;
  font-weight: 700;
}

.metric-value.short {
  display: -webkit-box;
  min-height: 44rpx;
  overflow: hidden;
  font-size: 24rpx;
  line-height: 1.25;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.metric-label {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 22rpx;
  line-height: 1.3;
}

/* 简化卡 */
.project-simple-card {
  margin-top: 24rpx;
}

/* 快捷操作 */
.quick-action-section {
  margin-bottom: 24rpx;
}

/* 设计图纸入口 */
.drawing-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.drawing-entry:active {
  opacity: 0.94;
}

.drawing-entry-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}

.drawing-entry-icon {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: #E8F5EE;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  line-height: 1;
}

/* 业主绑定 */
.bind-section {
  margin-bottom: 24rpx;
}

.bind-code {
  color: #1B7A56;
  font-size: 72rpx;
  font-weight: 700;
  letter-spacing: 16rpx;
  text-align: center;
}

.bind-code-wrap {
  margin: 28rpx 0 12rpx;
  padding: 40rpx 28rpx;
  border-radius: 28rpx;
  background: #E8F5EE;
  text-align: center;
}

.bind-actions {
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
  gap: 16rpx;
  margin-top: 24rpx;
}

/* 照片墙 + 时间线 */
.photo-section,
.timeline-section {
  margin-bottom: 28rpx;
}

.stage-filter {
  display: flex;
  gap: 14rpx;
  margin-bottom: 20rpx;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.stage-filter::-webkit-scrollbar {
  display: none;
}

.photo-wall {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.photo-tile {
  position: relative;
  height: 240rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: #F3F4F6;
}

.photo-tile:active,
.inline-photo:active {
  opacity: 0.88;
}

.photo {
  width: 100%;
  height: 100%;
}

.photo-caption {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  max-width: 220rpx;
  min-height: 44rpx;
  padding: 0 14rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(17, 24, 39, 0.72);
  color: #FFFFFF;
  font-size: 22rpx;
  line-height: 44rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.timeline {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.timeline-item {
  position: relative;
  margin-left: 24rpx;
}

.timeline-dot {
  position: absolute;
  top: 36rpx;
  left: -36rpx;
  width: 20rpx;
  height: 20rpx;
  border: 6rpx solid #F7FAF8;
  border-radius: 50%;
  background: #1B7A56;
}

.log-content {
  margin-top: 18rpx;
  color: #111827;
  font-size: 28rpx;
  line-height: 1.55;
}

.risk-box,
.confirm-box {
  margin-top: 14rpx;
  padding: 18rpx 20rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  line-height: 1.5;
}

.risk-box {
  background: #FEE2E2;
  color: #B91C1C;
}

.confirm-box {
  background: #FEF3C7;
  color: #92400E;
}

.plan-text {
  margin-top: 14rpx;
}

.inline-photos {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 20rpx;
}

.inline-photo {
  width: 100%;
  height: 180rpx;
  border-radius: 20rpx;
  background: #F3F4F6;
}

.timeline-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 20rpx rgba(17, 24, 39, 0.03);
}

.toggle-text {
  color: #1B7A56;
  font-size: 26rpx;
  font-weight: 600;
}

.toggle-arrow {
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
}

.arrow-down {
  border-top: 12rpx solid #1B7A56;
}

.arrow-up {
  border-bottom: 12rpx solid #1B7A56;
}

/* UI 1.1 · 工地详情管理页 */
.manager-detail-page {
  min-height: 100vh;
  padding: 24rpx 28rpx calc(56rpx + env(safe-area-inset-bottom));
  background: #FAFBFC;
  box-sizing: border-box;
}

.manager-hero {
  margin: 0 0 20rpx;
  padding: 30rpx 28rpx;
  border-radius: 14rpx;
  background: #1B7A56;
  box-shadow: none;
}

.manager-eyebrow {
  font-weight: 700;
}

.manager-project-title {
  font-size: 36rpx;
  font-weight: 800;
}

.manager-status {
  background: #E8F5EE;
  color: #1B7A56;
}

.manager-progress-row {
  margin-top: 34rpx;
}

.manager-progress-number {
  font-size: 68rpx;
}

.manager-stage-panel,
.manager-metric {
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 12rpx;
}

.manager-progress {
  height: 10rpx;
}

.quick-action-section .button-primary {
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 12rpx;
}

.drawing-entry,
.bind-section,
.timeline-item,
.project-simple-card {
  border: 1rpx solid #E8ECF0;
  border-radius: 12rpx;
  background: #FFFFFF;
  box-shadow: none;
}

.drawing-entry-icon {
  border-radius: 10rpx;
  background: #E8F5EE;
}

.bind-code-wrap {
  border: 1rpx solid #E8ECF0;
  border-radius: 12rpx;
  background: #F3F4F6;
}

.bind-code {
  color: #1B7A56;
}

.bind-actions {
  grid-template-columns: 1fr;
}

.photo-tile,
.inline-photo {
  border-radius: 12rpx;
  background: #E8ECF0;
}

.photo-caption {
  background: rgba(20, 118, 87, 0.86);
}

.timeline {
  border-left-color: #1B7A56;
}

.timeline-dot {
  border-color: #FAFBFC;
  background: #1B7A56;
}

.log-content {
  color: #1A1A1A;
}

.risk-box {
  border-radius: 10rpx;
  background: #FEE2E2;
  color: #DC2626;
}

.confirm-box {
  border-radius: 10rpx;
  background: #FEF3C7;
  color: #B45309;
}

.timeline-toggle {
  border: 1rpx solid #E8ECF0;
  border-radius: 12rpx;
  background: #FFFFFF;
  box-shadow: none;
}

.toggle-text {
  color: #1B7A56;
}

.arrow-down {
  border-top-color: #1B7A56;
}

.arrow-up {
  border-bottom-color: #1B7A56;
}

/* UI 1.2 · 对齐 figma-import/pages/05-project-detail.html */
.manager-detail-page {
  min-height: 100vh;
  padding: 32rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  background: #FAFBFC;
  box-sizing: border-box;
}

.manager-hero,
.project-simple-card {
  margin: 0 0 32rpx;
  padding: 48rpx;
  border: none;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #1B7A56 0%, #2AA876 100%);
  color: #FFFFFF;
  box-shadow: none;
}

.manager-project-title {
  color: #FFFFFF;
  font-size: 38rpx;
  font-weight: 800;
}

.manager-address,
.manager-eyebrow {
  color: rgba(255, 255, 255, 0.78);
}

.manager-status {
  background: rgba(255, 255, 255, 0.18);
  color: #FFFFFF;
}

.manager-progress-number {
  font-size: 72rpx;
}

.manager-stage-panel {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 150rpx;
  height: 150rpx;
  min-height: 150rpx;
  padding: 18rpx;
  border: 10rpx solid rgba(255, 255, 255, 0.28);
  border-left-color: #FFFFFF;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  text-align: center;
}

.manager-stage-label {
  display: none;
}

.manager-stage-name {
  margin-top: 0;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 800;
}

.manager-progress,
.manager-metrics {
  display: none;
}

.detail-action-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.detail-action-cell {
  min-height: 132rpx;
  padding: 22rpx 8rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.02);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.detail-action-cell.action-green {
  background: #E8F5EE;
  color: #1B7A56;
}

.detail-action-cell.action-deliver {
  background: #E8F5EE;
  color: #1B7A56;
}

.detail-action-cell.action-danger {
  background: #FEE2E2;
}

.detail-action-icon {
  margin-bottom: 10rpx;
  font-size: 38rpx;
  line-height: 1;
}

.detail-action-text {
  color: #111827;
  font-size: 22rpx;
  line-height: 1.25;
  font-weight: 800;
  text-align: center;
}

.action-green .detail-action-text {
  color: #1B7A56;
}

.action-danger .detail-action-text,
.action-danger .detail-action-icon {
  color: #D9534F;
}

.bind-section,
.photo-section,
.timeline-section,
.manager-detail-page > .section,
.manager-detail-page .card.empty {
  border: none;
  border-radius: 40rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.02);
}

.photo-section,
.timeline-section {
  padding: 36rpx;
}

.section-head {
  margin-bottom: 24rpx;
}

.section-head .sub-title {
  font-size: 32rpx;
  font-weight: 800;
}

.photo-wall {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.photo-tile {
  height: 240rpx;
  border-radius: 24rpx;
  background: #E5E7EB;
}

.photo-caption {
  background: rgba(15, 106, 74, 0.86);
}

.timeline {
  border-left: none;
}

.timeline-item {
  position: relative;
  margin: 0;
  padding: 0 0 42rpx 38rpx;
  border: none;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.timeline-item::before {
  content: "";
  position: absolute;
  left: 9rpx;
  top: 22rpx;
  bottom: -10rpx;
  width: 4rpx;
  background: #E5E7EB;
}

.timeline-item:first-child::before {
  background: #1B7A56;
}

.timeline-dot {
  left: 0;
  top: 8rpx;
  width: 18rpx;
  height: 18rpx;
  border: 4rpx solid #E8F5EE;
  background: #1B7A56;
  box-shadow: 0 0 0 2rpx #E8F5EE;
}

.timeline-item .row {
  align-items: flex-start;
}

.timeline-item .sub-title {
  color: #111827;
  font-size: 30rpx;
  font-weight: 800;
}

/* UI 4.0 · A+B 融合：管理诊断视图 */
.manager-detail-page {
  padding: 28rpx 28rpx calc(56rpx + env(safe-area-inset-bottom));
}

.manager-hero,
.project-simple-card {
  overflow: hidden;
  margin-bottom: 20rpx;
  padding: 36rpx 32rpx 32rpx;
  border-radius: 32rpx;
  background: linear-gradient(150deg, #0D4D36 0%, #1B7A56 56%, #2AA876 100%);
  box-shadow: 0 18rpx 48rpx rgba(13, 77, 54, 0.14);
}

.manager-progress-row {
  margin-top: 34rpx;
}

.manager-progress-number {
  font-size: 76rpx;
  letter-spacing: 0;
}

.manager-stage-panel {
  padding: 0;
  border: none;
  background: transparent;
}

.manager-stage-ring {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
  transition: background 0.7s cubic-bezier(0.16, 1, 0.3, 1);
}

.manager-stage-ring-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 126rpx;
  height: 126rpx;
  border-radius: 50%;
  background: linear-gradient(150deg, rgba(13, 77, 54, 0.96) 0%, rgba(27, 122, 86, 0.92) 100%);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.16);
}

.manager-stage-name {
  display: -webkit-box;
  max-width: 94rpx;
  overflow: hidden;
  font-size: 22rpx;
  line-height: 1.25;
  text-align: center;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.manager-progress,
.manager-metrics {
  display: block;
}

.manager-progress {
  height: 10rpx;
  margin-top: 28rpx;
  background: rgba(255, 255, 255, 0.22);
}

.manager-progress-bar {
  background: #FFFFFF;
  transition: width 0.72s cubic-bezier(0.16, 1, 0.3, 1);
}

.manager-metrics {
  display: grid;
  margin-top: 18rpx;
}

.manager-metric {
  min-height: 92rpx;
  padding: 16rpx 14rpx;
  border: none;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.14);
}

.diagnostic-strip {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-bottom: 24rpx;
}

.diagnostic-cell {
  min-height: 122rpx;
  padding: 22rpx 16rpx;
  border-radius: 28rpx;
  box-sizing: border-box;
  background: #FFFFFF;
  box-shadow: 0 8rpx 34rpx rgba(0, 0, 0, 0.025);
  transition: opacity 0.15s ease, transform 0.15s ease;
}

.diagnostic-cell:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.diagnostic-pending {
  background: #FFF8E1;
}

.diagnostic-risk {
  background: #FFF1F1;
}

.diagnostic-confirm {
  background: #E8F5EE;
}

.diagnostic-value {
  color: #111827;
  font-size: 42rpx;
  line-height: 1;
  font-weight: 900;
}

.diagnostic-label {
  margin-top: 12rpx;
  color: #5C5C5C;
  font-size: 22rpx;
  line-height: 1.25;
  font-weight: 800;
}

.detail-action-grid {
  gap: 14rpx;
  margin-bottom: 28rpx;
}

.detail-action-cell,
.bind-section,
.photo-section,
.timeline-section,
.detail-flow-card,
.manager-detail-page .card.empty {
  border-radius: 32rpx;
}

.photo-tile,
.inline-photo {
  border-radius: 20rpx;
  transition: opacity 0.15s ease, transform 0.15s ease;
}

.photo-tile:active,
.inline-photo:active {
  opacity: 0.9;
  transform: scale(0.985);
}

.status-tag.pending {
  background: #FFF8E1;
  color: #A16207;
}

.status-tag.rejected {
  background: #FEE2E2;
  color: #B91C1C;
}

.status-tag.approved {
  background: #E8F5EE;
  color: #1B7A56;
}

.risk-box,
.confirm-box {
  border-radius: 18rpx;
  font-weight: 700;
}

.risk-box {
  background: #FFF1F1;
  color: #B91C1C;
}

.confirm-box {
  background: #FFF8E1;
  color: #A16207;
}

.timeline-toggle {
  transition: opacity 0.15s ease, transform 0.15s ease;
}

.timeline-toggle:active {
  opacity: 0.9;
  transform: scale(0.985);
}

.log-content {
  margin-top: 10rpx;
  color: #6B7280;
}

.inline-photos {
  grid-template-columns: repeat(2, 1fr);
}

.inline-photo {
  height: 180rpx;
}

.bind-code-wrap {
  background: #FAFBFC;
}

.bind-actions {
  grid-template-columns: 1fr 1fr 1fr;
}

/* Stage 1 · 当前工地闭环状态 */
.detail-flow-card {
  margin-bottom: 32rpx;
  padding: 32rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.02);
}

.detail-flow-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.detail-flow-title {
  color: #111827;
  font-size: 30rpx;
  font-weight: 800;
}

.detail-flow-desc {
  margin-top: 8rpx;
  color: #6B7280;
  font-size: 24rpx;
  line-height: 1.4;
}

.detail-flow-count {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #E8F5EE;
  color: #1B7A56;
  font-size: 22rpx;
  font-weight: 800;
}

.detail-flow-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
}

.detail-flow-step {
  min-width: 0;
  padding: 22rpx 10rpx;
  border-radius: 24rpx;
  background: #FAFBFC;
  text-align: center;
}

.detail-flow-dot {
  width: 42rpx;
  height: 42rpx;
  margin: 0 auto 12rpx;
  border-radius: 50%;
  background: #E5E7EB;
  color: #6B7280;
  font-size: 22rpx;
  line-height: 42rpx;
  font-weight: 800;
}

.detail-flow-step.done .detail-flow-dot {
  background: #1B7A56;
  color: #FFFFFF;
}

.detail-flow-step.warning .detail-flow-dot {
  background: #F59E0B;
  color: #FFFFFF;
}

.detail-flow-label {
  color: #111827;
  font-size: 22rpx;
  line-height: 1.25;
  font-weight: 800;
}

.detail-flow-value {
  margin-top: 8rpx;
  color: #6B7280;
  font-size: 20rpx;
  line-height: 1.25;
  font-weight: 700;
}

/* UI 3.0 · 多业主绑定码 */
.bind-desc {
  margin-top: 14rpx;
  color: #5C5C5C;
  font-size: 24rpx;
  line-height: 1.5;
}

.bind-code-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  margin-top: 28rpx;
}

.bind-code-card {
  min-width: 0;
  padding: 24rpx 20rpx;
  border-radius: 28rpx;
  background: linear-gradient(180deg, #F7FCF9 0%, #FFFFFF 100%);
  border: 1rpx solid #DCEFE6;
}

.bind-code-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 12rpx;
}

.bind-code-label {
  color: #1A1A1A;
  font-size: 26rpx;
  line-height: 1.25;
  font-weight: 800;
}

.bind-code-slot,
.bind-code-tip {
  margin-top: 6rpx;
  color: #9CA3AF;
  font-size: 20rpx;
  line-height: 1.35;
}

.bind-code-card .tag {
  min-height: 38rpx;
  padding: 0 16rpx;
  font-size: 20rpx;
  line-height: 38rpx;
}

.bind-code-card .bind-code {
  margin-top: 22rpx;
  color: #1B7A56;
  font-size: 52rpx;
  line-height: 1;
  font-weight: 900;
  letter-spacing: 8rpx;
  text-align: left;
}

.bind-code-wrap .bind-code {
  letter-spacing: 12rpx;
}

.bind-summary {
  margin-top: 18rpx;
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  background: #FFF8E1;
  color: #8A5A00;
  font-size: 24rpx;
  line-height: 1.45;
  font-weight: 700;
}

.worker-bind-section {
  border-color: rgba(255, 184, 0, 0.16);
}

.worker-bind-code-wrap {
  background: #F7FCF9;
  border: 1rpx solid #DCEFE6;
}

.worker-bind-actions {
  grid-template-columns: 1fr 1fr;
}

@media (max-width: 360px) {
  .bind-code-grid {
    grid-template-columns: 1fr;
  }

  .bind-actions {
    grid-template-columns: 1fr;
  }
}

.reject-box {
  margin-top: 16rpx;
  padding: 18rpx 22rpx;
  border-radius: 20rpx;
  background: #FEE2E2;
  color: #B91C1C;
  font-size: 24rpx;
  line-height: 1.45;
  font-weight: 700;
}

.timeline-actions {
  margin-top: 20rpx;
}

.timeline-actions .small {
  width: auto;
  min-width: 260rpx;
  padding: 0 24rpx;
}

/* UI 4.3 · 工地详情行动优先 */
.manager-detail-page {
  background: #F7F8F4;
}

.manager-hero,
.project-simple-card {
  border-radius: 28rpx;
  background: linear-gradient(150deg, #0D4D36 0%, #1B7A56 64%, #278F67 100%);
  box-shadow: 0 18rpx 42rpx rgba(13, 77, 54, 0.12);
}

.manager-hero-top {
  gap: 18rpx;
}

.manager-project-title {
  word-break: break-word;
}

.manager-address {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.manager-status {
  max-width: 160rpx;
  overflow: hidden;
  border-radius: 18rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.manager-hero-actions {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 26rpx;
}

.manager-hero-action {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 66rpx;
  padding: 0 10rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 16rpx;
  background: rgba(255, 255, 255, 0.13);
  color: #FFFFFF;
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 800;
  text-align: center;
  box-sizing: border-box;
}

.manager-hero-action.primary {
  border-color: #FFFFFF;
  background: #FFFFFF;
  color: #1B7A56;
}

.manager-hero-action:active,
.detail-action-cell:active {
  opacity: 0.9;
}

.diagnostic-strip {
  gap: 12rpx;
}

.diagnostic-cell,
.detail-action-cell,
.detail-flow-card,
.bind-section,
.photo-section,
.timeline-section,
.manager-detail-page .card.empty {
  border: 1rpx solid rgba(27, 122, 86, 0.07);
  border-radius: 26rpx;
  box-shadow: 0 12rpx 34rpx rgba(31, 45, 38, 0.045);
}

.detail-action-grid {
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12rpx;
}

.detail-action-cell {
  min-height: 122rpx;
  padding: 18rpx 8rpx;
}

.detail-action-icon {
  font-size: 34rpx;
}

.detail-action-text {
  display: -webkit-box;
  min-height: 54rpx;
  overflow: hidden;
  font-size: 21rpx;
  line-height: 1.3;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.section-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.section-kicker {
  margin-bottom: 6rpx;
  color: #6B7B70;
  font-size: 22rpx;
  line-height: 1.25;
  font-weight: 800;
}

.section-count {
  flex-shrink: 0;
  min-height: 44rpx;
  padding: 0 18rpx;
  border-radius: 14rpx;
  background: #E8F5EE;
  color: #1B7A56;
  font-size: 22rpx;
  line-height: 44rpx;
  font-weight: 800;
}

.photo-section,
.timeline-section {
  padding: 30rpx;
}

.photo-wall {
  gap: 14rpx;
}

.photo-tile {
  height: 230rpx;
  border-radius: 18rpx;
}

.photo-caption {
  right: 10rpx;
  bottom: 10rpx;
  max-width: calc(100% - 20rpx);
  border-radius: 12rpx;
}

.timeline-item {
  padding-bottom: 34rpx;
}

.timeline-item:last-child {
  padding-bottom: 8rpx;
}

.log-content {
  color: #374151;
  font-size: 27rpx;
}

.inline-photos {
  gap: 10rpx;
}

.inline-photo {
  height: 164rpx;
  border-radius: 16rpx;
}

.bind-code-card {
  border-radius: 22rpx;
}

.bind-code-card .bind-code,
.bind-code-wrap .bind-code {
  letter-spacing: 0;
  word-break: break-all;
}

/* 真机 BUG 修复 · 绑定码区域只在卡片内换行，不带动整页横移 */
.manager-detail-page {
  max-width: 100vw;
  overflow-x: hidden;
  box-sizing: border-box;
}

.bind-section,
.bind-code-grid,
.bind-code-card,
.bind-code-wrap {
  max-width: 100%;
  min-width: 0;
}

.bind-code-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  overflow: hidden;
}

.bind-code-card .bind-code {
  max-width: 100%;
  font-size: 46rpx;
  line-height: 1.08;
  overflow-wrap: anywhere;
  word-break: break-all;
  white-space: normal;
}

.bind-code-wrap .bind-code {
  max-width: 100%;
  font-size: 64rpx;
  overflow-wrap: anywhere;
  word-break: break-all;
  white-space: normal;
}

.bind-actions {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  width: 100%;
}

.bind-actions button,
.worker-bind-actions button {
  width: 100%;
  min-width: 0;
  margin: 0;
  padding-left: 10rpx;
  padding-right: 10rpx;
  box-sizing: border-box;
}

.bind-actions .button-share {
  grid-column: 1 / -1;
}

.worker-bind-actions {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

@media (max-width: 360px) {
  .manager-hero-actions {
    grid-template-columns: 1fr;
  }

  .detail-action-grid,
  .detail-flow-grid,
  .bind-code-grid,
  .bind-actions,
  .worker-bind-actions {
    grid-template-columns: 1fr;
  }

  .bind-actions .button-share {
    grid-column: auto;
  }
}


/* 已绑定业主管理列表 */
.owner-manage-section {
  margin-bottom: 24rpx;
}

.owner-manage-list {
  margin-top: 20rpx;
}

.owner-manage-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.owner-manage-item:last-child {
  border-bottom: none;
}

.owner-manage-avatar {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #E8F5EE;
  color: #1B7A56;
  font-size: 28rpx;
  font-weight: 800;
  line-height: 64rpx;
  text-align: center;
}

.owner-manage-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.owner-manage-name {
  color: #111827;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.25;
}

.owner-manage-id {
  color: #9CA3AF;
  font-size: 20rpx;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.owner-manage-del {
  flex-shrink: 0;
  padding: 10rpx 24rpx;
  border-radius: 20rpx;
  background: #FEF2F2;
  color: #DC2626;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.35;
}

.owner-manage-del:active {
  opacity: 0.75;
}
