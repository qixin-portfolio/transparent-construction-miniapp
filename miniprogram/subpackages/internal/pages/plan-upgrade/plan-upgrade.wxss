/* ================================================================
   套餐升级页面
   ================================================================ */
page {
  width: 100%;
  min-height: 100%;
  overflow-x: hidden;
  background: #FAFBFC;
}

.plan-page {
  width: 100%;
  min-height: 100vh;
  padding: 0 0 calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* 加载态 */
.plan-loading {
  padding: 32rpx;
}

.plan-loading-card {
  height: 200rpx;
  margin-bottom: 24rpx;
  border-radius: 32rpx;
  background: #F3F4F6;
}

/* 当前套餐卡片 */
.current-plan-card {
  margin: 24rpx 32rpx;
  padding: 32rpx;
  border-radius: 34rpx;
  background: linear-gradient(135deg, #1B7A56 0%, #2AA876 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 28rpx rgba(27, 122, 86, 0.25);
}

.current-plan-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.current-plan-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
  font-weight: 700;
}

.current-plan-name {
  margin-top: 8rpx;
  font-size: 44rpx;
  font-weight: 900;
  letter-spacing: -1rpx;
}

.current-plan-badge {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 20rpx;
  font-weight: 800;
  color: rgba(255, 255, 255, 0.9);
}

.current-plan-metrics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.18);
}

.current-plan-metric {
  text-align: center;
}

.metric-value {
  font-size: 40rpx;
  font-weight: 900;
  line-height: 1.15;
}

.metric-unit {
  font-size: 24rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.7);
}

.metric-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.72);
  font-weight: 700;
}

.current-plan-tip {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  background: rgba(255, 184, 0, 0.15);
  font-size: 22rpx;
  line-height: 1.4;
  color: #FFB800;
  font-weight: 700;
}

/* 套餐列表 */
.plan-section {
  margin: 0 32rpx;
}

.plan-section-title {
  margin: 32rpx 0 20rpx;
  color: #1A1A1A;
  font-size: 36rpx;
  font-weight: 800;
}

.plan-grid {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.plan-card {
  padding: 32rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(17, 24, 39, 0.04);
  box-sizing: border-box;
  position: relative;
  overflow: hidden;
  border: 2rpx solid transparent;
  transition: all 0.15s ease;
}

.plan-card:active {
  transform: scale(0.99);
  opacity: 0.95;
}

.plan-card-current {
  border-color: #1B7A56;
  background: #F7FCF9;
}

.plan-card-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.plan-card-name {
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.25;
}

.plan-card-subtitle {
  margin-top: 6rpx;
  color: #9CA3AF;
  font-size: 24rpx;
}

.plan-card-badge {
  flex-shrink: 0;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 800;
}

.plan-card-badge.free {
  background: #F3F4F6;
  color: #6B7280;
}

.plan-card-badge.starter {
  background: #E8F5EE;
  color: #1B7A56;
}

.plan-card-badge.pro {
  background: #F3E5F5;
  color: #7C3AED;
}

.plan-card-badge.enterprise {
  background: #FFF8E1;
  color: #B45309;
}

.plan-current-tag {
  display: inline-flex;
  margin-top: 16rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #E8F5EE;
  color: #1B7A56;
  font-size: 20rpx;
  font-weight: 800;
}

.plan-card-features {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F3F4F6;
}

.plan-feature-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 8rpx 0;
  color: #1A1A1A;
  font-size: 26rpx;
  font-weight: 600;
}

.plan-feature-disabled {
  color: #D1D5DB;
}

.plan-feature-icon {
  width: 32rpx;
  text-align: center;
  font-size: 24rpx;
  flex-shrink: 0;
}

.plan-feature-ok {
  color: #1B7A56;
}

.plan-feature-no {
  color: #D1D5DB;
}

.plan-upgrade-btn {
  margin-top: 24rpx;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #1B7A56 0%, #2AA876 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 800;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(27, 122, 86, 0.25);
}

.plan-current-btn {
  background: #E8ECF0;
  color: #9CA3AF;
  box-shadow: none;
}

/* 升级说明 */
.plan-footer-note {
  margin: 40rpx 32rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 12rpx rgba(17, 24, 39, 0.04);
}

.plan-footer-title {
  color: #1A1A1A;
  font-size: 28rpx;
  font-weight: 800;
  margin-bottom: 12rpx;
}

.plan-footer-text {
  color: #6B7280;
  font-size: 24rpx;
  line-height: 1.55;
}

/* 升级中遮罩 */
.plan-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  background: rgba(17, 24, 39, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
}

.plan-mask-box {
  padding: 48rpx 64rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
}

.plan-mask-text {
  color: #1A1A1A;
  font-size: 30rpx;
  font-weight: 800;
}
