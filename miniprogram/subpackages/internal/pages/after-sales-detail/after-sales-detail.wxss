@import "../after-sales-list/after-sales-list.wxss";

.info-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 14rpx 0;
  border-bottom: 1rpx solid #EEF2F7;
  font-size: 26rpx;
}

.info-label {
  color: #6B7280;
}

.info-value {
  color: #111827;
  text-align: right;
}

.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 16rpx;
}

.photo-thumb {
  height: 156rpx;
  border-radius: 12rpx;
  overflow: hidden;
  background: #F3F4F6;
}

.photo-thumb image {
  width: 100%;
  height: 100%;
}

.action-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-top: 20rpx;
}

.button-primary,
.button-secondary {
  border-radius: 14rpx;
  font-size: 28rpx;
}

.button-primary {
  color: #FFFFFF;
  background: #1B7A56;
}

.button-secondary {
  color: #1B7A56;
  background: #E8F5EE;
}

.timeline-item {
  padding: 20rpx 0;
  border-bottom: 1rpx solid #EEF2F7;
}

.timeline-item:last-child {
  border-bottom: 0;
}

.timeline-title {
  color: #111827;
  font-size: 28rpx;
  font-weight: 700;
}

.timeline-meta {
  margin-top: 8rpx;
  color: #6B7280;
  font-size: 24rpx;
}
