/* ================================================================
   员工邀请码 / 团队管理
   ================================================================ */
.staff-page {
  padding: 0 32rpx 56rpx;
}

.team-hero {
  display: flex;
  align-items: center;
  gap: 22rpx;
  margin: 24rpx 0;
  padding: 32rpx;
  border-radius: 36rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 24rpx rgba(17, 24, 39, 0.04);
}

.team-hero-icon {
  flex-shrink: 0;
  width: 80rpx;
  height: 80rpx;
  border-radius: 26rpx;
  background: #E8F5EE;
  color: #1B7A56;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 80rpx;
  text-align: center;
}

.team-hero-copy {
  flex: 1;
  min-width: 0;
}

.team-hero-title {
  color: #111827;
  font-size: 36rpx;
  font-weight: 800;
  line-height: 1.25;
}

.team-hero-desc {
  margin-top: 8rpx;
  color: #6B7280;
  font-size: 24rpx;
  line-height: 1.5;
}

.team-flow-card {
  margin-bottom: 32rpx;
  padding: 28rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 24rpx rgba(17, 24, 39, 0.04);
}

.team-flow {
  display: flex;
  align-items: center;
}

.team-flow-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  min-width: 96rpx;
}

.team-flow-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #E5E7EB;
  color: #6B7280;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 44rpx;
  text-align: center;
}

.team-flow-step.done .team-flow-dot {
  background: #1B7A56;
  color: #FFFFFF;
}

.team-flow-text {
  color: #6B7280;
  font-size: 22rpx;
  line-height: 1.3;
  white-space: nowrap;
}

.team-flow-step.done .team-flow-text {
  color: #1B7A56;
  font-weight: 700;
}

.team-flow-line {
  flex: 1;
  height: 2rpx;
  margin: 0 6rpx;
  background: #DDE7E2;
}

.team-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 24rpx;
}

.team-stat {
  padding: 20rpx 10rpx;
  border-radius: 24rpx;
  background: #FAFBFC;
  text-align: center;
}

.team-stat-value {
  color: #1B7A56;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.15;
}

.team-stat-label {
  margin-top: 8rpx;
  color: #6B7280;
  font-size: 22rpx;
  line-height: 1.25;
}

.empty-icon {
  font-size: 56rpx;
  line-height: 1;
  margin-bottom: 16rpx;
}

.section {
  margin-bottom: 32rpx;
}

.section-title {
  color: #111827;
  font-size: 30rpx;
  font-weight: 600;
  margin-bottom: 18rpx;
}

/* 角色选择 */
.role-options {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.role-chip {
  padding: 24rpx 20rpx;
  border: 2rpx solid #E5E7EB;
  border-radius: 24rpx;
  background: #FFFFFF;
  color: #6B7280;
  font-size: 28rpx;
  font-weight: 500;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(17, 24, 39, 0.03);
}

.role-chip-active {
  border-color: #1B7A56;
  background: #E8F5EE;
  color: #1B7A56;
  font-weight: 600;
}

.remark-input {
  height: 96rpx;
  padding: 0 28rpx;
  border: 2rpx solid #E5E7EB;
  border-radius: 24rpx;
  background: #F9FAFB;
  color: #111827;
  font-size: 28rpx;
  box-sizing: border-box;
  margin-bottom: 20rpx;
}

.generate-btn {
  width: 100%;
}

/* 最新邀请码大卡 */
.latest-code-card {
  padding: 40rpx 32rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #1B7A56 0%, #2AA876 100%);
  text-align: center;
}

.latest-code-label {
  color: rgba(255, 255, 255, 0.82);
  font-size: 26rpx;
  font-weight: 500;
}

.latest-code-number {
  margin: 24rpx 0 16rpx;
  color: #FFFFFF;
  font-size: 88rpx;
  letter-spacing: 0;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.latest-code-tip {
  color: rgba(255, 255, 255, 0.68);
  font-size: 24rpx;
  line-height: 1.5;
}

.latest-code-actions {
  margin-top: 24rpx;
  display: flex;
  justify-content: center;
}

.latest-code-btn {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 48rpx;
  margin: 0;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.2);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
}

.latest-code-btn::after {
  border: none;
}

/* 邀请码列表 */
.code-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.code-item {
  padding: 24rpx 28rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 20rpx rgba(17, 24, 39, 0.03);
}

.code-item-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.code-item-role {
  color: #1B7A56;
  font-size: 26rpx;
  font-weight: 600;
}

.code-item-status {
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 600;
}

.code-status-active {
  background: #E8F5EE;
  color: #1B7A56;
}

.code-status-used {
  background: #F3F4F6;
  color: #6B7280;
}

.code-status-expired {
  background: #FEE2E2;
  color: #D9534F;
}

.code-item-number {
  color: #111827;
  font-size: 44rpx;
  letter-spacing: 0;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.code-item-remark {
  margin-top: 8rpx;
  color: #6B7280;
  font-size: 24rpx;
}

.code-item-meta {
  display: flex;
  gap: 24rpx;
  margin-top: 10rpx;
  color: #9CA3AF;
  font-size: 22rpx;
}

/* 员工列表 */
.member-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.member-item {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  padding: 24rpx 28rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 20rpx rgba(17, 24, 39, 0.03);
}

.member-main {
  display: flex;
  align-items: center;
  gap: 20rpx;
  width: 100%;
}

.member-avatar {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1B7A56 0%, #2AA876 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 72rpx;
  text-align: center;
}

.member-info {
  flex: 1;
  min-width: 0;
}

.member-name {
  color: #111827;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.35;
  word-break: break-all;
}

.member-role {
  margin-top: 4rpx;
  color: #6B7280;
  font-size: 24rpx;
}

.member-meta {
  margin-top: 6rpx;
  color: #9CA3AF;
  font-size: 22rpx;
  line-height: 1.35;
}

.member-status {
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 500;
  white-space: nowrap;
}

.member-status.active {
  color: #16A34A;
}

.member-status.inactive {
  color: #9CA3AF;
}

.member-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  width: 100%;
}

.member-action {
  width: 100%;
  height: 58rpx;
  line-height: 58rpx;
  padding: 0;
  margin: 0;
  border-radius: 999rpx;
  background: #E8F5EE;
  color: #1B7A56;
  font-size: 22rpx;
  font-weight: 600;
}

.member-action.danger {
  background: #FEE2E2;
  color: #D9534F;
}

.member-action::after {
  border: none;
}

/* 使用说明 */
.tip-block {
  padding: 28rpx;
  border-radius: 28rpx;
  background: #FEF3C7;
}
/* ================================================================
   可折叠面板
   ================================================================ */
.collapsible-title {
  display: flex;
  align-items: center;
  justify-content: space-between;
  cursor: pointer;
  user-select: none;
}

.collapsible-title:active {
  opacity: 0.72;
}

.collapse-arrow {
  font-size: 22rpx;
  color: #9CA3AF;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #F3F4F6;
  font-weight: 700;
  transition: all 0.2s ease;
}

.tip-title {
  color: #92400E;
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.tip-text {
  color: #92400E;
  font-size: 24rpx;
  line-height: 1.8;
}

/* UI 1.1 · 员工邀请码 */
.staff-page {
  min-height: 100vh;
  padding: 24rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
  background: #FAFBFC;
  box-sizing: border-box;
}

.section,
.team-hero,
.team-flow-card,
.latest-code-card,
.code-item,
.member-item,
.tip-block {
  border: 1rpx solid #E8ECF0;
  border-radius: 12rpx;
  background: #FFFFFF;
  box-shadow: none;
}

.section {
  padding: 24rpx;
}

.section-title,
.code-item-role,
.member-name {
  color: #1A1A1A;
  font-weight: 800;
}

.role-chip {
  border-radius: 10rpx;
  background: #F3F4F6;
  color: #5C5C5C;
}

.role-chip-active {
  background: #1B7A56;
  color: #FFFFFF;
}

.remark-input {
  border: 1rpx solid #E8ECF0;
  border-radius: 10rpx;
  background: #FFFFFF;
}

.latest-code-card {
  background: #1B7A56;
}

.latest-code-number {
  color: #FFFFFF;
}

.code-item-status,
.member-status.active {
  color: #1B7A56;
}

.member-avatar {
  background: #E8F5EE;
  color: #1B7A56;
}

.tip-block {
  background: #FEF3C7;
}

/* UI 4.2 · P4 团队管理稳定布局 */
.staff-page {
  background: #F7F8F4;
}

.team-hero,
.team-flow-card,
.section,
.code-item,
.member-item,
.tip-block {
  border-radius: 28rpx;
  box-shadow: 0 10rpx 34rpx rgba(15, 55, 39, 0.045);
}

.team-hero {
  margin-top: 0;
}

.team-hero-icon {
  border-radius: 22rpx;
  background: #E8F5EE;
  color: #127A55;
}

.section-title {
  font-size: 31rpx;
  line-height: 1.3;
  font-weight: 900;
}

.role-chip {
  min-height: 78rpx;
  padding: 0 18rpx;
  line-height: 78rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
}

.latest-code-card {
  border-radius: 30rpx;
  background: linear-gradient(150deg, #0B573D 0%, #127A55 58%, #23966C 100%);
  box-shadow: 0 18rpx 48rpx rgba(12, 87, 61, 0.14);
}

.member-item {
  gap: 16rpx;
  padding: 24rpx;
}

.member-main {
  align-items: flex-start;
}

.member-avatar {
  width: 74rpx;
  height: 74rpx;
  line-height: 74rpx;
  font-size: 30rpx;
}

.member-info {
  min-width: 0;
  padding-top: 2rpx;
}

.member-name {
  display: -webkit-box;
  overflow: hidden;
  font-size: 30rpx;
  line-height: 1.32;
  word-break: break-all;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.member-role,
.member-meta {
  line-height: 1.38;
}

.member-status {
  min-width: 72rpx;
  padding-top: 6rpx;
  text-align: right;
}

.member-actions {
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14rpx;
  padding-left: 94rpx;
  box-sizing: border-box;
}

.member-action {
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 900;
}

.member-action.danger {
  background: #FCE7E7;
  color: #B54141;
}

.staff-page .empty {
  padding: 44rpx 28rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  text-align: center;
}

.staff-page .empty-title {
  margin-bottom: 10rpx;
  color: #111827;
  font-size: 30rpx;
  line-height: 1.3;
  font-weight: 900;
}

.tip-block {
  border: 1rpx solid rgba(146, 64, 14, 0.08);
}

.tip-title,
.tip-text {
  color: #8A641E;
}

/* UI 1.2 · 员工邀请码 */
.staff-page {
  min-height: 100vh;
  padding: 32rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  background: #FAFBFC;
}

.section,
.team-hero,
.team-flow-card,
.code-item,
.member-item,
.tip-block {
  border: none;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.02);
}

.latest-code-card {
  border: none;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #1E3A8A 0%, #0F172A 100%);
  box-shadow: 0 20rpx 60rpx rgba(30, 58, 138, 0.2);
}

.role-chip {
  border-radius: 999rpx;
}

.role-chip-active,
.generate-btn {
  background: #1B7A56;
}

.remark-input {
  border: 2rpx solid #E5E7EB;
  border-radius: 24rpx;
}

.member-avatar {
  background: #E8F5EE;
  color: #1B7A56;
}

.tip-block {
  background: #FEF3C7;
}
