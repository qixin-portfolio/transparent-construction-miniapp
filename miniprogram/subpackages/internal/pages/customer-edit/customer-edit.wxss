/* ================================================================
   客户详情 / 新增客户
   ================================================================ */
.customer-edit-page {
  padding: 0 32rpx 56rpx;
}

.page-header {
  margin: 24rpx 0 24rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #111827;
  line-height: 1.3;
}

/* 表单分组 */
.form-section {
  margin-bottom: 20rpx;
}

.form-section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 24rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F3F4F6;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-group:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 26rpx;
  font-weight: 600;
  color: #6B7280;
  margin-bottom: 12rpx;
  line-height: 1.4;
}

.picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.picker-arrow {
  color: #9CA3AF;
  font-size: 24rpx;
  flex-shrink: 0;
}

/* 提交区 */
.submit-area {
  margin-top: 32rpx;
  padding: 0 16rpx;
}

/* UI 1.1 · 客户详情 / 新增客户 */
.customer-edit-page {
  min-height: 100vh;
  padding: 24rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
  background: #F8F4EA;
  box-sizing: border-box;
}

.page-title {
  color: #173E33;
  font-size: 40rpx;
  font-weight: 800;
}

.form-section {
  border: 1rpx solid #E9DDC8;
  border-radius: 12rpx;
  background: #FFFDF7;
  box-shadow: none;
}

.form-section-title {
  color: #173E33;
  border-bottom-color: #F1E8D8;
}

.form-label {
  color: #6C776F;
}

.submit-area {
  padding: 0;
}

.submit-area .button-primary {
  border-radius: 12rpx;
  background: #147657;
}

/* UI 1.2 · 客户详情 / 新增客户 */
.customer-edit-page {
  min-height: 100vh;
  padding: 32rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  background: #F8FAF9;
}

.page-title {
  color: #111827;
  font-size: 44rpx;
  font-weight: 800;
}

.form-section {
  border: none;
  border-radius: 40rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.02);
}

.form-section-title {
  border-bottom-color: #E5E7EB;
}

.submit-area .button-primary {
  border-radius: 28rpx;
  background: #0F6A4A;
}

/* Stage 2 · 客户生命周期 */
.customer-lifecycle-card {
  margin-bottom: 24rpx;
  padding: 32rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.02);
}

.lifecycle-title {
  color: #111827;
  font-size: 30rpx;
  font-weight: 800;
  margin-bottom: 28rpx;
}

.lifecycle-flow {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
}

.lifecycle-step {
  min-width: 0;
  padding: 20rpx 8rpx;
  border-radius: 24rpx;
  background: #F8FAF9;
  text-align: center;
}

.lifecycle-dot {
  width: 44rpx;
  height: 44rpx;
  margin: 0 auto 12rpx;
  border-radius: 50%;
  background: #E5E7EB;
  color: #6B7280;
  font-size: 22rpx;
  line-height: 44rpx;
  font-weight: 800;
}

.lifecycle-step.active .lifecycle-dot {
  background: #0F6A4A;
  color: #FFFFFF;
}

.lifecycle-label {
  color: #6B7280;
  font-size: 22rpx;
  line-height: 1.25;
  font-weight: 700;
}

.lifecycle-step.active .lifecycle-label {
  color: #0F6A4A;
}

.customer-action-row {
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.customer-action-btn {
  height: 88rpx;
  margin: 0;
  border-radius: 28rpx;
  font-size: 28rpx;
  line-height: 88rpx;
  font-weight: 800;
}

.customer-action-btn::after {
  border: none;
}

.customer-action-btn.secondary {
  background: #EAF7F1;
  color: #0F6A4A;
}

.customer-action-btn.primary {
  background: #0F6A4A;
  color: #FFFFFF;
}

.customer-action-btn.danger {
  grid-column: 1 / -1;
  background: #FEE2E2;
  color: #D9534F;
}
