.page {
  min-height: 100vh;
  padding: 28rpx;
  background: #F6F8FA;
}

.hero {
  padding: 28rpx 0 20rpx;
}

.eyebrow {
  color: #1B7A56;
  font-size: 24rpx;
  font-weight: 700;
}

.title {
  margin-top: 8rpx;
  font-size: 44rpx;
  font-weight: 800;
  color: #111827;
}

.tabs {
  display: flex;
  gap: 12rpx;
  overflow-x: auto;
  padding: 8rpx 0 24rpx;
}

.tab {
  flex: 0 0 auto;
  padding: 14rpx 22rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #6B7280;
  font-size: 26rpx;
}

.tab.active {
  background: #1B7A56;
  color: #FFFFFF;
}

.card {
  margin-bottom: 20rpx;
  padding: 26rpx;
  border-radius: 18rpx;
  background: #FFFFFF;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.06);
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #111827;
}

.status {
  flex: 0 0 auto;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: #E8F5EE;
  color: #1B7A56;
  font-size: 24rpx;
}

.desc {
  margin-top: 12rpx;
  color: #4B5563;
  font-size: 26rpx;
  line-height: 1.55;
}

.meta {
  margin-top: 16rpx;
  color: #6B7280;
  font-size: 24rpx;
}

.empty {
  padding: 70rpx 24rpx;
  text-align: center;
  color: #6B7280;
}
