<view class="page">
  <view class="hero">
    <view class="eyebrow">售后工单</view>
    <view class="title">售后处理台</view>
  </view>

  <view class="tabs">
    <view wx:for="{{tabs}}" wx:key="key" class="tab {{activeStatus === item.key ? 'active' : ''}}" data-key="{{item.key}}" bindtap="selectStatus">{{item.label}}</view>
  </view>

  <view wx:if="{{loading}}" class="card empty">正在加载售后工单...</view>
  <view wx:elif="{{!items.length}}" class="card empty">暂无对应售后工单</view>

  <view wx:else>
    <view wx:for="{{items}}" wx:key="_id" class="card" data-id="{{item._id}}" bindtap="goDetail">
      <view class="row">
        <view class="card-title">{{item.projectName || '晟景装饰项目'}}</view>
        <view class="status">{{item.statusText}}</view>
      </view>
      <view class="desc">{{item.issueType || '售后报修'}} · {{item.issueDescription || '未填写描述'}}</view>
      <view class="meta">工单 {{item.ticketNo || item._id}} · {{item.updatedAtText || item.createdAtText || '-'}}</view>
    </view>
  </view>
</view>
