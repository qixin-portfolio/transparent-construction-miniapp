/* ================================================================
   AI 助手 · 业务工具面板
   ================================================================ */
.ai-page {
  min-height: 100vh;
  padding: 0 32rpx 56rpx;
}

.ai-page button::after {
  border: none;
}

.ai-loading {
  padding: 120rpx 32rpx;
  text-align: center;
}

.ai-loading-icon {
  font-size: 56rpx;
  line-height: 1;
}

.ai-loading-text {
  margin-top: 20rpx;
  color: #6B7280;
  font-size: 28rpx;
}

/* 顶部介绍卡 */
.ai-hero {
  padding: 40rpx 36rpx;
  margin: 24rpx 0 0;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #0F6A4A 0%, #1F8B61 100%);
  color: #FFFFFF;
  text-align: center;
}

.ai-hero-icon {
  font-size: 56rpx;
  line-height: 1;
  margin-bottom: 16rpx;
}

.ai-kicker {
  color: rgba(255, 255, 255, 0.76);
  font-size: 24rpx;
  line-height: 1.3;
}

.ai-title {
  margin-top: 12rpx;
  font-size: 42rpx;
  line-height: 1.25;
  font-weight: 600;
}

.ai-desc {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 26rpx;
  line-height: 1.5;
}

.ai-loop-card {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 24rpx rgba(17, 24, 39, 0.04);
}

.ai-loop-steps {
  display: flex;
  align-items: center;
}

.ai-loop-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  min-width: 96rpx;
}

.ai-loop-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #E5E7EB;
  color: #6B7280;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 44rpx;
  text-align: center;
}

.ai-loop-step.done .ai-loop-dot {
  background: #0F6A4A;
  color: #FFFFFF;
}

.ai-loop-text {
  color: #6B7280;
  font-size: 22rpx;
  line-height: 1.3;
  white-space: nowrap;
}

.ai-loop-step.done .ai-loop-text {
  color: #0F6A4A;
  font-weight: 700;
}

.ai-loop-line {
  flex: 1;
  height: 2rpx;
  margin: 0 6rpx;
  background: #DDE7E2;
}

.ai-stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 24rpx;
}

.ai-stat {
  padding: 20rpx 10rpx;
  border-radius: 24rpx;
  background: #F8FAF9;
  text-align: center;
}

.ai-stat-value {
  color: #0F6A4A;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.15;
}

.ai-stat-label {
  margin-top: 8rpx;
  color: #6B7280;
  font-size: 22rpx;
  line-height: 1.25;
}

/* 模式切换 */
.flow-tabs {
  margin-top: 24rpx;
  white-space: nowrap;
}

.flow-tabs::-webkit-scrollbar {
  display: none;
}

.flow-tabs-inner {
  display: flex;
  gap: 16rpx;
  width: max-content;
  padding-bottom: 4rpx;
}

.flow-tab {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  min-width: 160rpx;
  margin: 0;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  color: #6B7280;
  font-size: 26rpx;
  line-height: 72rpx;
  font-weight: 500;
  box-shadow: 0 4rpx 16rpx rgba(17, 24, 39, 0.04);
}

.flow-tab.active {
  background: #0F6A4A;
  color: #FFFFFF;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(15, 106, 74, 0.24);
}

/* 工具卡片 */
.flow-card,
.output-card,
.history-card {
  margin-top: 24rpx;
}

.flow-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.flow-head-info {
  flex: 1;
  min-width: 0;
}

.flow-desc {
  margin-top: 8rpx;
}

/* 表单字段 */
.field-list {
  margin-top: 24rpx;
}

.field {
  margin-top: 24rpx;
}

.field:first-child {
  margin-top: 0;
}

.field-label {
  margin-bottom: 12rpx;
  color: #111827;
  font-size: 26rpx;
  line-height: 1.35;
  font-weight: 600;
}

.ai-textarea {
  min-height: 200rpx;
}

.ai-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* 照片选择 */
.photo-field {
  margin-top: 4rpx;
}

.photo-button {
  height: 80rpx;
  line-height: 80rpx;
  font-size: 26rpx;
}

.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 16rpx;
}

.photo-cell {
  position: relative;
  overflow: hidden;
  border-radius: 20rpx;
  background: #F3F4F6;
}

.photo-thumb {
  width: 100%;
  height: 140rpx;
}

.photo-name {
  padding: 10rpx;
  color: #6B7280;
  font-size: 21rpx;
  line-height: 1.25;
}

.photo-hint {
  margin-top: 12rpx;
}

/* 操作按钮 */
.tool-actions {
  display: grid;
  grid-template-columns: 1.4fr 1fr 1fr;
  gap: 16rpx;
  margin-top: 24rpx;
}

.tool-actions button {
  margin: 0;
}

/* 生成结果 */
.output-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.output-actions {
  display: flex;
  gap: 12rpx;
  flex-shrink: 0;
}

.output-state {
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  margin-top: 10rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #F3F4F6;
  color: #6B7280;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 42rpx;
}

.output-state.ready {
  background: #EAF7F1;
  color: #0F6A4A;
}

.output-text {
  display: block;
  margin-top: 20rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #F7FAF8;
  color: #111827;
  font-size: 28rpx;
  line-height: 1.72;
  white-space: pre-wrap;
}

/* 本机记录 */
.history-list {
  margin-top: 16rpx;
}

.history-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-top: 1rpx solid #F3F4F6;
}

.history-item:first-child {
  border-top: none;
}

.history-info {
  flex: 1;
  min-width: 0;
}

.history-flow {
  color: #111827;
  font-size: 28rpx;
  line-height: 1.35;
  font-weight: 500;
}

.history-open {
  flex-shrink: 0;
  color: #0F6A4A;
  font-size: 26rpx;
  line-height: 1.3;
  font-weight: 500;
}

.sync-actions {
  margin-top: 24rpx;
}

.sync-hint {
  margin-bottom: 16rpx;
  color: #6B7280;
  font-size: 24rpx;
  line-height: 1.5;
}

.sync-actions button {
  margin: 0;
}

/* UI 1.1 · 晟景 AI 助理 */
.ai-page,
.ai-loading {
  min-height: 100vh;
  padding: 24rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
  background: #F8F4EA;
  box-sizing: border-box;
}

.ai-hero {
  border-radius: 14rpx;
  background: #147657;
  box-shadow: none;
}

.ai-title {
  font-weight: 800;
}

.flow-tab {
  border-radius: 10rpx;
  background: #F1E7D4;
  color: #6C776F;
}

.flow-tab.active {
  background: #147657;
  color: #FFFFFF;
}

.flow-card,
.ai-loop-card,
.output-card,
.history-card,
.ai-loading {
  border: 1rpx solid #E9DDC8;
  border-radius: 12rpx;
  background: #FFFDF7;
  box-shadow: none;
}

.field-label,
.history-flow {
  color: #173E33;
  font-weight: 800;
}

.photo-cell,
.output-text {
  border: 1rpx solid #E9DDC8;
  border-radius: 10rpx;
  background: #FFFFFF;
}

.history-item {
  border-top-color: #F1E8D8;
}

.history-open {
  color: #147657;
  font-weight: 800;
}

/* UI 1.2 · AI 助手 */
.ai-page,
.ai-loading {
  min-height: 100vh;
  padding: 32rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  background: #F8FAF9;
}

.ai-hero {
  border-radius: 40rpx;
  background: linear-gradient(135deg, #0F6A4A 0%, #1F8B61 100%);
}

.flow-card,
.ai-loop-card,
.output-card,
.history-card,
.ai-loading {
  border: none;
  border-radius: 40rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.02);
}

.flow-tab {
  border-radius: 999rpx;
}

.flow-tab.active {
  background: #0F6A4A;
}

.output-text,
.photo-cell {
  border: none;
  border-radius: 24rpx;
  background: #F8FAF9;
}
