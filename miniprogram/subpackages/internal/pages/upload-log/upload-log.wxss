/* ================================================================
   上传施工日报
   ================================================================ */
.upload-page {
  padding: 0 32rpx 56rpx;
}

.page-header {
  margin: 24rpx 0 24rpx;
}

.page-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #111827;
  line-height: 1.3;
}

/* 表单卡片 */
.form-card {
  margin-bottom: 20rpx;
}

.form-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 16rpx;
  line-height: 1.4;
}

.form-label-hint {
  font-size: 24rpx;
  font-weight: 400;
  color: #9CA3AF;
}

/* 照片网格 */
.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 20rpx;
}

.photo-wrap {
  position: relative;
  width: 100%;
  height: 200rpx;
  border-radius: 24rpx;
  overflow: hidden;
}

.photo {
  width: 100%;
  height: 100%;
}

.photo-remove {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: rgba(17, 24, 39, 0.6);
  color: #FFFFFF;
  font-size: 22rpx;
  line-height: 40rpx;
  text-align: center;
}

.photo-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 200rpx;
  border-radius: 24rpx;
  border: 2rpx dashed #D1D5DB;
  background: #F9FAFB;
}

.photo-add:active {
  background: #F3F4F6;
}

.photo-add-icon {
  font-size: 48rpx;
  color: #9CA3AF;
  line-height: 1;
}

.photo-add-text {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9CA3AF;
}

/* 提交区 */
.submit-area {
  margin-top: 32rpx;
  padding: 0 16rpx;
}

/* UI 1.1 · 上传工序日报 */
.upload-page {
  min-height: 100vh;
  padding: 24rpx 28rpx calc(48rpx + env(safe-area-inset-bottom));
  background: #F8F4EA;
  box-sizing: border-box;
}

.page-header {
  margin-bottom: 24rpx;
}

.page-title {
  color: #173E33;
  font-size: 40rpx;
  font-weight: 800;
}

.form-card {
  margin-bottom: 16rpx;
  border: 1rpx solid #E9DDC8;
  border-radius: 12rpx;
  background: #FFFDF7;
  box-shadow: none;
}

.form-label {
  color: #173E33;
  font-weight: 800;
}

.form-label-hint {
  color: #A4A79E;
  font-weight: 500;
}

.photo-grid {
  gap: 14rpx;
  margin-top: 18rpx;
}

.photo-wrap,
.photo-add {
  border: 1rpx solid #E9DDC8;
  border-radius: 12rpx;
  background: #F1E7D4;
}

.photo-remove {
  background: #C24E45;
}

.photo-add-icon {
  color: #147657;
  font-weight: 700;
}

.submit-area {
  padding: 12rpx 0 0;
}

.submit-area .button-primary {
  border-radius: 12rpx;
  background: #147657;
}

/* UI 1.2 · 上传日报 */
.upload-page {
  min-height: 100vh;
  padding: 32rpx;
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
  background: #F8FAF9;
}

.page-title {
  color: #111827;
  font-size: 44rpx;
  font-weight: 800;
}

.form-card {
  border: none;
  border-radius: 40rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.02);
}

.form-label {
  color: #111827;
  font-weight: 800;
}

.photo-wrap,
.photo-add {
  border: none;
  border-radius: 24rpx;
  background: #F8FAF9;
}

.submit-area .button-primary {
  border-radius: 28rpx;
  background: #0F6A4A;
}

/* Stage 1 · 日报审核链路提示 */
.report-flow-card {
  margin-bottom: 24rpx;
  padding: 32rpx;
  border-radius: 32rpx;
  background: #0F6A4A;
  color: #FFFFFF;
}

.report-flow-title {
  font-size: 32rpx;
  font-weight: 800;
}

.report-flow-desc {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
  line-height: 1.45;
}

.report-flow-steps {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
}

.report-flow-step {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  color: rgba(255, 255, 255, 0.76);
  font-size: 22rpx;
  font-weight: 800;
}

.report-flow-step.active {
  background: #FFFFFF;
  color: #0F6A4A;
}

.report-flow-line {
  flex: 1;
  height: 2rpx;
  background: rgba(255, 255, 255, 0.28);
}

.photo-tip,
.submit-note {
  color: #6B7280;
  font-size: 24rpx;
  line-height: 1.45;
}

.photo-tip {
  margin-top: -4rpx;
}

.submit-note {
  margin-bottom: 16rpx;
  text-align: center;
}
