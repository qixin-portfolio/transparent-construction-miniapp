<view class="lifecycle-page">
  <view class="lifecycle-hero">
    <view class="lifecycle-eyebrow">老友会权益体系</view>
    <view class="lifecycle-title">老客户权益</view>
    <view class="lifecycle-desc">售后、保养、推荐和活动权益，会在这里集中展示。</view>
  </view>

  <view wx:if="{{loading}}" class="lifecycle-card empty-block">
    <view class="empty-title">正在加载权益...</view>
  </view>

  <view wx:elif="{{!items.length}}" class="lifecycle-card empty-block">
    <view class="empty-title">暂无权益配置</view>
    <view class="empty-desc">后续晟景可配置老客户专属权益、推荐奖励和保养提醒。</view>
  </view>

  <view wx:else>
    <!-- 四宫格权益卡片 -->
    <view class="benefits-grid">
      <view wx:for="{{items}}" wx:key="_id" class="benefit-card {{item.highlight ? 'benefit-highlight' : ''}}">
        <view class="benefit-type">{{item.benefitType || '权益'}}</view>
        <view class="benefit-title">{{item.title}}</view>
        <view class="benefit-desc">{{item.description}}</view>
      </view>
    </view>

    <!-- 推荐有礼详情（三级激励） -->
    <view class="lifecycle-card referral-section">
      <view class="section-header">推荐有礼 — 三级即时激励</view>
      <view class="referral-tiers">
        <view class="tier-card tier-small">
          <view class="tier-amount">¥20</view>
          <view class="tier-label">邀友即得</view>
          <view class="tier-desc">20元话费券</view>
        </view>
        <view class="tier-card tier-medium">
          <view class="tier-amount">¥100</view>
          <view class="tier-label">服务有礼</view>
          <view class="tier-desc">100元服务券/现金红包</view>
        </view>
        <view class="tier-card tier-large">
          <view class="tier-amount">¥500–2000</view>
          <view class="tier-label">成交再得</view>
          <view class="tier-desc">按合同金额 · 签约后7天内</view>
        </view>
      </view>
    </view>

    <!-- 规则说明 -->
    <view class="lifecycle-card rules-section">
      <view class="section-header">风控规则</view>
      <view class="rules-text">同手机号仅推荐一次 / 已在客户库的不计入 / 内部员工不作被推荐人 / 客服人工确认有效线索</view>
    </view>

    <!-- 案例授权流程 -->
    <view class="lifecycle-card auth-section">
      <view class="section-header">案例授权流程</view>
      <view class="auth-steps">
        <view class="auth-step">
          <view class="step-num">1</view>
          <view class="step-text">完工后业主在「案例授权」页选择公开范围和素材</view>
        </view>
        <view class="auth-step">
          <view class="step-num">2</view>
          <view class="step-text">晟景审核素材合规性（隐私打码等）</view>
        </view>
        <view class="auth-step">
          <view class="step-num">3</view>
          <view class="step-text">通过后案例上线，老客户获得对应权益激励</view>
        </view>
      </view>
    </view>

    <!-- 授权激励机制 -->
    <view class="lifecycle-card incentive-section">
      <view class="section-header">授权激励机制</view>
      <view class="incentive-text">完成案例授权即享「年度免费深度保洁」1次。隐私保护：提供匿名/姓氏/全名可选，只展示风格面积不暴露隐私。</view>
    </view>
  </view>
</view>
