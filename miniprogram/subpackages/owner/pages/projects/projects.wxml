<view class="owner-projects-page">
  <view class="projects-hero">
    <view class="hero-eyebrow">我的项目</view>
    <view class="hero-title">欢迎回来</view>
    <view class="hero-desc">您在晟景共有 {{stats.total || 0}} 个项目</view>
  </view>

  <view wx:if="{{loading}}" class="project-empty">
    <view class="empty-title">正在加载项目...</view>
  </view>

  <view wx:elif="{{!items.length}}" class="project-empty">
    <view class="empty-title">暂无绑定项目</view>
    <view class="empty-desc">输入晟景工作人员提供的 6 位绑定码，即可查看您的装修进度。</view>
    <view wx:if="{{loadError}}" class="empty-error">{{loadError}}</view>
    <view class="bind-panel">
      <input class="bind-input" type="number" maxlength="6" placeholder="请输入 6 位绑定码" value="{{bindCode}}" bindinput="onBindCodeInput" />
      <button class="bind-button" loading="{{binding}}" disabled="{{binding || bindCode.length < 6}}" bindtap="bindProject">绑定我的工地</button>
    </view>
  </view>

  <block wx:else>
    <view wx:for="{{sections}}" wx:key="key" class="project-section">
      <view class="section-head">
        <view class="section-title">{{item.title}}</view>
        <view class="section-count">{{item.items.length}}</view>
      </view>

      <view wx:if="{{!item.items.length}}" class="section-empty">{{item.emptyText}}</view>

      <view wx:for="{{item.items}}" wx:for-item="project" wx:key="projectId" class="project-card">
        <view class="project-card-head">
          <view>
            <view class="project-name">{{project.projectName || '未命名项目'}}</view>
            <view class="project-location">{{project.locationText}}</view>
          </view>
          <view class="status-pill status-{{project.groupKey}}">{{project.statusLabel}}</view>
        </view>

        <block wx:if="{{project.groupKey === 'inProgress'}}">
          <view class="info-grid">
            <view class="info-item">
              <view class="info-label">当前阶段</view>
              <view class="info-value">{{project.currentStage || '待更新'}}</view>
            </view>
            <view class="info-item">
              <view class="info-label">施工进度</view>
              <view class="info-value strong">{{project.progressText}}</view>
            </view>
            <view class="info-item wide">
              <view class="info-label">工长</view>
              <view class="info-value">{{project.foremanText}}</view>
            </view>
          </view>
          <view class="progress-track">
            <view class="progress-bar" style="width: {{project.progress || 0}}%;"></view>
          </view>
          <view class="action-row">
            <button class="mini-btn primary" data-id="{{project.projectId}}" bindtap="goProgress">查看施工进度</button>
            <button class="mini-btn" data-phone="{{project.foremanPhone}}" bindtap="callForeman">联系工长</button>
          </view>
        </block>

        <block wx:elif="{{project.groupKey === 'delivered'}}">
          <view class="info-grid">
            <view class="info-item">
              <view class="info-label">交付日期</view>
              <view class="info-value">{{project.deliveredAtText}}</view>
            </view>
            <view class="info-item">
              <view class="info-label">质保状态</view>
              <view class="info-value strong">{{project.warrantyStatusText}}</view>
            </view>
          </view>
          <view class="action-row">
            <button class="mini-btn primary" data-id="{{project.projectId}}" bindtap="goWarranty">查看质保卡</button>
            <button class="mini-btn" data-id="{{project.projectId}}" bindtap="goAfterSaleCreate">售后报修</button>
          </view>
        </block>

        <block wx:elif="{{project.groupKey === 'afterSales'}}">
          <view class="info-grid">
            <view class="info-item">
              <view class="info-label">当前工单状态</view>
              <view class="info-value strong">{{project.ticketStatusText}}</view>
            </view>
            <view class="info-item">
              <view class="info-label">最近更新</view>
              <view class="info-value">{{project.updatedAtText}}</view>
            </view>
          </view>
          <view class="action-row">
            <button class="mini-btn primary" data-id="{{project.projectId}}" bindtap="goTickets">查看工单进度</button>
            <button class="mini-btn" data-id="{{project.projectId}}" bindtap="goAfterSaleCreate">继续报修</button>
          </view>
        </block>

        <block wx:else>
          <view class="info-grid">
            <view class="info-item">
              <view class="info-label">项目状态</view>
              <view class="info-value">{{project.statusLabel}}</view>
            </view>
            <view class="info-item">
              <view class="info-label">最近更新</view>
              <view class="info-value">{{project.updatedAtText}}</view>
            </view>
          </view>
        </block>
      </view>
    </view>

    <view class="bind-more-card">
      <view>
        <view class="bind-more-title">还有其他工地？</view>
        <view class="bind-more-desc">输入新的 6 位绑定码，可继续绑定到“我的项目”。</view>
      </view>
      <view class="bind-more-form">
        <input class="bind-input compact" type="number" maxlength="6" placeholder="绑定码" value="{{bindCode}}" bindinput="onBindCodeInput" />
        <button class="bind-button compact" loading="{{binding}}" disabled="{{binding || bindCode.length < 6}}" bindtap="bindProject">绑定</button>
      </view>
    </view>
  </block>
</view>
