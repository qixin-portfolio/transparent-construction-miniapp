.owner-projects-page {
  min-height: 100vh;
  padding: 0 28rpx calc(48rpx + env(safe-area-inset-bottom));
  background: #FAFBFC;
  box-sizing: border-box;
}

.projects-hero {
  margin: 0 -28rpx 28rpx;
  padding: 52rpx 32rpx 70rpx;
  color: #FFFFFF;
  background: linear-gradient(150deg, #0D4D36 0%, #1B7A56 58%, #2AA876 100%);
}

.hero-eyebrow {
  display: inline-flex;
  min-height: 42rpx;
  align-items: center;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  font-size: 23rpx;
  font-weight: 700;
}

.hero-title {
  margin-top: 18rpx;
  font-size: 48rpx;
  line-height: 1.18;
  font-weight: 800;
}

.hero-desc {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.84);
  font-size: 27rpx;
}

.project-section {
  margin-bottom: 28rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.section-title {
  color: #1A1A1A;
  font-size: 32rpx;
  font-weight: 800;
}

.section-count {
  min-width: 44rpx;
  height: 44rpx;
  border-radius: 999rpx;
  color: #1B7A56;
  background: #E8F5EE;
  font-size: 24rpx;
  line-height: 44rpx;
  text-align: center;
  font-weight: 800;
}

.section-empty,
.project-empty {
  padding: 44rpx 28rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  color: #6B7280;
  font-size: 25rpx;
  text-align: center;
  box-shadow: 0 8rpx 30rpx rgba(13, 77, 54, 0.04);
}

.project-empty {
  padding: 88rpx 40rpx;
}

.empty-title {
  color: #1A1A1A;
  font-size: 32rpx;
  font-weight: 800;
}

.empty-desc {
  margin-top: 12rpx;
  color: #6B7280;
  font-size: 26rpx;
  line-height: 1.55;
}

.empty-error {
  margin-top: 18rpx;
  padding: 14rpx 18rpx;
  border-radius: 16rpx;
  background: #FFF8E1;
  color: #8A5A00;
  font-size: 23rpx;
  line-height: 1.45;
}

.bind-panel {
  margin-top: 28rpx;
  display: flex;
  gap: 16rpx;
}

.bind-input {
  flex: 1;
  height: 76rpx;
  padding: 0 24rpx;
  border-radius: 18rpx;
  background: #F8FAF9;
  color: #1A1A1A;
  font-size: 28rpx;
  text-align: left;
  box-sizing: border-box;
}

.bind-button {
  width: 220rpx;
  height: 76rpx;
  margin: 0;
  border-radius: 18rpx;
  color: #FFFFFF;
  background: #1B7A56;
  font-size: 25rpx;
  line-height: 76rpx;
  font-weight: 800;
}

.bind-button::after {
  border: none;
}

.project-card {
  margin-bottom: 18rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 30rpx rgba(13, 77, 54, 0.05);
  box-sizing: border-box;
}

.project-card-head {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
}

.project-name {
  color: #1A1A1A;
  font-size: 31rpx;
  line-height: 1.35;
  font-weight: 800;
}

.project-location {
  margin-top: 8rpx;
  color: #6B7280;
  font-size: 24rpx;
  line-height: 1.45;
}

.status-pill {
  flex-shrink: 0;
  height: 44rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  color: #1B7A56;
  background: #E8F5EE;
  font-size: 22rpx;
  line-height: 44rpx;
  font-weight: 800;
}

.status-afterSales {
  color: #B45309;
  background: #FEF3C7;
}

.status-delivered {
  color: #2563EB;
  background: #DBEAFE;
}

.status-others {
  color: #6B7280;
  background: #F3F4F6;
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
  margin-top: 24rpx;
}

.info-item {
  min-width: 0;
  padding: 20rpx;
  border-radius: 20rpx;
  background: #F8FAF9;
}

.info-item.wide {
  grid-column: span 2;
}

.info-label {
  color: #6B7280;
  font-size: 22rpx;
}

.info-value {
  margin-top: 8rpx;
  color: #1A1A1A;
  font-size: 26rpx;
  line-height: 1.35;
  word-break: break-all;
}

.info-value.strong {
  color: #1B7A56;
  font-weight: 800;
}

.progress-track {
  height: 14rpx;
  margin-top: 22rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #E5E7EB;
}

.progress-bar {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #1B7A56, #2AA876);
}

.action-row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.mini-btn {
  flex: 1;
  height: 76rpx;
  margin: 0;
  border-radius: 18rpx;
  color: #1B7A56;
  background: #E8F5EE;
  font-size: 25rpx;
  line-height: 76rpx;
  font-weight: 800;
}

.mini-btn::after {
  border: none;
}

.mini-btn.primary {
  color: #FFFFFF;
  background: #1B7A56;
}

.bind-more-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin: 8rpx 0 28rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 30rpx rgba(13, 77, 54, 0.05);
  box-sizing: border-box;
}

.bind-more-title {
  color: #1A1A1A;
  font-size: 28rpx;
  font-weight: 800;
}

.bind-more-desc {
  margin-top: 8rpx;
  color: #6B7280;
  font-size: 23rpx;
  line-height: 1.4;
}

.bind-more-form {
  flex-shrink: 0;
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.bind-input.compact {
  flex: none;
  width: 168rpx;
  height: 68rpx;
  font-size: 25rpx;
}

.bind-button.compact {
  width: 112rpx;
  height: 68rpx;
  font-size: 24rpx;
  line-height: 68rpx;
}
