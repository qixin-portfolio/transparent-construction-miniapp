.supplement-page {
  min-height: 100vh;
  background: #FAF8F5;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

/* ===== 顶部说明区 ===== */
.info-hero {
  padding: 60rpx 40rpx 36rpx;
  background: linear-gradient(150deg, #0D4D36 0%, #1B7A56 60%, #2AA876 100%);
  color: #FFFFFF;
}

.info-eyebrow {
  font-size: 24rpx;
  opacity: 0.85;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

.info-title {
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.3;
  margin-bottom: 12rpx;
}

.info-desc {
  font-size: 26rpx;
  opacity: 0.92;
  line-height: 1.55;
}

/* ===== 通用卡片 ===== */
.info-card {
  margin: 28rpx 28rpx 0;
  padding: 32rpx 28rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 24rpx rgba(13, 77, 54, 0.04);
}

.card-title {
  color: #1A1A1A;
  font-size: 32rpx;
  font-weight: 800;
  margin-bottom: 24rpx;
}

.empty-block {
  text-align: center;
}

.empty-title {
  color: #6B7280;
  font-size: 28rpx;
}

/* ===== 已上传资料列表 ===== */
.supplement-item {
  padding: 24rpx 0;
  border-top: 1rpx solid #F3F4F6;
}

.supplement-item:first-of-type {
  border-top: none;
  padding-top: 0;
}

.supplement-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.supplement-date {
  color: #9CA3AF;
  font-size: 24rpx;
}

.supplement-del {
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: #FEF2F2;
  color: #DC2626;
  font-size: 22rpx;
  font-weight: 600;
}

.supplement-remark {
  margin-bottom: 12rpx;
  color: #374151;
  font-size: 26rpx;
  line-height: 1.5;
  padding: 14rpx 18rpx;
  border-radius: 12rpx;
  background: #F8FAF9;
}

.supplement-photos {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 10rpx;
}

.supplement-photo {
  width: 100%;
  height: 200rpx;
  border-radius: 12rpx;
  background: #F3F4F6;
}

/* ===== 上传区 ===== */
.upload-area {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-bottom: 14rpx;
}

.upload-thumb {
  position: relative;
  width: 100%;
  height: 200rpx;
  border-radius: 14rpx;
  overflow: hidden;
  background: #F3F4F6;
}

.upload-thumb image {
  width: 100%;
  height: 100%;
  display: block;
}

.thumb-del {
  position: absolute;
  top: 6rpx;
  right: 6rpx;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.55);
  color: #FFFFFF;
  font-size: 28rpx;
  line-height: 36rpx;
  text-align: center;
}

.upload-add {
  width: 100%;
  height: 200rpx;
  border-radius: 14rpx;
  border: 2rpx dashed #C7D4CD;
  background: #F8FAF9;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.add-icon {
  font-size: 60rpx;
  color: #1B7A56;
  line-height: 1;
  margin-bottom: 8rpx;
}

.add-text {
  color: #1B7A56;
  font-size: 24rpx;
}

.upload-tips {
  color: #9CA3AF;
  font-size: 22rpx;
  margin-bottom: 24rpx;
}

/* ===== 备注 ===== */
.remark-area {
  margin-bottom: 24rpx;
}

.remark-label {
  color: #374151;
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.remark-input {
  width: 100%;
  min-height: 120rpx;
  padding: 18rpx 20rpx;
  border-radius: 14rpx;
  background: #F8FAF9;
  border: 1rpx solid #E5E7EB;
  color: #1A1A1A;
  font-size: 26rpx;
  line-height: 1.5;
  box-sizing: border-box;
}

/* ===== 提交按钮 ===== */
.btn-submit {
  width: 100%;
  height: 92rpx;
  line-height: 92rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #1B7A56, #2AA876);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
}

.btn-submit::after {
  border: none;
}

.btn-submit[disabled] {
  background: #D1D5DB;
  color: #FFFFFF;
}

/* ===== 底部提示 ===== */
.footer-tips {
  margin: 36rpx 40rpx 0;
  padding: 28rpx 24rpx;
  border-radius: 18rpx;
  background: #F8FAF9;
}

.tips-title {
  color: #1B7A56;
  font-size: 26rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.tips-text {
  color: #6B7280;
  font-size: 23rpx;
  line-height: 1.7;
}
