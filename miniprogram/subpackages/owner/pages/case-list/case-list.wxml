<view class="case-list-page">
  <!-- 顶部说明 -->
  <view class="page-banner">
    <view class="banner-title">真实完工案例</view>
    <view class="banner-sub">{{source === 'real' ? '晟景装饰交城本地真实完工工地' : '品牌参考案例，业主授权后将展示真实工地'}}</view>
  </view>

  <!-- 加载中 -->
  <view wx:if="{{loading}}" class="loading-block">
    <view class="loading-text">案例加载中...</view>
  </view>

  <!-- 空状态 -->
  <view wx:elif="{{!cases.length}}" class="empty-block">
    <view class="empty-icon">🏠</view>
    <view class="empty-title">暂无完工案例</view>
    <view class="empty-desc">业主授权后会在这里展示真实完工案例。</view>
  </view>

  <!-- 案例列表 -->
  <block wx:else>
    <view wx:for="{{cases}}" wx:key="_id" class="case-card" data-id="{{item._id}}" bindtap="goDetail">
      <view class="case-cover-wrap">
        <image wx:if="{{item.coverImage}}" class="case-cover" src="{{item.coverImage}}" mode="aspectFill" lazy-load></image>
        <view wx:else class="case-cover-placeholder">
          <view class="placeholder-text">案例图片整理中</view>
        </view>
        <view wx:if="{{item.isReference}}" class="ref-badge">品牌参考</view>
        <view wx:if="{{item.authorizationLabel}}" class="auth-badge">{{item.authorizationLabel}}</view>
      </view>

      <view class="case-body">
        <view class="case-title">{{item.displayTitle}}</view>
        <view class="case-subtitle">{{item.displaySubtitle}}</view>

        <view class="case-row">
          <view class="case-label">方案类型</view>
          <view class="case-value">{{item.displayPlanType}}</view>
        </view>

        <view wx:if="{{item.displayHighlights}}" class="case-highlights">
          <view class="highlights-label">设计亮点</view>
          <view class="highlights-text">{{item.displayHighlights}}</view>
        </view>

        <view wx:if="{{item.displayBudgetText}}" class="case-budget">
          <text>{{item.displayBudgetText}}</text>
        </view>

        <view class="case-actions">
          <view class="case-btn primary" catchtap="goDetail" data-id="{{item._id}}">查看案例</view>
          <view class="case-btn outline" catchtap="showAppointment">预约量房</view>
        </view>
      </view>
    </view>

    <!-- 底部 CTA -->
    <view class="bottom-cta">
      <view class="cta-title">想看更多案例？</view>
      <view class="cta-desc">联系晟景顾问，预约到店查看更多完工工地</view>
      <view class="cta-actions">
        <button class="cta-btn outline" bindtap="callStore">📞 电话咨询</button>
        <button class="cta-btn primary" bindtap="showAppointment">预约量房设计</button>
      </view>
    </view>
  </block>
</view>
