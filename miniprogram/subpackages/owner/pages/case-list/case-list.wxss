.case-list-page {
  min-height: 100vh;
  background: #FAF8F5;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

.page-banner {
  padding: 48rpx 40rpx 32rpx;
  background: linear-gradient(135deg, #0D4D36 0%, #1B7A56 100%);
  color: #FFFFFF;
}

.banner-title {
  font-size: 40rpx;
  font-weight: 800;
}

.banner-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  opacity: 0.85;
  line-height: 1.5;
}

.loading-block, .empty-block {
  padding: 120rpx 40rpx;
  text-align: center;
}

.loading-text {
  color: #6B7280;
  font-size: 28rpx;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  color: #1A1A1A;
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.empty-desc {
  color: #9CA3AF;
  font-size: 26rpx;
  line-height: 1.5;
}

.case-card {
  margin: 24rpx 28rpx 0;
  border-radius: 24rpx;
  background: #FFFFFF;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(13, 77, 54, 0.05);
}

.case-card:active {
  transform: scale(0.99);
}

.case-cover-wrap {
  position: relative;
  width: 100%;
  height: 400rpx;
  background: #F3F4F6;
}

.case-cover {
  width: 100%;
  height: 100%;
  display: block;
}

.case-cover-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #E8F5EE 0%, #F0FDF4 100%);
}

.placeholder-text {
  color: #9CA3AF;
  font-size: 26rpx;
}

.ref-badge {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 600;
}

.auth-badge {
  position: absolute;
  bottom: 20rpx;
  left: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(27, 122, 86, 0.92);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 600;
}

.case-body {
  padding: 28rpx 28rpx 32rpx;
}

.case-title {
  color: #1A1A1A;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.3;
}

.case-subtitle {
  margin-top: 10rpx;
  color: #1B7A56;
  font-size: 26rpx;
  font-weight: 500;
}

.case-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 18rpx;
  padding: 14rpx 20rpx;
  border-radius: 14rpx;
  background: #F8FAF9;
}

.case-label {
  color: #6B7280;
  font-size: 24rpx;
  min-width: 120rpx;
}

.case-value {
  color: #1A1A1A;
  font-size: 26rpx;
  font-weight: 600;
  flex: 1;
}

.case-highlights {
  margin-top: 18rpx;
}

.highlights-label {
  color: #6B7280;
  font-size: 24rpx;
  margin-bottom: 6rpx;
}

.highlights-text {
  color: #1A1A1A;
  font-size: 26rpx;
  line-height: 1.5;
}

.case-budget {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 14rpx;
  background: #FEF3C7;
  color: #92400E;
  font-size: 23rpx;
  line-height: 1.6;
  white-space: pre-line;
}

.case-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.case-btn {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 18rpx;
  font-size: 27rpx;
  font-weight: 600;
}

.case-btn.primary {
  background: linear-gradient(135deg, #1B7A56, #2AA876);
  color: #FFFFFF;
}

.case-btn.outline {
  background: #FFFFFF;
  color: #1B7A56;
  border: 2rpx solid #1B7A56;
}

.bottom-cta {
  margin: 40rpx 28rpx 0;
  padding: 36rpx 28rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  text-align: center;
  box-shadow: 0 4rpx 24rpx rgba(13, 77, 54, 0.04);
}

.cta-title {
  color: #1A1A1A;
  font-size: 30rpx;
  font-weight: 700;
}

.cta-desc {
  margin-top: 8rpx;
  color: #9CA3AF;
  font-size: 24rpx;
}

.cta-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}

.cta-btn {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 20rpx;
  font-size: 27rpx;
  font-weight: 600;
  border: none;
}

.cta-btn.outline {
  background: #F8FAF9;
  color: #1B7A56;
}

.cta-btn.primary {
  background: linear-gradient(135deg, #1B7A56, #2AA876);
  color: #FFFFFF;
}

.cta-btn::after {
  border: none;
}
