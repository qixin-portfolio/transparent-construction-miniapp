<view class="lifecycle-page">
  <view class="lifecycle-hero">
    <view class="lifecycle-eyebrow">电子质保卡</view>
    <view class="lifecycle-title">晟景装饰电子质保卡</view>
    <view class="lifecycle-desc">{{project.name || '质保服务'}} · 质保范围、时间和联系方式集中保存。</view>
  </view>

  <view wx:if="{{loading}}" class="lifecycle-card empty-block">
    <view class="empty-title">正在加载质保卡...</view>
  </view>

  <view wx:elif="{{!warrantyCard}}" class="lifecycle-card empty-block">
    <view class="empty-title">暂无电子质保卡</view>
    <view class="empty-desc">请联系晟景装饰门店确认质保卡信息。</view>
  </view>

  <block wx:else>
    <view class="lifecycle-card">
      <view class="status-pill">{{warrantyCard.status === 'expired' ? '已过期' : '质保中'}}</view>
      <view class="lifecycle-card-title">{{warrantyCard.warrantyNo || '晟景电子质保卡'}}</view>
      <view class="lifecycle-card-desc">{{warrantyCard.termsText}}</view>
      <view class="info-row">
        <view class="info-label">业主姓名</view>
        <view class="info-value">{{warrantyCard.ownerNameText}}</view>
      </view>
      <view class="info-row">
        <view class="info-label">项目地址</view>
        <view class="info-value">{{warrantyCard.projectAddressText}}</view>
      </view>
      <view class="info-row">
        <view class="info-label">交付日期</view>
        <view class="info-value">{{warrantyCard.deliveredAtText}}</view>
      </view>
      <view class="info-row">
        <view class="info-label">质保开始日期</view>
        <view class="info-value">{{warrantyCard.warrantyStartText}}</view>
      </view>
      <view class="info-row">
        <view class="info-label">质保结束日期</view>
        <view class="info-value">{{warrantyCard.warrantyEndText}}</view>
      </view>
      <view class="info-row">
        <view class="info-label">售后服务热线</view>
        <view class="info-value">{{warrantyCard.servicePhoneText}}</view>
      </view>
    </view>

    <view class="lifecycle-card">
      <view class="lifecycle-card-title">质保范围</view>
      <view wx:if="{{warrantyCard.items.length}}" class="lifecycle-list">
        <view wx:for="{{warrantyCard.items}}" wx:key="name" class="info-row">
          <view class="info-label">{{item.name || item.title}}</view>
          <view class="info-value">{{item.period || item.duration || ''}} {{item.description || item.remark || ''}}</view>
        </view>
      </view>
      <view wx:else class="lifecycle-card-desc">暂无细分质保项目。</view>
    </view>

    <button class="button-primary" bindtap="goAfterSaleCreate">一键售后报修</button>
  </block>
</view>
