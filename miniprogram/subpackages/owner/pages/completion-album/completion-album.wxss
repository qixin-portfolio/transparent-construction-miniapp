.album-page {
  min-height: 100vh;
  background: #FAF8F5;
  padding-bottom: calc(60rpx + env(safe-area-inset-bottom));
}

/* ===== 加载/空状态 ===== */
.loading-block, .empty-block {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx 40rpx;
  background: #FAF8F5;
}

.loading-text {
  color: #6B7280;
  font-size: 28rpx;
}

.empty-icon {
  font-size: 96rpx;
  margin-bottom: 24rpx;
}

.empty-title {
  color: #1A1A1A;
  font-size: 36rpx;
  font-weight: 800;
  margin-bottom: 16rpx;
}

.empty-desc {
  color: #6B7280;
  font-size: 26rpx;
  line-height: 1.6;
  text-align: center;
  max-width: 500rpx;
  margin-bottom: 36rpx;
}

/* ===== 封面区 ===== */
.cover-section {
  position: relative;
  width: 100%;
  height: 600rpx;
  overflow: hidden;
  background: linear-gradient(150deg, #0D4D36 0%, #1B7A56 58%, #2AA876 100%);
}

.cover-image {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.cover-swiper {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.cover-swiper .cover-image {
  position: static;
}

.cover-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.5) 100%);
}

.cover-content {
  position: absolute;
  bottom: 60rpx;
  left: 40rpx;
  right: 40rpx;
  color: #FFFFFF;
}

.cover-badge {
  display: inline-flex;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  font-size: 22rpx;
  font-weight: 600;
  margin-bottom: 16rpx;
}

.cover-title {
  font-size: 52rpx;
  font-weight: 800;
  line-height: 1.2;
  text-shadow: 0 2rpx 12rpx rgba(0,0,0,0.3);
}

.cover-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
}

.cover-meta-item {
  font-size: 26rpx;
  opacity: 0.95;
}

.cover-meta-divider {
  font-size: 26rpx;
  opacity: 0.6;
}

.cover-date {
  margin-top: 8rpx;
  font-size: 24rpx;
  opacity: 0.8;
}

.cover-brand {
  position: absolute;
  top: 60rpx;
  right: 40rpx;
  color: rgba(255, 255, 255, 0.6);
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

/* ===== 通用卡片 ===== */
.section-card {
  margin: 28rpx 28rpx 0;
  padding: 36rpx 32rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 24rpx rgba(13, 77, 54, 0.04);
}

.section-title {
  color: #1A1A1A;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 1.3;
}

.section-subtitle {
  margin-top: 8rpx;
  color: #9CA3AF;
  font-size: 24rpx;
  line-height: 1.5;
}

/* ===== 照片不足提示 ===== */
.notice-card {
  margin: 28rpx 28rpx 0;
  padding: 28rpx 32rpx;
  border-radius: 20rpx;
  background: #FEF3C7;
  text-align: center;
}

.notice-title {
  color: #92400E;
  font-size: 28rpx;
  font-weight: 700;
}

.notice-desc {
  margin-top: 6rpx;
  color: #B78103;
  font-size: 24rpx;
  line-height: 1.5;
}

/* ===== 新家信息网格 ===== */
.info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
  margin-top: 24rpx;
}

.info-cell {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F3F4F6;
}

.info-cell:nth-child(odd) {
  padding-right: 24rpx;
}

.info-cell:nth-child(even) {
  padding-left: 24rpx;
  border-left: 1rpx solid #F3F4F6;
}

.info-cell:nth-last-child(-n+2) {
  border-bottom: none;
}

.info-label {
  color: #9CA3AF;
  font-size: 22rpx;
  margin-bottom: 6rpx;
}

.info-value {
  color: #1A1A1A;
  font-size: 26rpx;
  font-weight: 500;
}

.info-story {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #F8FAF9;
  color: #1B7A56;
  font-size: 25rpx;
  line-height: 1.6;
}

/* ===== 装修历程时间轴 ===== */
.timeline {
  margin-top: 28rpx;
  padding-left: 8rpx;
}

.timeline-item {
  position: relative;
  padding-left: 40rpx;
  padding-bottom: 32rpx;
}

.timeline-dot {
  position: absolute;
  left: 0;
  top: 8rpx;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #D1D5DB;
  z-index: 1;
}

.dot-active {
  background: #1B7A56;
  box-shadow: 0 0 0 6rpx rgba(27, 122, 86, 0.15);
}

.timeline-line {
  position: absolute;
  left: 7rpx;
  top: 24rpx;
  bottom: 0;
  width: 2rpx;
  background: #E5E7EB;
}

.timeline-content {
  padding-left: 12rpx;
}

.timeline-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.timeline-name {
  color: #1A1A1A;
  font-size: 30rpx;
  font-weight: 700;
}

.timeline-status {
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  background: #E8F5EE;
  color: #1B7A56;
  font-size: 22rpx;
  font-weight: 600;
}

.timeline-date {
  margin-top: 6rpx;
  color: #9CA3AF;
  font-size: 23rpx;
}

.timeline-desc {
  margin-top: 8rpx;
  color: #4B5563;
  font-size: 25rpx;
  line-height: 1.55;
}

.timeline-photos {
  display: flex;
  gap: 12rpx;
  margin-top: 14rpx;
  flex-wrap: wrap;
}

.timeline-photo {
  width: 140rpx;
  height: 140rpx;
  border-radius: 14rpx;
  background: #F3F4F6;
}

/* ===== 过程精选 ===== */
.process-group {
  margin-top: 28rpx;
}

.process-name {
  color: #1B7A56;
  font-size: 28rpx;
  font-weight: 700;
}

.process-desc {
  margin-top: 6rpx;
  color: #6B7280;
  font-size: 23rpx;
  line-height: 1.5;
}

.process-photos {
  display: flex;
  gap: 12rpx;
  margin-top: 14rpx;
  flex-wrap: wrap;
}

.process-photo {
  width: 200rpx;
  height: 200rpx;
  border-radius: 16rpx;
  background: #F3F4F6;
}

/* ===== 完工实景 ===== */
.completion-wall {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 24rpx;
}

.completion-item {
  border-radius: 16rpx;
  overflow: hidden;
  background: #F3F4F6;
}

.completion-item image {
  width: 100%;
  height: 100%;
  display: block;
}

.item-large {
  grid-column: span 2;
}

.item-large image {
  height: 400rpx;
}

.completion-item:not(.item-large) image {
  height: 240rpx;
}

/* ===== 空状态内联 ===== */
.empty-inline {
  margin-top: 24rpx;
  padding: 40rpx 24rpx;
  text-align: center;
  border-radius: 16rpx;
  background: #F8FAF9;
}

.empty-inline-text {
  color: #1A1A1A;
  font-size: 28rpx;
  font-weight: 600;
}

.empty-inline-desc {
  margin-top: 8rpx;
  color: #9CA3AF;
  font-size: 24rpx;
  line-height: 1.5;
}

/* ===== 服务团队 ===== */
.team-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin-top: 24rpx;
}

.team-card {
  padding: 28rpx 20rpx;
  border-radius: 18rpx;
  background: #F8FAF9;
  text-align: center;
}

.team-avatar {
  width: 72rpx;
  height: 72rpx;
  margin: 0 auto;
  border-radius: 50%;
  background: #E8F5EE;
  color: #1B7A56;
  font-size: 30rpx;
  font-weight: 800;
  line-height: 72rpx;
}

.team-name {
  margin-top: 12rpx;
  color: #1A1A1A;
  font-size: 27rpx;
  font-weight: 700;
}

.team-role {
  margin-top: 4rpx;
  color: #6B7280;
  font-size: 22rpx;
}

.team-tag {
  margin-top: 8rpx;
  color: #9CA3AF;
  font-size: 20rpx;
}

/* ===== 祝福语 ===== */
.blessing-card {
  margin: 28rpx 28rpx 0;
  padding: 48rpx 36rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #F0FDF4 0%, #F7FeeC 100%);
  text-align: center;
}

.blessing-icon {
  font-size: 56rpx;
  margin-bottom: 16rpx;
}

.blessing-title {
  color: #0D4D36;
  font-size: 32rpx;
  font-weight: 800;
  margin-bottom: 20rpx;
}

.blessing-text {
  color: #374151;
  font-size: 26rpx;
  line-height: 1.85;
}

.blessing-brand {
  margin-top: 24rpx;
  color: #1B7A56;
  font-size: 24rpx;
  font-weight: 600;
}

/* ===== 分享操作区 ===== */
.action-section {
  margin: 36rpx 28rpx 0;
  text-align: center;
}

.btn-share {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  width: 100%;
  height: 92rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #1B7A56, #2AA876);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  line-height: 92rpx;
}

.btn-share::after {
  border: none;
}

.btn-icon {
  font-size: 32rpx;
}

.action-tips {
  margin-top: 14rpx;
  color: #9CA3AF;
  font-size: 23rpx;
}

/* ===== 温暖按钮 ===== */
.btn-warm {
  width: 280rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 22rpx;
  background: linear-gradient(135deg, #1B7A56, #2AA876);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}

.btn-warm::after {
  border: none;
}

.btn-warm-small {
  display: inline-block;
  margin-top: 16rpx;
  padding: 12rpx 36rpx;
  border-radius: 999rpx;
  background: #1B7A56;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.4;
  border: none;
}

.btn-warm-small::after {
  border: none;
}

/* ===== 相关推荐 ===== */
.recommend-section {
  margin: 36rpx 28rpx 0;
}

.recommend-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 24rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 20rpx rgba(13, 77, 54, 0.04);
  margin-bottom: 14rpx;
}

.recommend-card:active {
  opacity: 0.9;
  transform: scale(0.99);
}

.recommend-icon {
  font-size: 40rpx;
  min-width: 56rpx;
  text-align: center;
}

.recommend-info {
  flex: 1;
}

.recommend-title {
  color: #1A1A1A;
  font-size: 28rpx;
  font-weight: 700;
}

.recommend-desc {
  margin-top: 4rpx;
  color: #9CA3AF;
  font-size: 22rpx;
}

.recommend-arrow {
  color: #D1D5DB;
  font-size: 36rpx;
}

/* ===== 底部品牌 ===== */
.footer-brand {
  margin-top: 48rpx;
  text-align: center;
}

.footer-text {
  color: #1B7A56;
  font-size: 26rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.footer-subtext {
  margin-top: 6rpx;
  color: #9CA3AF;
  font-size: 22rpx;
}
