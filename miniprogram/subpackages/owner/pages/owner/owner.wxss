/* ================================================================
   业主施工进度页
   ================================================================ */
.owner-page {
  padding: 0 32rpx 56rpx;
}

/* 加载态 */
.owner-loading {
  min-height: 320rpx;
  padding-top: 120rpx;
  box-sizing: border-box;
  border-radius: 40rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 24rpx rgba(17, 24, 39, 0.04);
  text-align: center;
}

.owner-loading-icon {
  font-size: 56rpx;
  line-height: 1;
}

.owner-loading-text {
  margin-top: 20rpx;
  color: #6B7280;
  font-size: 28rpx;
}

/* 绑定流程 */
.bind-state {
  min-height: 680rpx;
}

.bind-hero {
  padding: 56rpx 36rpx 48rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #1B7A56 0%, #2AA876 100%);
  color: #FFFFFF;
  text-align: center;
}

.bind-hero-icon {
  font-size: 72rpx;
  line-height: 1;
  margin-bottom: 20rpx;
}

.bind-eyebrow {
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
  line-height: 1.3;
}

.bind-title {
  margin-top: 16rpx;
  font-size: 44rpx;
  line-height: 1.25;
  font-weight: 600;
}

.bind-desc {
  max-width: 560rpx;
  margin: 16rpx auto 0;
  color: rgba(255, 255, 255, 0.82);
  font-size: 26rpx;
  line-height: 1.5;
}

.bind-panel {
  margin-top: -36rpx;
  padding: 36rpx 32rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 32rpx rgba(15, 106, 74, 0.1);
  box-sizing: border-box;
  position: relative;
  z-index: 2;
}

.bind-hint {
  margin-top: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 20rpx;
  background: #E8F5EE;
  color: #1B7A56;
  font-size: 26rpx;
  line-height: 1.5;
}

.bind-input {
  margin: 28rpx 0;
  padding-left: 12rpx;
  text-align: center;
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: 16rpx;
}

/* 业主进度 Hero */
.owner-hero {
  margin-top: 24rpx;
  padding: 36rpx 32rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #1B7A56 0%, #2AA876 100%);
  color: #FFFFFF;
  box-sizing: border-box;
}

.owner-hero-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.owner-copy {
  min-width: 0;
  flex: 1;
}

.owner-eyebrow {
  color: rgba(255, 255, 255, 0.76);
  font-size: 24rpx;
  line-height: 1.3;
}

.owner-project-title {
  margin-top: 12rpx;
  color: #FFFFFF;
  font-size: 40rpx;
  line-height: 1.25;
  font-weight: 600;
}

.owner-address {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 24rpx;
  line-height: 1.4;
}

.owner-status {
  flex-shrink: 0;
  min-height: 48rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  color: #FFFFFF;
  font-size: 24rpx;
  line-height: 48rpx;
  font-weight: 600;
}

.progress-hero-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 22rpx;
  margin-top: 40rpx;
}

.progress-hero-left {
  flex: 1;
}

.progress-number {
  color: #FFFFFF;
  font-size: 80rpx;
  line-height: 1;
  font-weight: 700;
}

.progress-unit {
  font-size: 36rpx;
  font-weight: 600;
}

.progress-label {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
}

.stage-panel {
  width: 260rpx;
  min-height: 112rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.14);
  box-sizing: border-box;
}

.stage-label {
  color: rgba(255, 255, 255, 0.68);
  font-size: 22rpx;
  line-height: 1.25;
}

.stage-name {
  display: -webkit-box;
  margin-top: 8rpx;
  overflow: hidden;
  color: #FFFFFF;
  font-size: 28rpx;
  line-height: 1.25;
  font-weight: 600;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.hero-progress {
  height: 16rpx;
  margin-top: 32rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
}

.hero-progress-bar {
  height: 100%;
  border-radius: 999rpx;
  background: #FFFFFF;
}

.owner-metrics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-top: 28rpx;
}

.owner-metric {
  min-height: 112rpx;
  padding: 20rpx 16rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.14);
}

.metric-value {
  color: #FFFFFF;
  font-size: 36rpx;
  line-height: 1.2;
  font-weight: 700;
}

.metric-value.short {
  display: -webkit-box;
  min-height: 44rpx;
  overflow: hidden;
  font-size: 24rpx;
  line-height: 1.25;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.metric-label {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 22rpx;
  line-height: 1.3;
}

/* 订阅通知 */
.subscribe-banner {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin: 24rpx 0 28rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 20rpx rgba(17, 24, 39, 0.04);
}

.subscribe-banner:active {
  opacity: 0.92;
}

.subscribe-icon {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: #E8F5EE;
  color: #1B7A56;
  font-size: 30rpx;
  line-height: 64rpx;
  font-weight: 700;
  text-align: center;
}

.subscribe-text {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.subscribe-title {
  color: #111827;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.3;
}

.subscribe-desc {
  color: #6B7280;
  font-size: 24rpx;
  line-height: 1.3;
}

.subscribe-arrow {
  flex-shrink: 0;
  color: #1B7A56;
  font-size: 40rpx;
  line-height: 64rpx;
}

/* 设计效果图 */
.render-section {
  margin-bottom: 28rpx;
}

.render-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.render-card {
  background: #FFFFFF;
  border-radius: 32rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 24rpx rgba(17, 24, 39, 0.05);
}

.render-image-wrap {
  position: relative;
  width: 100%;
  height: 420rpx;
  background: #F3F4F6;
}

.render-image {
  width: 100%;
  height: 100%;
}

.render-image-ph {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  color: #9CA3AF;
  font-size: 26rpx;
}

.render-confirmed {
  position: absolute;
  top: 20rpx;
  right: 20rpx;
  padding: 8rpx 24rpx;
  background: rgba(15, 106, 74, 0.9);
  color: #FFFFFF;
  font-size: 22rpx;
  border-radius: 999rpx;
  font-weight: 500;
}

.render-info {
  padding: 28rpx 28rpx 32rpx;
}

.render-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}

.render-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
  flex: 1;
}

.render-space {
  font-size: 22rpx;
  color: #1B7A56;
  background: #E8F5EE;
  padding: 6rpx 20rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
  font-weight: 500;
}

.render-remark {
  font-size: 26rpx;
  color: #6B7280;
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.render-confirm-btn {
  margin-top: 8rpx;
}

/* 照片墙 + 时间线（复用公共样式） */
.photo-section,
.timeline-section {
  margin-bottom: 28rpx;
}

.stage-filter {
  display: flex;
  gap: 14rpx;
  margin-bottom: 20rpx;
  overflow-x: auto;
  -webkit-overflow-scrolling: touch;
}

.stage-filter::-webkit-scrollbar {
  display: none;
}

.photo-wall {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.photo-tile {
  position: relative;
  height: 240rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: #F3F4F6;
}

.photo-tile:active {
  opacity: 0.88;
}

.photo {
  width: 100%;
  height: 100%;
}

.photo-caption {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  max-width: 220rpx;
  min-height: 44rpx;
  padding: 0 14rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: rgba(17, 24, 39, 0.72);
  color: #FFFFFF;
  font-size: 22rpx;
  line-height: 44rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.timeline {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.timeline-item {
  position: relative;
  margin-left: 24rpx;
}

.timeline-dot {
  position: absolute;
  top: 36rpx;
  left: -36rpx;
  width: 20rpx;
  height: 20rpx;
  border: 6rpx solid #F7FAF8;
  border-radius: 50%;
  background: #1B7A56;
}

.log-content {
  margin-top: 18rpx;
  color: #111827;
  font-size: 28rpx;
  line-height: 1.55;
}

.plan-text {
  margin-top: 14rpx;
}

.inline-photos {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 20rpx;
}

.inline-photo {
  width: 100%;
  height: 180rpx;
  border-radius: 20rpx;
  background: #F3F4F6;
}

.inline-photo:active {
  opacity: 0.88;
}

.timeline-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: 24rpx;
  padding: 20rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 20rpx rgba(17, 24, 39, 0.03);
}

.toggle-text {
  color: #1B7A56;
  font-size: 26rpx;
  font-weight: 600;
}

.toggle-arrow {
  width: 0;
  height: 0;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
}

.arrow-down {
  border-top: 12rpx solid #1B7A56;
}

.arrow-up {
  border-bottom: 12rpx solid #1B7A56;
}

/* UI 1.1 · 业主绑定 / 业主进度 */
.owner-page {
  min-height: 100vh;
  padding: 24rpx 28rpx calc(56rpx + env(safe-area-inset-bottom));
  background: #FAFBFC;
  box-sizing: border-box;
}

.owner-loading,
.bind-panel,
.render-card,
.timeline-item {
  border: 1rpx solid #E8ECF0;
  border-radius: 12rpx;
  background: #FFFFFF;
  box-shadow: none;
}

.bind-hero,
.owner-hero {
  margin: 0;
  padding: 30rpx 28rpx;
  border-radius: 14rpx;
  background: #1B7A56;
  box-shadow: none;
}

.bind-hero-icon {
  margin-bottom: 16rpx;
}

.bind-title,
.owner-project-title {
  font-size: 38rpx;
  font-weight: 800;
}

.bind-panel {
  margin-top: 18rpx;
}

.bind-hint {
  border-radius: 10rpx;
  background: #E8F5EE;
  color: #1B7A56;
}

.bind-input {
  border-radius: 10rpx;
  background: #FFFFFF;
  color: #1A1A1A;
}

.owner-status {
  background: #E8F5EE;
  color: #1B7A56;
}

.progress-number {
  font-size: 68rpx;
}

.stage-panel,
.owner-metric {
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 12rpx;
}

.hero-progress {
  height: 10rpx;
}

.subscribe-banner {
  border: 1rpx solid #E8ECF0;
  border-radius: 12rpx;
  background: #FFFFFF;
  box-shadow: none;
}

.subscribe-icon {
  background: #E8F5EE;
  color: #1B7A56;
}

.subscribe-title {
  color: #1A1A1A;
}

.subscribe-desc,
.render-remark,
.log-content + .muted,
.plan-text {
  color: #5C5C5C;
}

.render-image-wrap,
.photo-tile,
.inline-photo {
  border-radius: 12rpx;
  background: #E8ECF0;
}

.render-confirmed,
.photo-caption {
  background: rgba(20, 118, 87, 0.9);
}

.render-space {
  border-radius: 999rpx;
  background: #F3F4F6;
  color: #1B7A56;
}

.render-confirm-btn {
  height: 78rpx;
  line-height: 78rpx;
}

.timeline {
  border-left-color: #1B7A56;
}

.timeline-dot {
  border-color: #FAFBFC;
  background: #1B7A56;
}

.log-content {
  color: #1A1A1A;
}

.timeline-toggle {
  border: 1rpx solid #E8ECF0;
  border-radius: 12rpx;
  background: #FFFFFF;
  box-shadow: none;
}

.toggle-text {
  color: #1B7A56;
}

.arrow-down {
  border-top-color: #1B7A56;
}

.arrow-up {
  border-bottom-color: #1B7A56;
}

/* UI 1.2 · 对齐 figma-import/pages/14-owner-home.html */
.owner-page {
  min-height: 100vh;
  padding: 32rpx 32rpx calc(148rpx + env(safe-area-inset-bottom));
  background: #FAFBFC;
  box-sizing: border-box;
}

.owner-header-card,
.section-lux-white,
.gate-card,
.subscribe-banner,
.render-card,
.timeline-item,
.owner-loading,
.bind-panel {
  border: none;
  border-radius: 40rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.02);
}

.owner-header-card {
  padding: 40rpx;
  margin-bottom: 32rpx;
}

.project-identity {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
  margin-bottom: 24rpx;
}

.owner-header-name {
  min-width: 0;
  flex: 1;
  color: #111827;
  font-size: 36rpx;
  line-height: 1.25;
  font-weight: 800;
}

.brand-badge-pill {
  flex-shrink: 0;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #E8F5EE;
  color: #1B7A56;
  font-size: 22rpx;
  font-weight: 700;
}

.crew-box {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: #FAFBFC;
}

.crew-txt {
  min-width: 0;
  flex: 1;
  color: #6B7280;
  font-size: 26rpx;
  font-weight: 700;
}

.phone-ring-btn {
  flex-shrink: 0;
  padding: 12rpx 22rpx;
  border-radius: 16rpx;
  background: #1B7A56;
  color: #FFFFFF;
  font-size: 22rpx;
  font-weight: 800;
}

.owner-hero,
.bind-hero {
  margin: 0 0 32rpx;
  padding: 48rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #1B7A56 0%, #2AA876 100%);
}

.owner-hero-top {
  display: none;
}

.progress-hero-row {
  margin-top: 0;
}

.progress-number {
  font-size: 72rpx;
}

.stage-panel {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 150rpx;
  height: 150rpx;
  min-height: 150rpx;
  padding: 18rpx;
  border: 10rpx solid rgba(255, 255, 255, 0.28);
  border-left-color: #FFFFFF;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
  text-align: center;
}

.stage-label {
  display: none;
}

.stage-name {
  margin-top: 0;
  font-size: 22rpx;
  font-weight: 800;
}

.hero-progress,
.owner-metrics {
  display: none;
}

.section-lux-white {
  padding: 36rpx;
  margin-bottom: 32rpx;
}

.section-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.section-title-text {
  color: #111827;
  font-size: 32rpx;
  font-weight: 800;
}

.bulletin-bubble {
  padding: 24rpx;
  border-radius: 24rpx;
  background: #FAFBFC;
}

/* UI 3.0 · 动态进度圆环 */
.stage-panel {
  padding: 0;
  border: none;
  background: transparent;
}

.stage-ring {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 150rpx;
  height: 150rpx;
  border-radius: 50%;
}

.stage-ring-inner {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 126rpx;
  height: 126rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.16);
}

.stage-ring .stage-name {
  display: -webkit-box;
  max-width: 94rpx;
  margin: 0;
  overflow: hidden;
  color: #FFFFFF;
  font-size: 22rpx;
  line-height: 1.25;
  font-weight: 800;
  text-align: center;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.bulletin-p {
  color: #6B7280;
  font-size: 26rpx;
  line-height: 1.55;
}

.owner-bulletin-photos {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
  margin-top: 24rpx;
}

.bulletin-photo {
  width: 100%;
  height: 240rpx;
  border-radius: 24rpx;
  background: #E5E7EB;
}

.dual-gateways-row {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.gate-card {
  min-height: 160rpx;
  padding: 28rpx 18rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.gate-icon {
  margin-bottom: 12rpx;
  font-size: 48rpx;
  line-height: 1;
}

.gate-title {
  color: #111827;
  font-size: 26rpx;
  line-height: 1.35;
  font-weight: 800;
}

.render-section,
.photo-section,
.timeline-section {
  padding: 36rpx;
  border-radius: 40rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.02);
}

.photo-wall,
.inline-photos {
  grid-template-columns: repeat(2, 1fr);
}

.photo-tile,
.inline-photo,
.render-image-wrap {
  border-radius: 24rpx;
  background: #E5E7EB;
}

.timeline {
  border-left: none;
}

.timeline-item {
  position: relative;
  margin: 0;
  padding: 0 0 42rpx 38rpx;
  border-radius: 0;
  background: transparent;
  box-shadow: none;
}

.timeline-item::before {
  content: "";
  position: absolute;
  left: 9rpx;
  top: 22rpx;
  bottom: -10rpx;
  width: 4rpx;
  background: #E5E7EB;
}

.timeline-item:first-child::before {
  background: #1B7A56;
}

.timeline-dot {
  left: 0;
  top: 8rpx;
  width: 18rpx;
  height: 18rpx;
  border: 4rpx solid #E8F5EE;
  background: #1B7A56;
  box-shadow: 0 0 0 2rpx #E8F5EE;
}

.bind-state {
  padding-top: 16rpx;
}

.bind-panel {
  margin-top: -12rpx;
}

.bind-flow-row {
  display: flex;
  align-items: center;
  margin: 28rpx 0 24rpx;
}

.bind-flow-step {
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: #FAFBFC;
  color: #6B7280;
  font-size: 22rpx;
  line-height: 1.2;
  font-weight: 800;
}

.bind-flow-step.active {
  background: #E8F5EE;
  color: #1B7A56;
}

.bind-flow-line {
  flex: 1;
  height: 2rpx;
  background: #E5E7EB;
}

.gate-card:active {
  opacity: 0.86;
}

/* UI 4.0 · A+B 融合：业主端照片可信首屏 */
.owner-page {
  padding: 28rpx 28rpx calc(148rpx + env(safe-area-inset-bottom));
}

.owner-header-card {
  margin-bottom: 24rpx;
  padding: 32rpx;
  border-radius: 32rpx;
}

.owner-hero,
.bind-hero {
  position: relative;
  overflow: hidden;
  margin-bottom: 24rpx;
  padding: 36rpx 32rpx 32rpx;
  border-radius: 32rpx;
  background: linear-gradient(150deg, #0D4D36 0%, #1B7A56 54%, #2AA876 100%);
  box-shadow: 0 18rpx 48rpx rgba(13, 77, 54, 0.16);
}

.owner-hero::after {
  content: "";
  position: absolute;
  top: -96rpx;
  right: -96rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 50%;
  background: rgba(255, 184, 0, 0.12);
  pointer-events: none;
}

.progress-hero-row,
.hero-progress,
.owner-metrics,
.owner-hero-photo-strip {
  position: relative;
  z-index: 2;
}

.progress-number {
  font-size: 76rpx;
  letter-spacing: 0;
}

.stage-ring {
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.18);
  transition: background 0.7s cubic-bezier(0.16, 1, 0.3, 1);
}

.stage-ring-inner {
  background: linear-gradient(150deg, rgba(13, 77, 54, 0.96) 0%, rgba(27, 122, 86, 0.92) 100%);
  box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.16);
}

.hero-progress {
  display: block;
  height: 10rpx;
  margin-top: 28rpx;
  background: rgba(255, 255, 255, 0.22);
}

.hero-progress-bar {
  background: #FFFFFF;
  transition: width 0.72s cubic-bezier(0.16, 1, 0.3, 1);
}

.owner-hero-photo-strip {
  display: grid;
  grid-template-columns: 1.28fr 1fr 1fr;
  gap: 12rpx;
  margin-top: 24rpx;
}

.hero-photo-chip {
  position: relative;
  height: 136rpx;
  overflow: hidden;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, 0.16);
}

.hero-photo-chip:active,
.photo-tile:active,
.inline-photo:active,
.bulletin-photo:active {
  opacity: 0.9;
  transform: scale(0.985);
}

.hero-photo {
  width: 100%;
  height: 100%;
}

.hero-photo-mask {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 72rpx;
  background: linear-gradient(to bottom, rgba(13, 77, 54, 0), rgba(13, 77, 54, 0.72));
}

.hero-photo-label {
  position: absolute;
  left: 12rpx;
  right: 12rpx;
  bottom: 10rpx;
  overflow: hidden;
  color: #FFFFFF;
  font-size: 20rpx;
  line-height: 1.2;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.owner-metrics {
  display: grid;
  margin-top: 18rpx;
}

.owner-metric {
  min-height: 92rpx;
  padding: 16rpx 14rpx;
  border-radius: 20rpx;
}

.section-lux-white,
.render-section,
.photo-section,
.timeline-section,
.gate-card,
.subscribe-banner,
.render-card,
.timeline-item,
.bind-panel {
  border-radius: 32rpx;
}

.section-subtitle {
  margin-top: 6rpx;
  color: #6B7280;
  font-size: 22rpx;
  line-height: 1.3;
  font-weight: 600;
}

.bulletin-bubble {
  border-radius: 20rpx;
  background: #FAFBFC;
}

.photo-wall {
  gap: 14rpx;
}

.photo-tile {
  height: 260rpx;
  border-radius: 20rpx;
  transition: opacity 0.15s ease, transform 0.15s ease;
}

.photo-caption {
  background: rgba(13, 77, 54, 0.78);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
}

.timeline-toggle {
  transition: opacity 0.15s ease, transform 0.15s ease;
}

.timeline-toggle:active {
  opacity: 0.9;
  transform: scale(0.985);
}

