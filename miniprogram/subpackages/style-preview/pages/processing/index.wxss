page { background: #304238; }
.processing-page { min-height: 100vh; padding: 64rpx 42rpx calc(60rpx + env(safe-area-inset-bottom)); box-sizing: border-box; color: #FFFFFF; }
.top-note { display: inline-block; padding-bottom: 10rpx; border-bottom: 2rpx solid #CFAE7B; color: #E9D5AF; font-size: 22rpx; font-weight: 700; }
.processing-title { margin-top: 34rpx; font-size: 48rpx; line-height: 1.28; font-weight: 800; }
.processing-copy { margin-top: 18rpx; color: rgba(255,255,255,.72); font-size: 25rpx; line-height: 1.6; }
.image-pair { display: flex; align-items: center; justify-content: center; margin: 54rpx 0 48rpx; }
.image-pair image { width: 238rpx; height: 172rpx; border: 4rpx solid rgba(255,255,255,.22); }
.pair-mark { z-index: 1; width: 48rpx; height: 48rpx; margin: 0 -18rpx; border: 2rpx solid #CFAE7B; border-radius: 50%; background: #304238; color: #E9D5AF; text-align: center; font-size: 38rpx; line-height: 44rpx; }
.step-list { padding: 8rpx 0; }
.step { position: relative; display: flex; align-items: center; min-height: 116rpx; opacity: .42; }
.step::before { position: absolute; top: 74rpx; left: 20rpx; width: 2rpx; height: 50rpx; background: rgba(255,255,255,.22); content: ''; }
.step:last-child::before { display: none; }
.step.active { opacity: 1; }
.step-state { flex: 0 0 auto; width: 40rpx; height: 40rpx; margin-right: 24rpx; border: 2rpx solid #E9D5AF; border-radius: 50%; color: #E9D5AF; text-align: center; font-size: 22rpx; font-weight: 800; line-height: 40rpx; }
.step.finished .step-state { border-color: #CFAE7B; background: #CFAE7B; color: #304238; }
.step-content { flex: 1; }
.step-title { font-size: 29rpx; font-weight: 800; }
.step-copy { margin-top: 6rpx; color: rgba(255,255,255,.64); font-size: 22rpx; line-height: 1.45; }
.pulse { width: 16rpx; height: 16rpx; margin-right: 10rpx; border-radius: 50%; background: #CFAE7B; box-shadow: 0 0 0 12rpx rgba(207,174,123,.16); animation: breathe 1.2s ease-in-out infinite; }
.failure-panel { margin-top: 24rpx; padding: 28rpx; border: 1rpx solid rgba(233,213,175,.55); background: rgba(0,0,0,.12); }
.failure-title { color: #E9D5AF; font-size: 28rpx; font-weight: 800; }
.failure-copy { margin-top: 10rpx; color: rgba(255,255,255,.76); font-size: 23rpx; line-height: 1.5; }
.retry-action { height: 76rpx; margin-top: 22rpx; border: 1rpx solid #E9D5AF; border-radius: 0; background: #E9D5AF; color: #304238; font-size: 25rpx; line-height: 76rpx; font-weight: 800; }
.retry-action::after { border: none; }
.boundary { margin-top: 48rpx; padding-top: 24rpx; border-top: 1rpx solid rgba(255,255,255,.2); color: rgba(255,255,255,.56); font-size: 21rpx; line-height: 1.5; }
@keyframes breathe { 50% { opacity: .35; transform: scale(.8); } }
