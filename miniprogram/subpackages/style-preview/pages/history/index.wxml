<view class="history-page">
  <view class="history-head">
    <view class="head-kicker">风格预览记录</view>
    <view class="head-title">{{customerName || '当前客户'}}的<br />风格沟通记录</view>
    <view class="head-copy">仅供内部售前风格沟通使用，不作为施工依据。</view>
  </view>

  <view class="record-count">共 {{sessions.length}} 条预览记录</view>
  <view class="record-list">
    <view wx:for="{{sessions}}" wx:key="id" class="record-card" data-id="{{item.id}}" bindtap="viewResult">
      <image src="{{item.previewImage}}" mode="aspectFill"></image>
      <view class="record-main">
        <view class="record-top"><text>{{item.roomType}}</text><text class="status {{item.status}}">{{item.statusText}}</text></view>
        <view class="record-style">{{item.styleIntent.styleName}}</view>
        <view class="record-meta">{{item.createdAtText}}</view>
      </view>
      <view class="record-arrow">›</view>
    </view>
  </view>

  <button class="new-button" bindtap="createNew">再创建一张预览</button>
</view>
