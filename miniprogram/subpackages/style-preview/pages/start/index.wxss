page { background: #F6F2EA; }
.preview-page { min-height: 100vh; padding: 30rpx 28rpx calc(56rpx + env(safe-area-inset-bottom)); color: #222222; box-sizing: border-box; }
.hero { padding: 34rpx 32rpx; border-left: 10rpx solid #CFAE7B; background: #304238; color: #FFFFFF; }
.hero-kicker { color: #E9D5AF; font-size: 22rpx; font-weight: 700; }
.hero-title { margin-top: 14rpx; font-size: 42rpx; line-height: 1.28; font-weight: 800; }
.hero-copy { margin-top: 12rpx; color: rgba(255,255,255,.76); font-size: 24rpx; line-height: 1.55; }
.progress-strip { display: flex; align-items: flex-start; margin: 30rpx 0 36rpx; }
.progress-step { width: 128rpx; color: #8B887E; text-align: center; font-size: 20rpx; }
.progress-step text { display: block; width: 38rpx; height: 38rpx; margin: 0 auto 10rpx; border: 2rpx solid #B9B1A2; border-radius: 50%; line-height: 38rpx; }
.progress-step.active { color: #304238; font-weight: 800; }
.progress-step.active text { border-color: #304238; background: #304238; color: #FFFFFF; }
.progress-line { flex: 1; height: 2rpx; margin-top: 19rpx; background: #D9D1C3; }
.section { margin-top: 30rpx; }
.section-label { margin-bottom: 14rpx; color: #304238; font-size: 26rpx; font-weight: 800; }
.section-label text { margin-left: 8rpx; color: #8B887E; font-size: 20rpx; font-weight: 400; }
.field-picker, .note-input { box-sizing: border-box; background: #FFFFFF; border: 1rpx solid #E4DBCC; }
.field-picker { display: flex; align-items: center; justify-content: space-between; min-height: 108rpx; padding: 18rpx 24rpx; }
.field-value { font-size: 28rpx; font-weight: 700; }
.field-helper { margin-top: 4rpx; color: #817A6F; font-size: 21rpx; }
.field-arrow { color: #CFAE7B; font-size: 44rpx; }
.image-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; }
.image-slot { overflow: hidden; background: #FFFFFF; border: 1rpx solid #E4DBCC; }
.chosen-image, .image-empty { display: block; width: 100%; height: 220rpx; }
.image-empty { padding: 32rpx 16rpx; background: #EEE8DC; color: #304238; text-align: center; box-sizing: border-box; font-size: 23rpx; font-weight: 800; }
.image-empty text { display: block; margin-top: 8rpx; color: #817A6F; font-size: 19rpx; line-height: 1.45; font-weight: 400; }
.image-icon { width: 48rpx; height: 48rpx; margin: 0 auto 16rpx; background: #D9C49B; line-height: 48rpx; color: #304238; }
.image-caption { padding: 14rpx 16rpx 0; font-size: 22rpx; font-weight: 800; }
.image-actions { display: flex; gap: 18rpx; padding: 10rpx 16rpx 16rpx; color: #8B632B; font-size: 21rpx; }
.note-input { width: 100%; min-height: 150rpx; padding: 20rpx 22rpx; color: #222222; font-size: 26rpx; line-height: 1.5; }
.create-button { height: 100rpx; margin-top: 42rpx; border-radius: 0; background: #304238; color: #FFFFFF; font-size: 30rpx; font-weight: 800; line-height: 100rpx; }
.create-button::after { border: none; }
.history-link { margin-top: 26rpx; color: #6D572F; text-align: center; font-size: 24rpx; }
.history-link text { color: #CFAE7B; font-size: 32rpx; vertical-align: -2rpx; }
