<view class="result-page" wx:if="{{session}}">
  <view class="result-head">
    <view class="eyebrow">{{session.customerName}} · {{session.roomType}}</view>
    <view class="result-title">一张图，先把<br />家的感觉对齐</view>
    <view class="result-copy">AI 风格预览，原始空间结构与主视角优先。</view>
  </view>

  <view class="image-label">同视角结构优先预览</view>
  <view class="preview-frame" data-src="{{session.previewImage}}" bindtap="previewImage">
    <image src="{{session.previewImage}}" mode="aspectFill"></image>
    <view class="preview-badge">AI生成图片</view>
  </view>

  <view class="source-row">
    <view class="source-card" data-src="{{session.sourceImage}}" bindtap="previewImage"><image src="{{session.sourceImage}}" mode="aspectFill"></image><view>原始毛坯图</view></view>
    <view class="source-card" data-src="{{session.referenceImage}}" bindtap="previewImage"><image src="{{session.referenceImage}}" mode="aspectFill"></image><view>参考风格图</view></view>
  </view>

  <view class="intent-card">
    <view class="intent-kicker">STYLE INTENT</view>
    <view class="intent-title">{{session.styleIntent.styleName}}</view>
    <view class="tag-row"><text wx:for="{{session.styleIntent.keywords}}" wx:key="*this">{{item}}</text></view>
    <view class="intent-line"><view>色彩方向</view><text>{{session.styleIntent.colorPaletteText}}</text></view>
    <view class="intent-line"><view>材质方向</view><text>{{session.styleIntent.materialsText}}</text></view>
    <view class="intent-line vertical"><view>空间感受</view><text>{{session.styleIntent.atmosphere}}</text></view>
    <view class="intent-line vertical"><view>结构保留</view><text>{{session.styleIntent.preservationNotes}}</text></view>
  </view>

  <view class="boundary-card"><view class="boundary-title">沟通边界</view><view>{{session.styleIntent.designBoundary}}</view></view>
  <view class="formal-notice">本效果图由人工智能生成，仅用于装修风格沟通。空间结构、材料、尺寸与施工方案请以设计师现场复核为准。</view>

  <view class="feedback-section">
    <view class="feedback-title">客户反馈</view>
    <textarea value="{{feedback}}" maxlength="160" placeholder="例如：喜欢这种暖一点的感觉，但柜子希望再轻一点。" bindinput="onFeedbackInput"></textarea>
    <button class="feedback-save" bindtap="saveFeedback">{{feedbackSaved ? '已保存反馈' : '保存反馈'}}</button>
  </view>

  <button class="primary-action" bindtap="regenerate">重新生成一版</button>
  <view class="result-links"><text bindtap="goHistory">查看历史记录</text><text bindtap="backToCustomer">返回客户详情</text></view>
</view>
