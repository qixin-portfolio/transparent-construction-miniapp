/* ================================================================
   晟景透明工地小程序 · 全局设计系统 v2.0
   现代装修服务品牌 + 轻量 SaaS 管理 + Apple 风格卡片
   ================================================================ */

/* ---------- 页面基底 ---------- */
page {
  min-height: 100vh;
  background: #F7FAF8;
  color: #111827;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
}

/* ---------- 通用页面容器 ---------- */
.page {
  padding: 32rpx;
  box-sizing: border-box;
}

.section {
  margin-bottom: 28rpx;
}

/* ---------- 标题层级 ---------- */
.title {
  font-size: 44rpx;
  line-height: 1.3;
  font-weight: 600;
  color: #111827;
  letter-spacing: 0;
}

.sub-title {
  font-size: 32rpx;
  line-height: 1.35;
  font-weight: 600;
  color: #111827;
}

.card-title {
  font-size: 32rpx;
  line-height: 1.35;
  font-weight: 600;
  color: #111827;
}

/* ---------- 文字辅助 ---------- */
.muted {
  color: #6B7280;
  font-size: 24rpx;
  line-height: 1.5;
}

.muted-sm {
  color: #9CA3AF;
  font-size: 22rpx;
  line-height: 1.5;
}

.danger {
  color: #D9534F;
}

/* ---------- 卡片系统 ---------- */
.card {
  background: #FFFFFF;
  border: none;
  border-radius: 32rpx;
  padding: 32rpx;
  box-sizing: border-box;
  box-shadow: 0 4rpx 24rpx rgba(17, 24, 39, 0.04);
}

.card-lg {
  border-radius: 40rpx;
}

.card:active {
  opacity: 0.92;
}

/* ---------- 行布局 ---------- */
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

/* ---------- 列表 ---------- */
.list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* ---------- 状态标签 Pill ---------- */
.tag {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #EAF7F1;
  color: #0F6A4A;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 44rpx;
  white-space: nowrap;
}

.tag-success {
  background: #EAF7F1;
  color: #16A34A;
}

.tag-warning {
  background: #FEF3C7;
  color: #B45309;
}

.tag-danger {
  background: #FEE2E2;
  color: #D9534F;
}

.tag-info {
  background: #F3F4F6;
  color: #6B7280;
}

/* ---------- 通用状态标签（时间线等） ---------- */
.status-tag {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  line-height: 44rpx;
  font-weight: 600;
  white-space: nowrap;
}

.status-tag.pending {
  background: #FEF3C7;
  color: #B45309;
}

.status-tag.approved {
  background: #EAF7F1;
  color: #16A34A;
}

.status-tag.rejected {
  background: #FEE2E2;
  color: #D9534F;
}

.status-tag.completed {
  background: #F3F4F6;
  color: #6B7280;
}

/* ---------- 按钮系统 ---------- */
.button-primary {
  height: 100rpx;
  line-height: 100rpx;
  border-radius: 28rpx;
  background: #0F6A4A;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  margin: 0;
  padding: 0 32rpx;
  box-shadow: 0 8rpx 24rpx rgba(15, 106, 74, 0.24);
  transition: opacity 0.15s;
}

.button-primary::after {
  border: none;
}

.button-primary[disabled] {
  background: #C8DBD2;
  color: rgba(255, 255, 255, 0.7);
  box-shadow: none;
}

.button-primary:active:not([disabled]) {
  opacity: 0.88;
}

.button-secondary {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 28rpx;
  background: #EAF7F1;
  color: #0F6A4A;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  margin: 0;
  padding: 0 32rpx;
}

.button-secondary::after {
  border: none;
}

.button-secondary[disabled] {
  opacity: 0.5;
}

.button-secondary:active:not([disabled]) {
  background: #D5EDE2;
}

.button-share {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 28rpx;
  background: #111827;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  margin: 0;
  padding: 0 32rpx;
}

.button-share::after {
  border: none;
}

.button-share[disabled] {
  background: #D1D5DB;
  color: rgba(255, 255, 255, 0.7);
}

.button-danger {
  background: #FEE2E2;
  color: #D9534F;
  border: none;
  border-radius: 28rpx;
  font-size: 28rpx;
  font-weight: 600;
  margin: 0;
}

.button-danger::after {
  border: none;
}

.button-danger:active {
  background: #FECACA;
}

.small-button {
  width: 144rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 24rpx;
  background: #0F6A4A;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  margin: 0;
}

.small-button::after {
  border: none;
}

.small-button:active {
  opacity: 0.88;
}

.text-action {
  flex-shrink: 0;
  height: 56rpx;
  margin: 0;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #EAF7F1;
  color: #0F6A4A;
  font-size: 24rpx;
  line-height: 56rpx;
  font-weight: 600;
  border: none;
}

.text-action::after {
  border: none;
}

/* ---------- 表单元素 ---------- */
.input,
.textarea,
.picker {
  width: 100%;
  min-height: 96rpx;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  border: 2rpx solid #E5E7EB;
  background: #F9FAFB;
  font-size: 28rpx;
  color: #111827;
  transition: border-color 0.15s, background 0.15s;
}

.input:focus,
.textarea:focus,
.picker:focus {
  border-color: #0F6A4A;
  background: #FFFFFF;
}

.textarea {
  min-height: 200rpx;
  line-height: 1.6;
}

.picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* ---------- 进度条 ---------- */
.progress {
  height: 16rpx;
  margin: 22rpx 0 12rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #E5E7EB;
}

.progress-bar {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #0F6A4A 0%, #1F8B61 100%);
}

/* ---------- 空状态 ---------- */
.empty {
  padding: 80rpx 32rpx;
  text-align: center;
  color: #9CA3AF;
  font-size: 28rpx;
  line-height: 1.6;
}

.empty-title {
  color: #6B7280;
  font-size: 32rpx;
  font-weight: 600;
  margin-bottom: 12rpx;
}

/* ---------- 筛选标签条 ---------- */
.filter-tab {
  flex-shrink: 0;
  min-height: 64rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #F3F4F6;
  color: #6B7280;
  font-size: 26rpx;
  line-height: 64rpx;
  white-space: nowrap;
  transition: all 0.15s;
}

.filter-tab-active {
  background: #0F6A4A;
  color: #FFFFFF;
  font-weight: 600;
}

/* ---------- 章节标题行 ---------- */
.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18rpx;
  margin: 8rpx 0 20rpx;
}

/* ---------- picker 箭头 ---------- */
.picker-arrow {
  color: #9CA3AF;
  font-size: 24rpx;
  flex-shrink: 0;
}

/* ---------- 图片圆角通用 ---------- */
photo,
image {
  border-radius: 28rpx;
}

/* ---------- 安全区底部留白 ---------- */
.safe-bottom {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}

