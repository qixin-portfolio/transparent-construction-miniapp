/* ================================================================
   晟景透明工地 · 全局设计系统 UI 3.0
   Forest + Amber · 现代可信赖工具感
   设计旋钮：VARIANCE 7 / MOTION 4 / DENSITY 3
   ================================================================ */

/* ---------- 页面基底 ---------- */
page {
  min-height: 100vh;
  background: #FAFBFC;
  color: #1A1A1A;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  -webkit-font-smoothing: antialiased;
  letter-spacing: 0;
}

/* ---------- 通用页面容器 ---------- */
.page {
  padding: 32rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.section {
  margin-bottom: 32rpx;
}

/* ---------- 标题层级 ---------- */
.title,
.page-title {
  font-size: 44rpx;
  line-height: 1.25;
  font-weight: 800;
  color: #1A1A1A;
  letter-spacing: -0.5rpx;
}

.sub-title,
.card-title,
.section-title,
.form-section-title {
  font-size: 32rpx;
  line-height: 1.35;
  font-weight: 700;
  color: #1A1A1A;
  letter-spacing: 0;
}

/* ---------- 文字辅助 ---------- */
.muted {
  color: #5C5C5C;
  font-size: 24rpx;
  line-height: 1.5;
}

.muted-sm {
  color: #9CA3AF;
  font-size: 22rpx;
  line-height: 1.5;
}

.danger {
  color: #EF4444;
}

/* ---------- 卡片系统 · 统一圆角 + 双层阴影 ---------- */
.card {
  background: #FFFFFF;
  border: none;
  border-radius: 32rpx;
  padding: 32rpx;
  box-sizing: border-box;
  box-shadow:
    0 2rpx 8rpx rgba(0, 0, 0, 0.03),
    0 8rpx 32rpx rgba(0, 0, 0, 0.02);
}

.card-lg {
  border-radius: 40rpx;
}

.card:active {
  opacity: 0.94;
  transform: scale(0.99);
}

/* ---------- 行布局 ---------- */
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

/* ---------- 列表 ---------- */
.list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

/* ---------- 状态标签 Pill · UI 3.0 ---------- */
.tag,
.status-tag {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 44rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

/* 默认 / 品牌色 */
.tag,
.status-tag.approved {
  background: #E8F5EE;
  color: #1B7A56;
}

.tag-success {
  background: #DCFCE7;
  color: #15803D;
}

.tag-warning,
.status-tag.pending {
  background: #FEF3C7;
  color: #B45309;
}

.tag-danger,
.status-tag.rejected {
  background: #FEE2E2;
  color: #DC2626;
}

.tag-info,
.status-tag.completed {
  background: #F3F4F6;
  color: #6B7280;
}

/* 强调色标签（琥珀黄） */
.tag-accent {
  background: #FFF8E1;
  color: #B45309;
}

/* ---------- 按钮系统 · UI 3.0 ---------- */
/* Primary：绿色渐变 + 光晕阴影 */
.button-primary,
.small-button {
  height: 96rpx;
  line-height: 96rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #1B7A56 0%, #2AA876 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
  border: none;
  margin: 0;
  padding: 0 32rpx;
  box-shadow:
    0 4rpx 12rpx rgba(27, 122, 86, 0.25),
    0 8rpx 24rpx rgba(27, 122, 86, 0.12);
  transition: opacity 0.15s, transform 0.15s;
}

.button-primary::after,
.small-button::after {
  border: none;
}

.button-primary[disabled],
.small-button[disabled] {
  background: #C8DBD2;
  color: rgba(255, 255, 255, 0.7);
  box-shadow: none;
}

.button-primary:active:not([disabled]),
.small-button:active:not([disabled]) {
  opacity: 0.9;
  transform: scale(0.98);
}

/* Secondary：浅绿底 + 绿字 */
.button-secondary,
.text-action {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 28rpx;
  background: #E8F5EE;
  color: #1B7A56;
  font-size: 28rpx;
  font-weight: 700;
  border: none;
  margin: 0;
  padding: 0 32rpx;
  box-shadow: none;
}

.button-secondary::after,
.text-action::after {
  border: none;
}

.button-secondary[disabled] {
  opacity: 0.5;
}

.button-secondary:active:not([disabled]) {
  background: #D5EDE2;
}

/* Share：深色 */
.button-share {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 28rpx;
  background: #1A1A1A;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 700;
  border: none;
  margin: 0;
  padding: 0 32rpx;
}

.button-share::after {
  border: none;
}

.button-share[disabled] {
  background: #D1D5DB;
  color: rgba(255, 255, 255, 0.7);
}

/* Danger */
.button-danger {
  background: #FEE2E2;
  color: #EF4444;
  border: none;
  border-radius: 28rpx;
  font-size: 28rpx;
  font-weight: 700;
  margin: 0;
}

.button-danger::after {
  border: none;
}

.button-danger:active {
  background: #FECACA;
}

/* Small button */
.small-button {
  width: 144rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  padding: 0;
}

/* Text action pill */
.text-action {
  flex-shrink: 0;
  height: 56rpx;
  line-height: 56rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
}

/* ---------- 表单元素 · UI 3.0 ---------- */
.input,
.textarea,
.picker {
  width: 100%;
  min-height: 96rpx;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
  border-radius: 24rpx;
  border: 2rpx solid #E8ECF0;
  background: #FAFBFC;
  font-size: 28rpx;
  color: #1A1A1A;
  transition: border-color 0.15s, background 0.15s, box-shadow 0.15s;
}

.input:focus,
.textarea:focus,
.picker:focus {
  border-color: #1B7A56;
  background: #FFFFFF;
  box-shadow: 0 0 0 6rpx rgba(27, 122, 86, 0.08);
}

.textarea {
  min-height: 200rpx;
  line-height: 1.6;
}

.picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

/* ---------- 进度条 · 渐变填充 ---------- */
.progress,
.owner-progress,
.project-progress,
.hero-progress,
.manager-progress {
  height: 16rpx;
  margin: 22rpx 0 12rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #E8ECF0;
}

.progress-bar,
.owner-progress-bar,
.project-progress-bar {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #1B7A56 0%, #2AA876 100%);
  transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

/* ---------- 空状态 ---------- */
.empty {
  padding: 80rpx 32rpx;
  text-align: center;
  color: #9CA3AF;
  font-size: 28rpx;
  line-height: 1.6;
}

.empty-title {
  color: #5C5C5C;
  font-size: 32rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

/* ---------- 筛选标签条 ---------- */
.filter-tab {
  flex-shrink: 0;
  min-height: 64rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  background: #F3F4F6;
  color: #5C5C5C;
  font-size: 26rpx;
  line-height: 64rpx;
  white-space: nowrap;
  transition: all 0.15s;
}

.filter-tab-active {
  background: linear-gradient(135deg, #1B7A56 0%, #2AA876 100%);
  color: #FFFFFF;
  font-weight: 700;
  box-shadow: 0 4rpx 12rpx rgba(27, 122, 86, 0.2);
}

/* ---------- 章节标题行 ---------- */
.section-head,
.page-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18rpx;
  margin: 8rpx 0 20rpx;
}

/* ---------- picker 箭头 · 绿色药丸按钮 ---------- */
.picker-arrow {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 48rpx;
  padding: 0 20rpx;
  border-radius: 999rpx;
  background: #1B7A56;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 48rpx;
  white-space: nowrap;
  flex-shrink: 0;
}

/* ---------- picker 显示行 · flex 布局容纳更换按钮 ---------- */
.picker-display {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.picker-value {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

/* ---------- 图片圆角通用 ---------- */
image {
  border-radius: 24rpx;
}

.image-grid-box,
.photo-wall,
.inline-photos,
.photo-grid {
  gap: 16rpx;
}

/* ---------- 安全区底部留白 ---------- */
.safe-bottom {
  padding-bottom: calc(48rpx + env(safe-area-inset-bottom));
}
