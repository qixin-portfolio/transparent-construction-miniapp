page {
  min-height: 100vh;
  background: #f6f3ed;
  color: #24342d;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.page {
  padding: 28rpx;
  box-sizing: border-box;
}

.section {
  margin-bottom: 28rpx;
}

.card {
  background: #fffaf2;
  border: 1rpx solid #e8deca;
  border-radius: 8rpx;
  padding: 26rpx;
  box-sizing: border-box;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.title {
  font-size: 38rpx;
  line-height: 1.3;
  font-weight: 700;
  color: #1f3f34;
}

.sub-title {
  font-size: 30rpx;
  line-height: 1.35;
  font-weight: 700;
  color: #1f3f34;
}

.muted {
  color: #718076;
  font-size: 25rpx;
  line-height: 1.5;
}

.tag {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 16rpx;
  border-radius: 8rpx;
  background: #e4f1ea;
  color: #1f6f54;
  font-size: 23rpx;
}

.danger {
  color: #b2432f;
}

.button-primary {
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 8rpx;
  background: #1f6f54;
  color: #ffffff;
  font-size: 29rpx;
}

.button-secondary {
  height: 76rpx;
  line-height: 76rpx;
  border-radius: 8rpx;
  background: #efe6d5;
  color: #1f3f34;
  font-size: 27rpx;
}

.input,
.textarea,
.picker {
  width: 100%;
  min-height: 78rpx;
  padding: 18rpx;
  box-sizing: border-box;
  border-radius: 8rpx;
  border: 1rpx solid #dfd4c3;
  background: #fffdf8;
  font-size: 28rpx;
}

.textarea {
  min-height: 180rpx;
}

.list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.empty {
  padding: 54rpx 24rpx;
  text-align: center;
  color: #758177;
  font-size: 27rpx;
}
