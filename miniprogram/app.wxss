  font-size: 26rpx;
}

.textarea {
  min-height: 168rpx;
}

.input:focus,
.textarea:focus,
.picker:focus {
  border-color: #147657;
  background: #FFFFFF;
}

.progress,
.owner-progress,
.project-progress,
.hero-progress,
.manager-progress {
  background: #E4DCCB;
}

.progress-bar,
.owner-progress-bar,
.project-progress-bar {
  background: #147657;
}

.empty {
  color: #6C776F;
}

.empty-title {
  color: #173E33;
}

.filter-tab {
  min-height: 58rpx;
  padding: 0 22rpx;
  border-radius: 10rpx;
  background: #F1E7D4;
  color: #6C776F;
  font-size: 24rpx;
  line-height: 58rpx;
}

.filter-tab-active {
  background: #147657;
  color: #FFFFFF;
}

.section-head,
.page-header {
  margin-bottom: 20rpx;
}

image {
  border-radius: 12rpx;
}

