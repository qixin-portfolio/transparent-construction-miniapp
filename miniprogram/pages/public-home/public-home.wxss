page { background: #F6F2EA; }
.public-home-page { min-height: 100vh; box-sizing: border-box; padding: 72rpx 48rpx calc(64rpx + env(safe-area-inset-bottom)); color: #222222; }
.hero { position: relative; min-height: 572rpx; overflow: hidden; }
.brand-mark { color: #304238; font-size: 28rpx; font-weight: 700; }
.hero-title { margin-top: 74rpx; color: #304238; font-size: 52rpx; line-height: 1.25; font-weight: 700; }
.hero-desc { margin-top: 28rpx; color: #5D625D; font-size: 30rpx; line-height: 1.65; }
.site-illustration { position: absolute; right: -30rpx; bottom: 0; width: 470rpx; height: 252rpx; }
.site-sun { position: absolute; top: 10rpx; right: 70rpx; width: 54rpx; height: 54rpx; border-radius: 50%; background: #CFAE7B; opacity: .75; }
.site-building { position: absolute; bottom: 38rpx; background: #304238; border-radius: 4rpx 4rpx 0 0; }
.site-building-main { right: 60rpx; width: 176rpx; height: 170rpx; box-shadow: inset 0 0 0 20rpx #506258; }
.site-building-side { right: 242rpx; width: 108rpx; height: 106rpx; background: #8E9A8E; }
.site-ground { position: absolute; right: 0; bottom: 0; width: 470rpx; height: 42rpx; background: #D9C9AC; border-radius: 80% 0 0 0; }
.main-action { margin-top: 22rpx; text-align: center; }
.primary-button { height: 100rpx; line-height: 100rpx; border: 0; border-radius: 6rpx; background: #304238; color: #FFFFFF; font-size: 32rpx; font-weight: 700; }
.primary-button::after { border: 0; }
.secondary-action { display: inline-block; margin-top: 32rpx; color: #304238; font-size: 28rpx; text-decoration: underline; }
.value-list { margin-top: 94rpx; padding: 38rpx 0; border-top: 1rpx solid #D9CDBB; border-bottom: 1rpx solid #D9CDBB; }
.value-item { display: flex; align-items: center; gap: 18rpx; margin: 20rpx 0; color: #4E544E; font-size: 28rpx; }
.value-dot { display: flex; align-items: center; justify-content: center; width: 42rpx; height: 42rpx; border-radius: 50%; background: #E5D8C1; color: #304238; font-size: 22rpx; font-weight: 700; }
.service-note { margin-top: 58rpx; color: #304238; font-size: 26rpx; line-height: 1.65; text-align: center; }
.help-note { margin-top: 50rpx; color: #727772; font-size: 24rpx; line-height: 1.65; text-align: center; }
.staff-entry { margin-top: 50rpx; color: #8B8479; font-size: 24rpx; text-align: center; }
