/* ================================================================
   我的 · 账号中心
   ================================================================ */
.profile-page {
  padding: 0 32rpx 48rpx;
}

/* 用户信息大卡 */
.profile-hero {
  margin: 24rpx 0 0;
  padding: 40rpx 36rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #0F6A4A 0%, #1F8B61 100%);
  color: #FFFFFF;
}

.profile-user,
.profile-guest {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.profile-avatar {
  flex-shrink: 0;
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.2);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 40rpx;
  font-weight: 700;
  line-height: 96rpx;
  text-align: center;
}

.profile-avatar-guest {
  font-size: 44rpx;
}

.profile-user-info {
  flex: 1;
  min-width: 0;
}

.profile-user-name {
  font-size: 38rpx;
  font-weight: 600;
  line-height: 1.3;
  color: #FFFFFF;
}

.profile-user-role {
  margin-top: 6rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.78);
  line-height: 1.3;
}

.profile-user-status {
  flex-shrink: 0;
  background: rgba(255, 255, 255, 0.2) !important;
  color: #FFFFFF !important;
}

/* 分组 */
.profile-section {
  margin-top: 32rpx;
}

.profile-section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #6B7280;
  margin-bottom: 16rpx;
  padding: 0 8rpx;
}

/* 菜单 */
.profile-menu {
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 24rpx rgba(17, 24, 39, 0.04);
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 28rpx;
  border-bottom: 1rpx solid #F3F4F6;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: #F9FAFB;
}

.menu-icon {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  line-height: 1;
}

.menu-icon-site { background: #EAF7F1; }
.menu-icon-review { background: #FEF3C7; }
.menu-icon-customer { background: #DBEAFE; }
.menu-icon-staff { background: #EDE9FE; }
.menu-icon-ai { background: #FCE7F3; }
.menu-icon-owner { background: #E0F2FE; }

.menu-text {
  flex: 1;
  font-size: 30rpx;
  font-weight: 500;
  color: #111827;
  line-height: 1.3;
}

.menu-arrow {
  flex-shrink: 0;
  color: #D1D5DB;
  font-size: 40rpx;
  line-height: 1;
}

/* 登录区 */
.profile-login-area {
  margin-top: 40rpx;
  padding: 0 16rpx;
}

/* UI 1.1 · 我的 */
.profile-page {
  min-height: 100vh;
  padding: 24rpx 28rpx calc(136rpx + env(safe-area-inset-bottom));
  background: #F8F4EA;
  box-sizing: border-box;
}

.profile-hero {
  border: 1rpx solid #E9DDC8;
  border-radius: 12rpx;
  background: #FFFDF7;
  box-shadow: none;
}

.profile-avatar {
  background: #DDF1E9;
  color: #147657;
}

.profile-user-name,
.profile-section-title,
.menu-text {
  color: #173E33;
  font-weight: 800;
}

.profile-user-role {
  color: #6C776F;
}

.profile-menu {
  border: 1rpx solid #E9DDC8;
  border-radius: 12rpx;
  background: #FFFDF7;
  box-shadow: none;
}

.menu-item {
  border-bottom-color: #F1E8D8;
}

.menu-icon {
  border-radius: 10rpx;
}

.menu-icon-site,
.menu-icon-owner {
  background: #DDF1E9;
}

.menu-icon-review,
.menu-icon-staff {
  background: #F5EBD6;
}

.menu-icon-customer,
.menu-icon-ai {
  background: #E6EFEA;
}

.menu-arrow {
  color: #147657;
}

.profile-login-area {
  padding: 0;
}

/* UI 1.2 · 我的页 */
.profile-page {
  min-height: 100vh;
  padding: 32rpx 32rpx calc(148rpx + env(safe-area-inset-bottom));
  background: #F8FAF9;
}

.profile-hero,
.profile-menu {
  border: none;
  border-radius: 40rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.02);
}

.profile-avatar {
  background: #EAF7F1;
  color: #0F6A4A;
}

.profile-user-name,
.profile-section-title,
.menu-text {
  color: #111827;
  font-weight: 800;
}

.menu-item {
  border-bottom-color: #E5E7EB;
}

.menu-icon {
  border-radius: 24rpx;
}

/* 第三阶段 · 工具入口 */
.profile-workflow-card {
  margin-top: 28rpx;
  padding: 28rpx;
  border-radius: 40rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.02);
}

.profile-workflow-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.profile-workflow-title {
  color: #111827;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.3;
}

.profile-workflow-desc {
  margin-top: 8rpx;
  color: #6B7280;
  font-size: 24rpx;
  line-height: 1.45;
}

.profile-workflow-tag {
  flex-shrink: 0;
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #EAF7F1;
  color: #0F6A4A;
  font-size: 22rpx;
  font-weight: 800;
  line-height: 44rpx;
}

.profile-workflow-steps {
  display: flex;
  align-items: center;
  margin-top: 26rpx;
}

.profile-workflow-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  min-width: 96rpx;
}

.profile-workflow-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #E5E7EB;
  color: #6B7280;
  font-size: 22rpx;
  font-weight: 700;
  line-height: 44rpx;
  text-align: center;
}

.profile-workflow-step.done .profile-workflow-dot {
  background: #0F6A4A;
  color: #FFFFFF;
}

.profile-workflow-text {
  color: #6B7280;
  font-size: 22rpx;
  line-height: 1.3;
  white-space: nowrap;
}

.profile-workflow-step.done .profile-workflow-text {
  color: #0F6A4A;
  font-weight: 700;
}

.profile-workflow-line {
  flex: 1;
  height: 2rpx;
  margin: 0 6rpx;
  background: #DDE7E2;
}

.menu-copy {
  flex: 1;
  min-width: 0;
}

.menu-copy .menu-text {
  flex: none;
}

.menu-desc {
  margin-top: 6rpx;
  color: #6B7280;
  font-size: 23rpx;
  line-height: 1.35;
}
