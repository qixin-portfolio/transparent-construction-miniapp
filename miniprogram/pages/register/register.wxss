.register-page {
  min-height: 100vh;
  padding: 40rpx 32rpx calc(56rpx + env(safe-area-inset-bottom));
  background: #F7F8F4;
  box-sizing: border-box;
}

.register-head {
  padding: 20rpx 4rpx 28rpx;
}

.register-eyebrow {
  display: inline-flex;
  align-items: center;
  min-height: 44rpx;
  padding: 0 18rpx;
  border-radius: 14rpx;
  background: #E8F5EE;
  color: #1B7A56;
  font-size: 22rpx;
  line-height: 44rpx;
  font-weight: 900;
}

.register-title {
  margin-top: 24rpx;
  color: #111827;
  font-size: 44rpx;
  line-height: 1.25;
  font-weight: 900;
}

.register-desc {
  margin-top: 14rpx;
  color: #5C5C5C;
  font-size: 26rpx;
  line-height: 1.5;
}

.register-card,
.register-secondary {
  border: 1rpx solid rgba(27, 122, 86, 0.07);
  border-radius: 26rpx;
  background: #FFFFFF;
  box-shadow: 0 12rpx 34rpx rgba(31, 45, 38, 0.045);
}

.register-card {
  padding: 30rpx 28rpx;
}

.field-group + .field-group {
  margin-top: 24rpx;
}

.field-label {
  margin-bottom: 12rpx;
  color: #374151;
  font-size: 24rpx;
  line-height: 1.35;
  font-weight: 900;
}

.register-submit {
  margin-top: 34rpx;
  border-radius: 18rpx;
}

.register-secondary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 22rpx;
  padding: 24rpx 28rpx;
}

.register-secondary:active {
  opacity: 0.92;
}

.register-secondary-title {
  color: #111827;
  font-size: 27rpx;
  line-height: 1.35;
  font-weight: 900;
}

.register-secondary-desc {
  margin-top: 6rpx;
  color: #6B7280;
  font-size: 23rpx;
  line-height: 1.35;
}

.register-secondary-arrow {
  flex-shrink: 0;
  color: #1B7A56;
  font-size: 42rpx;
  line-height: 1;
  font-weight: 700;
}
