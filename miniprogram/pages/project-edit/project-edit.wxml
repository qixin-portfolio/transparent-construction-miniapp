<view class="page">
  <view class="section">
    <view class="title">新增工地</view>
    <view class="muted">第一版先支持内部创建测试工地，业主绑定后续再做成邀请码。</view>
  </view>

  <view class="section list">
    <input class="input" placeholder="工地名称，如 万硕花园 128㎡" value="{{form.name}}" data-key="name" bindinput="onInput" />
    <input class="input" placeholder="客户姓名" value="{{form.customerName}}" data-key="customerName" bindinput="onInput" />
    <input class="input" placeholder="客户 ID，可不填" value="{{form.customerId}}" data-key="customerId" bindinput="onInput" />
    <input class="input" placeholder="小区/地址" value="{{form.address}}" data-key="address" bindinput="onInput" />
    <input class="input" placeholder="业主 OpenID，可不填" value="{{form.ownerOpenid}}" data-key="ownerOpenid" bindinput="onInput" />
  </view>

  <button class="button-primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">新建工地</button>
</view>
