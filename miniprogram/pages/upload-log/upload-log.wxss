.photo-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 20rpx;
}

.photo-wrap,
.photo-add {
  width: 100%;
  height: 210rpx;
  border-radius: 8rpx;
  overflow: hidden;
}

.photo {
  width: 100%;
  height: 100%;
}

.photo-add {
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
  background: #efe6d5;
  color: #1f6f54;
  font-size: 56rpx;
}
