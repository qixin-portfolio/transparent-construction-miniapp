/* ================================================================
   工作台 · 员工端 + 业主端 · UI 3.0
   渐变 Hero + 底部消融过渡 + Bento Grid
   ================================================================ */
page {
  width: 100%;
  min-height: 100%;
  overflow-x: hidden;
  background: #1B7A56;
}

.workbench-page {
  width: 100%;
  max-width: 100vw;
  min-height: 100vh;
  padding: 0 0 calc(148rpx + env(safe-area-inset-bottom));
  background: linear-gradient(180deg, #1B7A56 0, #1B7A56 320rpx, #FAFBFC 320rpx, #FAFBFC 100%);
  box-sizing: border-box;
  overflow-x: hidden;
}

/* ================================================================
   业主端 Hero · 渐变 + 装饰光晕
   ================================================================ */
.owner-hero {
  position: relative;
  padding: 48rpx 32rpx 120rpx;
  margin: 0;
  border-radius: 0;
  background: linear-gradient(150deg, #0D4D36 0%, #1B7A56 50%, #2AA876 100%);
  color: #FFFFFF;
  overflow: hidden;
  z-index: 1;
}

/* 右上角琥珀光晕 */
.owner-hero::before {
  content: "";
  position: absolute;
  top: -40rpx;
  right: -60rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 184, 0, 0.18) 0%, transparent 70%);
  pointer-events: none;
}

/* 底部消融过渡：绿色 → 页面背景色，不硬切 */
.owner-hero::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 140rpx;
  pointer-events: none;
  z-index: 2;
  background: linear-gradient(
    to bottom,
    rgba(250, 251, 252, 0)   0%,
    rgba(250, 251, 252, 0.35) 40%,
    rgba(250, 251, 252, 0.78) 72%,
    #FAFBFC                   100%
  );
}

.owner-hero-eyebrow {
  position: relative;
  z-index: 3;
  display: inline-flex;
  align-items: center;
  font-size: 24rpx;
  line-height: 1.3;
  font-weight: 700;
  color: #FFFFFF;
  background: rgba(255, 255, 255, 0.15);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

.owner-hero-title {
  position: relative;
  z-index: 3;
  margin-top: 20rpx;
  font-size: 48rpx;
  line-height: 1.2;
  font-weight: 800;
  letter-spacing: -1rpx;
}

.owner-hero-desc {
  position: relative;
  z-index: 3;
  max-width: 560rpx;
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.82);
}

/* ================================================================
   业主项目卡 · 浮起于 Hero 之上
   ================================================================ */
.owner-project-card {
  position: relative;
  z-index: 5;
  margin: -76rpx 32rpx 24rpx;
  padding: 36rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow:
    0 4rpx 12rpx rgba(13, 77, 54, 0.08),
    0 16rpx 40rpx rgba(13, 77, 54, 0.06);
  box-sizing: border-box;
}

.owner-project-card:active {
  opacity: 0.96;
  transform: scale(0.99);
}

.owner-project-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.owner-project-info {
  min-width: 0;
  flex: 1;
}

.owner-project-name {
  color: #1A1A1A;
  font-size: 36rpx;
  line-height: 1.3;
  font-weight: 700;
  letter-spacing: -0.5rpx;
}

.owner-project-address {
  margin-top: 8rpx;
  color: #9CA3AF;
  font-size: 24rpx;
  line-height: 1.45;
}

/* 状态标签 · 业主卡 */
.owner-project-card .tag-success {
  background: #E8F5EE;
  color: #1B7A56;
}

/* ---------- 进度区 ---------- */
.owner-progress-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-top: 32rpx;
}

.owner-progress-left {
  flex: 1;
}

.owner-progress-number {
  color: #1B7A56;
  font-size: 72rpx;
  line-height: 1;
  font-weight: 800;
  letter-spacing: -2rpx;
}

.owner-progress-unit {
  font-size: 32rpx;
  font-weight: 700;
  color: #1B7A56;
}

.owner-progress-stage {
  margin-top: 10rpx;
  color: #5C5C5C;
  font-size: 26rpx;
  line-height: 1.4;
}

.owner-photo-preview {
  width: 180rpx;
  height: 130rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #E8F5EE 0%, #C7E8DC 100%);
  flex-shrink: 0;
}

.owner-photo,
.owner-photo-empty {
  width: 100%;
  height: 100%;
}

.owner-photo-empty {
  color: #1B7A56;
  font-size: 24rpx;
  line-height: 130rpx;
  text-align: center;
  opacity: 0.5;
}

/* ---------- 进度条 · 渐变填充 ---------- */
.owner-progress {
  height: 16rpx;
  margin: 28rpx 0 24rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #E8ECF0;
}

.owner-progress-bar {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #1B7A56 0%, #2AA876 100%);
  transition: width 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

/* ---------- 三栏统计 ---------- */
.owner-summary-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #F3F4F6;
}

.owner-summary-item {
  min-height: 112rpx;
  padding: 16rpx 12rpx;
  text-align: center;
}

.owner-summary-value {
  color: #1A1A1A;
  font-size: 40rpx;
  line-height: 1.15;
  font-weight: 800;
}

.owner-summary-text {
  min-height: 44rpx;
  font-size: 28rpx;
  line-height: 1.25;
  color: #1B7A56;
  font-weight: 700;
}

.owner-summary-label {
  margin-top: 8rpx;
  color: #9CA3AF;
  font-size: 22rpx;
  line-height: 1.3;
}

/* ================================================================
   业主未绑定卡
   ================================================================ */
.owner-bind-card {
  position: relative;
  z-index: 5;
  margin: -76rpx 32rpx 24rpx;
  padding: 56rpx 36rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow:
    0 4rpx 12rpx rgba(13, 77, 54, 0.08),
    0 16rpx 40rpx rgba(13, 77, 54, 0.06);
  text-align: center;
}

.completed-service-body {
  margin-top: 32rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: #F8FAF9;
}

.completed-service-title {
  color: #1B7A56;
  font-size: 32rpx;
  line-height: 1.35;
  font-weight: 800;
}

.completed-service-desc {
  margin-top: 10rpx;
  color: #5C5C5C;
  font-size: 25rpx;
  line-height: 1.5;
}

.owner-bind-icon {
  font-size: 72rpx;
  line-height: 1;
  margin-bottom: 24rpx;
}

.owner-douyin-qrcodes {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24rpx;
  margin-bottom: 28rpx;
}

.owner-douyin-qrcode {
  display: block;
  width: 240rpx;
  height: 240rpx;
  border: 1rpx solid #F3F4F6;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(13, 77, 54, 0.06);
}

.owner-bind-title {
  color: #1A1A1A;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.3;
}

.owner-bind-desc {
  margin-top: 16rpx;
  color: #5C5C5C;
  font-size: 26rpx;
  line-height: 1.5;
}

.owner-bind-action {
  margin-top: 36rpx;
}

/* ================================================================
   业主信任列表
   ================================================================ */
.owner-trust-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin: 0 32rpx 24rpx;
}

.owner-trust-item {
  display: flex;
  gap: 16rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow:
    0 2rpx 8rpx rgba(0, 0, 0, 0.03),
    0 8rpx 24rpx rgba(0, 0, 0, 0.02);
  box-sizing: border-box;
}

.trust-mark {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  border-radius: 18rpx;
  background: #E8F5EE;
  color: #1B7A56;
  font-size: 26rpx;
  line-height: 56rpx;
  font-weight: 700;
  text-align: center;
}

.trust-title {
  color: #1A1A1A;
  font-size: 28rpx;
  line-height: 1.3;
  font-weight: 700;
}

.trust-desc {
  margin-top: 8rpx;
  color: #9CA3AF;
  font-size: 22rpx;
  line-height: 1.4;
}

/* ================================================================
   员工激活入口
   ================================================================ */
.staff-activate-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 0 32rpx 24rpx;
  padding: 28rpx 32rpx;
  border: 2rpx dashed #D1D5DB;
  border-radius: 28rpx;
  background: #FFFFFF;
  transition: all 0.15s ease;
}

.staff-activate-entry:active {
  background: #FAFBFC;
  border-color: #9CA3AF;
}

.staff-activate-entry-text {
  color: #5C5C5C;
  font-size: 26rpx;
  line-height: 1.4;
  font-weight: 500;
}

.staff-activate-entry-arrow {
  color: #9CA3AF;
  font-size: 36rpx;
  line-height: 1;
}

/* ================================================================
   员工端 Hero · 渐变 + 装饰光晕 + 底部消融过渡
   ================================================================ */
.welcome-header {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 0 32rpx;
  margin-bottom: 0;
}

.user-meta {
  display: flex;
  align-items: center;
  min-width: 0;
}

.staff-avatar {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  margin-right: 24rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.18);
  border: 2rpx solid rgba(255, 255, 255, 0.3);
  color: #FFFFFF;
  font-size: 34rpx;
  font-weight: 800;
  line-height: 88rpx;
  text-align: center;
}

.text-group {
  min-width: 0;
}

.staff-name {
  color: #FFFFFF;
  font-size: 34rpx;
  line-height: 1.25;
  font-weight: 700;
}

.staff-role {
  margin-top: 4rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
  line-height: 1.35;
  font-weight: 600;
}

.date-today {
  flex-shrink: 0;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.15);
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
}

/* 员工端 Hero 容器 —— 渐变背景 + 消融过渡 */
.staff-hero-wrap {
  position: relative;
  margin-top: -2rpx;
  padding: 50rpx 0 120rpx;
  background: linear-gradient(150deg, #0D4D36 0%, #1B7A56 50%, #2AA876 100%);
  overflow: hidden;
  z-index: 1;
}

/* 右上角琥珀光晕 */
.staff-hero-wrap::before {
  content: "";
  position: absolute;
  top: -60rpx;
  right: -80rpx;
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 184, 0, 0.15) 0%, transparent 70%);
  pointer-events: none;
}

/* 底部消融过渡：绿色 → 页面背景色，不硬切 */
.staff-hero-wrap::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 180rpx;
  pointer-events: none;
  z-index: 6;
  background: linear-gradient(
    to bottom,
    rgba(250, 251, 252, 0)   0%,
    rgba(250, 251, 252, 0.30) 35%,
    rgba(250, 251, 252, 0.70) 65%,
    #FAFBFC                   100%
  );
}

/* ================================================================
   员工端 Bento Grid 统计区 · 浮起于 Hero 之上
   ================================================================ */
.overview-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  grid-template-rows: auto auto;
  gap: 20rpx;
  margin: -76rpx 32rpx 40rpx;
  position: relative;
  z-index: 5;
}

.overview-card {
  padding: 32rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow:
    0 2rpx 8rpx rgba(0, 0, 0, 0.03),
    0 8rpx 32rpx rgba(0, 0, 0, 0.02);
  box-sizing: border-box;
  text-align: left;
}

/* 施工中工地卡片 —— 品牌绿强调 */
.overview-card.highlight {
  background: linear-gradient(135deg, #1B7A56 0%, #2AA876 100%);
  color: #FFFFFF;
}

.overview-card:active {
  opacity: 0.94;
  transform: scale(0.99);
}

.overview-number {
  font-size: 64rpx;
  line-height: 1.05;
  font-weight: 800;
  color: #1A1A1A;
  letter-spacing: -1rpx;
}

.overview-card.highlight .overview-number {
  font-size: 80rpx;
  color: #FFFFFF;
}

.overview-number.highlight {
  color: #FFB800;
}

.overview-label {
  margin-top: 10rpx;
  color: #5C5C5C;
  font-size: 24rpx;
  font-weight: 500;
}

.overview-card.highlight .overview-label {
  color: rgba(255, 255, 255, 0.85);
  font-size: 26rpx;
}

/* ================================================================
   核心闭环卡片
   ================================================================ */
.workflow-card {
  margin: 0 32rpx 40rpx;
  padding: 36rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow:
    0 2rpx 8rpx rgba(0, 0, 0, 0.03),
    0 8rpx 32rpx rgba(0, 0, 0, 0.02);
}

.workflow-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.workflow-title {
  color: #1A1A1A;
  font-size: 32rpx;
  font-weight: 700;
}

.workflow-badge {
  flex-shrink: 0;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #E8F5EE;
  color: #1B7A56;
  font-size: 22rpx;
  font-weight: 700;
}

.workflow-steps {
  display: flex;
  align-items: flex-start;
}

.workflow-step {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  position: relative;
}

.step-dot {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #E8ECF0;
  color: #9CA3AF;
  font-size: 22rpx;
  line-height: 48rpx;
  font-weight: 800;
  text-align: center;
  position: relative;
  z-index: 2;
}

.step-dot.active {
  background: #1B7A56;
  color: #FFFFFF;
  box-shadow: 0 0 0 8rpx rgba(27, 122, 86, 0.12);
}

.step-dot.warning {
  background: #FFB800;
  color: #FFFFFF;
  box-shadow: 0 0 0 8rpx rgba(255, 184, 0, 0.18);
}

.workflow-line {
  position: absolute;
  top: 24rpx;
  left: 50%;
  width: 100%;
  height: 4rpx;
  background: #E8ECF0;
  z-index: 1;
}

.workflow-step:last-child .workflow-line {
  display: none;
}

.step-text {
  margin-top: 16rpx;
  color: #5C5C5C;
  font-size: 22rpx;
  line-height: 1.25;
  font-weight: 600;
  text-align: center;
}

/* ================================================================
   快捷操作网格 · 4 列
   ================================================================ */
.quick-section {
  padding: 0 32rpx;
  margin-bottom: 40rpx;
}

.quick-section .section-head {
  display: flex;
  margin-bottom: 24rpx;
}

.quick-section .sub-title {
  color: #1A1A1A;
  font-size: 36rpx;
  font-weight: 700;
}

.quick-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 20rpx;
}

.quick-card {
  min-height: 136rpx;
  padding: 24rpx 8rpx;
  border: none;
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow:
    0 2rpx 8rpx rgba(0, 0, 0, 0.03),
    0 8rpx 24rpx rgba(0, 0, 0, 0.02);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: transform 0.15s ease;
}

.quick-card:active {
  opacity: 0.92;
  transform: scale(0.96);
}

.quick-card:first-child {
  background: linear-gradient(135deg, #FFF8E1 0%, #FFECB3 100%);
  box-shadow:
    0 2rpx 8rpx rgba(255, 184, 0, 0.1),
    0 8rpx 24rpx rgba(255, 184, 0, 0.08);
}

.quick-card:first-child .quick-name {
  color: #B45309;
  font-weight: 700;
}

.quick-icon {
  display: flex;
  width: auto;
  height: auto;
  margin-bottom: 12rpx;
  border-radius: 0;
  background: transparent;
  font-size: 40rpx;
  line-height: 1;
}

.quick-name {
  color: #1A1A1A;
  font-size: 22rpx;
  line-height: 1.25;
  font-weight: 600;
  text-align: center;
}

.quick-icon-ai + .quick-name {
  color: #7C3AED;
}

/* ================================================================
   今日待办
   ================================================================ */
.todo-section {
  padding: 0 32rpx;
  margin-bottom: 40rpx;
}

.todo-section .section-head {
  display: flex;
  margin-bottom: 24rpx;
}

.todo-section .sub-title {
  color: #1A1A1A;
  font-size: 36rpx;
  font-weight: 700;
}

.todo-list {
  overflow: hidden;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow:
    0 2rpx 8rpx rgba(0, 0, 0, 0.03),
    0 8rpx 32rpx rgba(0, 0, 0, 0.02);
}

.todo-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 104rpx;
  padding: 0 32rpx;
  border-bottom: 1rpx solid #F3F4F6;
}

.todo-item:last-child {
  border-bottom: none;
}

.todo-item:active {
  background: #FAFBFC;
}

.todo-left {
  display: flex;
  align-items: center;
  min-width: 0;
  flex: 1;
  gap: 20rpx;
}

.todo-dot {
  flex-shrink: 0;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}

.dot-alert {
  background: #EF4444;
  box-shadow: 0 0 0 6rpx rgba(239, 68, 68, 0.15);
}

.dot-pending {
  background: #F59E0B;
  box-shadow: 0 0 0 6rpx rgba(245, 158, 11, 0.15);
}

.dot-create {
  background: #1B7A56;
  box-shadow: 0 0 0 6rpx rgba(27, 122, 86, 0.15);
}

.todo-text {
  color: #1A1A1A;
  font-size: 26rpx;
  line-height: 1.4;
  font-weight: 600;
}

.todo-arrow {
  flex-shrink: 0;
  margin-left: 16rpx;
  color: #9CA3AF;
  font-size: 30rpx;
}

/* ================================================================
   员工激活弹窗
   ================================================================ */
.staff-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  background: rgba(17, 24, 39, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  box-sizing: border-box;
}

.staff-dialog {
  width: 100%;
  max-width: 600rpx;
  padding: 48rpx 40rpx 36rpx;
  overflow: hidden;
  border-radius: 40rpx;
  background: #FFFFFF;
  box-sizing: border-box;
}

.staff-dialog-title {
  color: #1A1A1A;
  font-size: 36rpx;
  line-height: 1.3;
  font-weight: 700;
  text-align: center;
}

.staff-dialog-desc {
  margin-top: 16rpx;
  color: #5C5C5C;
  font-size: 26rpx;
  line-height: 1.5;
  text-align: center;
}

.staff-code-input {
  width: 100%;
  margin: 36rpx 0 32rpx;
  height: 104rpx;
  padding: 0 24rpx;
  border: 2rpx solid #E8ECF0;
  border-radius: 24rpx;
  background: #FAFBFC;
  color: #1A1A1A;
  font-size: 48rpx;
  letter-spacing: 20rpx;
  font-weight: 800;
  text-align: center;
  box-sizing: border-box;
}

.staff-code-input:focus {
  border-color: #1B7A56;
  background: #FFFFFF;
  box-shadow: 0 0 0 8rpx rgba(27, 122, 86, 0.08);
}

.staff-dialog-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  width: 100%;
  box-sizing: border-box;
}

.staff-dialog-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  height: 88rpx;
