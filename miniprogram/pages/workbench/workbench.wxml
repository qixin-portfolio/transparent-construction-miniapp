<view class="workbench-page">
  <view wx:if="{{!authReady}}" class="card empty">正在进入透明工地...</view>

  <!-- ========== 业主端：安心首页 ========== -->
  <block wx:elif="{{isOwner}}">
    <view class="owner-hero">
      <view class="owner-hero-eyebrow">晟景透明工地</view>
      <view class="owner-hero-title">我的施工进度</view>
      <view class="owner-hero-desc">只展示已审核的工地进展、现场照片和当前节点。</view>
      <view wx:if="{{user && !user.hasWechatProfile}}" class="owner-profile-tip" bindtap="goProfile">完善微信头像昵称</view>
    </view>

    <view wx:if="{{ownerProject}}" class="owner-project-card" bindtap="goOwnerProject">
      <view class="owner-project-head">
        <view class="owner-project-info">
          <view class="owner-project-name">{{ownerProject.name}}</view>
          <view class="owner-project-address">{{ownerProject.address || '晟景装饰工地'}}</view>
        </view>
        <view class="tag tag-success">{{ownerProject.status || '施工中'}}</view>
      </view>

      <view class="owner-progress-row">
        <view class="owner-progress-left">
          <view class="owner-progress-number">{{ownerProject.progress || 0}}<text class="owner-progress-unit">%</text></view>
          <view class="owner-progress-stage">{{ownerProject.currentStage || ownerStats.latestStage || '施工中'}}</view>
        </view>
        <view class="owner-photo-preview">
          <image wx:if="{{ownerLatestPhoto}}" class="owner-photo" src="{{ownerLatestPhoto}}" mode="aspectFill"></image>
          <view wx:else class="owner-photo-empty">现场</view>
        </view>
      </view>

      <view class="owner-progress">
        <view class="owner-progress-bar" style="width: {{ownerProject.progress || 0}}%;"></view>
      </view>

      <view class="owner-summary-grid">
        <view class="owner-summary-item">
          <view class="owner-summary-value">{{ownerStats.logCount}}</view>
          <view class="owner-summary-label">进度更新</view>
        </view>
        <view class="owner-summary-item">
          <view class="owner-summary-value">{{ownerStats.photoCount}}</view>
          <view class="owner-summary-label">现场照片</view>
        </view>
        <view class="owner-summary-item">
          <view class="owner-summary-value owner-summary-text">{{ownerStats.latestDateText || '待更新'}}</view>
          <view class="owner-summary-label">最近更新</view>
        </view>
      </view>
    </view>

    <view wx:elif="{{completedProject}}" class="owner-project-card" bindtap="goCompletedHome">
      <view class="owner-project-head">
        <view class="owner-project-info">
          <view class="owner-project-name">{{completedProject.name}}</view>
          <view class="owner-project-address">{{completedProject.address || '晟景装饰完工项目'}}</view>
        </view>
        <view class="tag tag-success">已完工</view>
      </view>

      <view class="completed-service-body">
        <view class="completed-service-title">完工后服务已开放</view>
        <view class="completed-service-desc">查看装修档案、电子质保卡、提交售后报修、推荐朋友装修。</view>
      </view>

      <button class="button-primary owner-bind-action">进入完工服务</button>
    </view>

    <view wx:elif="{{historicalCustomer}}" class="owner-bind-card">
      <view class="owner-bind-icon">询</view>
      <view class="owner-bind-title">欢迎继续了解晟景装饰</view>
      <view class="owner-bind-desc">已记录您的咨询信息，如需查看施工进度，请在签约后绑定专属工地。</view>
      <button class="button-primary owner-bind-action" bindtap="goProjects">查看门店与预约</button>
    </view>

    <view wx:else class="owner-bind-card">
      <view class="owner-bind-icon">🏠</view>
      <view class="owner-bind-title">还未绑定工地</view>
      <view class="owner-bind-desc">输入晟景提供的 6 位绑定码后，即可查看专属施工进度。</view>
      <button class="button-primary owner-bind-action" bindtap="goOwnerProject">绑定我的工地</button>
    </view>

    <view class="owner-trust-list">
      <view class="owner-trust-item">
        <view class="trust-mark">审</view>
        <view class="trust-body">
          <view class="trust-title">审核后展示</view>
          <view class="trust-desc">业主只看到确认过的施工内容。</view>
        </view>
      </view>
      <view class="owner-trust-item">
        <view class="trust-mark">照</view>
        <view class="trust-body">
          <view class="trust-title">现场留痕</view>
          <view class="trust-desc">关键节点照片集中沉淀。</view>
        </view>
      </view>
    </view>

    <view class="staff-activate-entry" bindtap="showStaffActivate">
      <view class="staff-activate-entry-text">我是内部员工，输入邀请码激活</view>
      <view class="staff-activate-entry-arrow">›</view>
    </view>
  </block>

  <!-- ========== 内部员工端：今日工作总览 ========== -->
  <block wx:else>
    <view class="staff-hero-wrap">
      <view class="welcome-header">
        <view class="user-meta">
          <image wx:if="{{user && user.avatarUrl}}" class="staff-avatar staff-avatar-image" src="{{user.avatarUrl}}" mode="aspectFill"></image>
          <view wx:else class="staff-avatar">{{user && user.avatarText ? user.avatarText : '晟'}}</view>
          <view class="text-group">
            <view class="staff-name">{{user && user.displayName ? user.displayName : '晟景员工'}}</view>
            <view class="staff-role">{{user && user.roleLabel ? user.roleLabel : '透明工地团队'}}</view>
          </view>
        </view>
        <view class="date-today">今日</view>
      </view>
      <view class="staff-hero-tagline-wrap">
        <view class="staff-hero-tagline">交城 28 年老品牌</view>
        <view class="staff-hero-dot"></view>
        <view class="staff-hero-tagline">每个工地都留痕</view>
      </view>
      <view wx:if="{{user && !user.hasWechatProfile}}" class="staff-profile-tip" bindtap="goProfile">完善微信头像昵称</view>
    </view>

    <block wx:if="{{isWorker}}">
      <view wx:if="{{workerProject}}" class="worker-home">
        <view class="worker-project-card">
          <view class="worker-project-top">
            <view>
              <view class="worker-eyebrow">我的绑定工地</view>
              <view class="worker-project-name">{{workerProject.name}}</view>
              <view class="worker-project-address">{{workerProject.address || '未填写地址'}}</view>
            </view>
            <view class="tag tag-success">{{workerProject.status || '施工中'}}</view>
          </view>
          <view wx:if="{{projectCount > 1}}" class="worker-project-count" bindtap="goProjects">已绑定 {{projectCount}} 个工地，点击切换</view>

          <view class="worker-progress-row">
            <view>
              <view class="worker-progress-num">{{workerProject.progress || 0}}%</view>
              <view class="worker-progress-label">{{workerProject.currentStage || '当前节点待确认'}}</view>
            </view>
            <view class="worker-progress-pill">今日到场</view>
          </view>
          <view class="worker-progress">
            <view class="worker-progress-bar" style="width: {{workerProject.progress || 0}}%;"></view>
          </view>

          <view class="worker-action-row">
            <button class="worker-action primary" bindtap="goWorkerUpload">上传日报</button>
            <button class="worker-action" bindtap="recordWorkerCheckin" loading="{{workerCheckingIn}}" disabled="{{workerCheckingIn}}">到场打卡</button>
          </view>
          <button class="worker-bind-more-action" bindtap="showWorkerProjectBind">绑定新工地</button>
        </view>

        <view class="worker-simple-grid">
          <view class="worker-simple-card" bindtap="goWorkerUpload">
            <view class="worker-simple-num">{{workerRecentLogs.length}}</view>
            <view class="worker-simple-label">最近日报</view>
          </view>
          <view class="worker-simple-card">
            <view class="worker-simple-num">{{workerCheckins.length}}</view>
            <view class="worker-simple-label">打卡记录</view>
          </view>
          <view class="worker-simple-card" bindtap="goWorkerProject">
            <view class="worker-simple-num">{{workerProject.progress || 0}}%</view>
            <view class="worker-simple-label">工地进度</view>
          </view>
        </view>

        <view class="worker-record-card">
          <view class="worker-section-head">
            <view class="sub-title">打卡记录</view>
            <view class="muted">只显示本人记录</view>
          </view>
          <view wx:if="{{workerCheckins.length}}" class="worker-record-list">
            <view wx:for="{{workerCheckins}}" wx:key="_id" class="worker-record-item">
              <view class="worker-record-dot"></view>
              <view class="worker-record-body">
                <view class="worker-record-title">{{item.title || '到场打卡'}}</view>
                <view class="worker-record-meta">{{item.dateText || '刚刚'}} · {{item.projectName || workerProject.name}}</view>
              </view>
            </view>
          </view>
          <view wx:else class="worker-empty">今天还没有打卡</view>
        </view>

        <view class="worker-record-card">
          <view class="worker-section-head">
            <view class="sub-title">日报记录</view>
            <view class="muted">提交后等待管理员审核</view>
          </view>
          <view wx:if="{{workerRecentLogs.length}}" class="worker-record-list">
            <view wx:for="{{workerRecentLogs}}" wx:key="_id" class="worker-record-item">
              <view class="worker-record-dot log"></view>
              <view class="worker-record-body">
                <view class="worker-record-title">{{item.stage || '工地日报'}} · {{item.statusText}}</view>
                <view class="worker-record-meta">{{item.dateText || '时间待同步'}} · {{item.workContent}}</view>
              </view>
            </view>
          </view>
          <view wx:else class="worker-empty">还没有日报，先上传今天现场情况</view>
        </view>
      </view>

      <view wx:else class="worker-unbound-card">
        <view class="worker-unbound-title">还未绑定工地</view>
        <view class="worker-unbound-desc">当前账号只显示已绑定工地。输入管理端发放的 6 位工地绑定码后，即可上传日报和打卡。</view>
        <button class="worker-unbound-action" bindtap="showWorkerProjectBind">输入工地绑定码</button>
      </view>
    </block>

    <block wx:else>
    <view class="overview-grid">
      <view class="overview-card highlight" bindtap="goProjects">
        <view class="overview-number">{{activeProjectCount}}</view>
        <view class="overview-label">施工中工地</view>
      </view>
      <view class="overview-card" bindtap="goReview">
        <view class="overview-number highlight">{{pendingCount}}</view>
        <view class="overview-label">待审核日报</view>
      </view>
      <view class="overview-card" bindtap="goProjects">
        <view class="overview-number">{{projectCount}}</view>
        <view class="overview-label">全部工地</view>
      </view>
      <view class="overview-card" bindtap="{{canAfterSales ? 'goAfterSalesManage' : ''}}">
        <view class="overview-number {{canAfterSales && afterSalesPendingCount ? 'highlight' : ''}}">{{afterSalesPendingCount}}</view>
        <view class="overview-label">{{canAfterSales ? '待处理售后' : '售后工单'}}</view>
      </view>
    </view>

    <view wx:if="{{isBoss}}" class="boss-dashboard-card">
      <view class="boss-dashboard-head">
        <view>
          <view class="boss-title">老板驾驶舱</view>
          <view class="boss-subtitle">今天最需要盯住的工地、客户和员工动态</view>
        </view>
        <view class="boss-tenant">{{bossDashboard.tenantName || '晟景装饰'}}</view>
      </view>
      <view class="boss-metric-grid">
        <view class="boss-metric-item alert" bindtap="goReview">
          <view class="boss-metric-num">{{pendingCount}}</view>
          <view class="boss-metric-label">待审核</view>
        </view>
        <view class="boss-metric-item" bindtap="goProjects">
          <view class="boss-metric-num">{{bossMetrics.todayUploadedCount}}</view>
          <view class="boss-metric-label">今日日报</view>
        </view>
        <view class="boss-metric-item warn" bindtap="goProjects">
          <view class="boss-metric-num">{{bossMetrics.staleProjectCount}}</view>
          <view class="boss-metric-label">超 3 天未更新</view>
        </view>
        <view class="boss-metric-item" bindtap="goCustomers">
          <view class="boss-metric-num">{{bossMetrics.conversionRate}}%</view>
          <view class="boss-metric-label">客户转化</view>
        </view>
      </view>

      <view wx:if="{{bossAlerts.length}}" class="boss-alert-list">
        <view class="boss-block-title">工地异常提醒</view>
        <view wx:for="{{bossAlerts}}" wx:key="projectId" class="boss-alert-item">
          <view class="boss-alert-dot"></view>
          <view class="boss-alert-body">
            <view class="boss-alert-name">{{item.projectName}}</view>
            <view class="boss-alert-meta">{{item.reason}} · {{item.lastUpdatedText || '暂无更新时间'}}</view>
          </view>
        </view>
      </view>

      <view wx:if="{{canAfterSales && afterSalesPendingCount}}" class="boss-alert-list" bindtap="goAfterSalesManage">
        <view class="boss-block-title">售后工单提醒</view>
        <view class="boss-alert-item">
          <view class="boss-alert-dot"></view>
          <view class="boss-alert-body">
            <view class="boss-alert-name">有 {{afterSalesPendingCount}} 个售后工单待处理</view>
            <view class="boss-alert-meta">点击查看详情并分派处理</view>
          </view>
        </view>
      </view>

      <view class="boss-split-grid">
        <view class="boss-mini-panel">
          <view class="boss-block-title">员工日报排行</view>
          <view wx:if="{{staffRank.length}}">
            <view wx:for="{{staffRank}}" wx:key="openid" class="boss-rank-row">
              <view class="boss-rank-name">{{item.name}}</view>
              <view class="boss-rank-count">{{item.count}} 条</view>
            </view>
          </view>
          <view wx:else class="boss-empty">暂无日报记录</view>
        </view>
        <view class="boss-mini-panel">
          <view class="boss-block-title">最新动态</view>
          <view wx:if="{{recentActivities.length}}">
            <view wx:for="{{recentActivities}}" wx:key="activityId" class="boss-activity-row">
              <view class="boss-activity-type">{{item.type}}</view>
              <view class="boss-activity-body">
                <view class="boss-activity-title">{{item.title}}</view>
                <view class="boss-activity-meta">{{item.meta}}</view>
              </view>
            </view>
          </view>
          <view wx:else class="boss-empty">暂无新动态</view>
        </view>
      </view>
    </view>

    <view class="workflow-card">
      <view class="workflow-title-row">
        <view class="workflow-title">施工透明核心闭环</view>
        <view class="workflow-badge">第一阶段</view>
      </view>
      <view class="workflow-steps">
        <view class="workflow-step">
          <view class="step-dot active">1</view>
          <view class="step-text">建工地</view>
        </view>
        <view class="workflow-line"></view>
        <view class="workflow-step">
          <view class="step-dot active">2</view>
          <view class="step-text">上传日报</view>
        </view>
        <view class="workflow-line"></view>
        <view class="workflow-step">
          <view class="step-dot {{pendingCount ? 'warning' : 'active'}}">3</view>
          <view class="step-text">审核发布</view>
        </view>
        <view class="workflow-line"></view>
        <view class="workflow-step">
          <view class="step-dot active">4</view>
          <view class="step-text">业主查看</view>
        </view>
      </view>
    </view>

    <view class="quick-section">
      <view class="section-head">
        <view class="sub-title">快捷日常操作</view>
      </view>
      <view class="quick-grid">
        <view wx:if="{{canUploadLog}}" class="quick-card" bindtap="goUploadEntry">
          <view class="quick-icon quick-icon-upload">📸</view>
          <view class="quick-name">上传日报</view>
        </view>
        <view wx:if="{{canCreateProject}}" class="quick-card" bindtap="goCreateProject">
          <view class="quick-icon quick-icon-create">🏗</view>
          <view class="quick-name">新增工地</view>
        </view>
        <view wx:if="{{canReview}}" class="quick-card" bindtap="goReview">
          <view class="quick-icon quick-icon-review">📝</view>
          <view class="quick-name">审核日报</view>
        </view>
        <view class="quick-card" bindtap="goProjects">
          <view class="quick-icon quick-icon-site">🏗</view>
          <view class="quick-name">查看工地</view>
        </view>
        <view wx:if="{{canViewCustomers}}" class="quick-card" bindtap="goCustomers">
          <view class="quick-icon quick-icon-customer">👤</view>
          <view class="quick-name">客户库</view>
        </view>
        <view wx:if="{{canUseAiAssistant}}" class="quick-card" bindtap="goAiAssistant">
          <view class="quick-icon quick-icon-ai">✨</view>
          <view class="quick-name">AI 助手</view>
        </view>
        <view wx:if="{{canManageStaff}}" class="quick-card" bindtap="goStaffManage">
          <view class="quick-icon quick-icon-staff">🔑</view>
          <view class="quick-name">邀请码</view>
        </view>
        <view wx:if="{{canAfterSales}}" class="quick-card" bindtap="goAfterSalesManage">
          <view class="quick-icon quick-icon-review">售</view>
          <view class="quick-name">售后工单</view>
        </view>
        <view wx:if="{{canPreviewOwner}}" class="quick-card" bindtap="goOwnerProject">
          <view class="quick-icon quick-icon-owner">📱</view>
          <view class="quick-name">业主预览</view>
        </view>
      </view>
    </view>

    <view class="todo-section">
      <view class="section-head">
        <view class="sub-title">今日核心待办</view>
      </view>
      <view class="todo-list">
        <view class="todo-item" bindtap="goReview">
          <view class="todo-left">
            <view class="todo-dot dot-alert"></view>
            <view wx:if="{{pendingCount}}" class="todo-text">有 {{pendingCount}} 条日报等待审核</view>
            <view wx:else class="todo-text">暂无待审核日报，保持巡检节奏</view>
          </view>
          <view class="todo-arrow">→</view>
        </view>
        <view class="todo-item" bindtap="goProjects">
          <view class="todo-left">
            <view class="todo-dot dot-pending"></view>
            <view class="todo-text">选择工地上传今日施工日报和现场照片</view>
          </view>
          <view class="todo-arrow">→</view>
        </view>
        <view wx:if="{{canCreateProject}}" class="todo-item" bindtap="goCreateProject">
          <view class="todo-left">
            <view class="todo-dot dot-create"></view>
            <view class="todo-text">新签约项目先建工地，再生成业主绑定码</view>
          </view>
          <view class="todo-arrow">→</view>
        </view>
        <view wx:if="{{canAfterSales && afterSalesPendingCount}}" class="todo-item" bindtap="goAfterSalesManage">
          <view class="todo-left">
            <view class="todo-dot dot-alert"></view>
            <view class="todo-text">有 {{afterSalesPendingCount}} 个售后工单待处理</view>
          </view>
          <view class="todo-arrow">→</view>
        </view>
      </view>
    </view>
    </block>
  </block>

  <!-- ========== 员工激活弹窗 ========== -->
  <view wx:if="{{staffActivateVisible}}" class="staff-mask" bindtap="hideStaffActivate">
    <view class="staff-dialog" catchtap="noop">
      <view class="staff-dialog-title">内部员工激活</view>
      <view class="staff-dialog-desc">输入管理员发放的 6 位邀请码，激活对应角色后进入工作台。</view>
      <input class="staff-code-input" type="number" maxlength="6" placeholder="请输入 6 位邀请码" value="{{staffCode}}" bindinput="onStaffCodeInput" />
      <view class="staff-dialog-actions">
        <button class="staff-dialog-btn staff-dialog-cancel" bindtap="hideStaffActivate" disabled="{{staffActivating}}">取消</button>
        <button class="staff-dialog-btn staff-dialog-confirm" bindtap="confirmStaffActivate" loading="{{staffActivating}}" disabled="{{staffActivating || staffCode.length < 6}}">激活</button>
      </view>
    </view>
  </view>

  <!-- ========== 工长绑定工地弹窗 ========== -->
  <view wx:if="{{workerProjectCodeVisible}}" class="staff-mask" bindtap="hideWorkerProjectBind">
    <view class="staff-dialog" catchtap="noop">
      <view class="staff-dialog-title">绑定工地</view>
      <view class="staff-dialog-desc">输入老板、管理员或项目经理在工地详情里生成的 6 位工长绑定码。</view>
      <input class="staff-code-input" type="number" maxlength="6" placeholder="请输入 6 位绑定码" value="{{workerProjectCode}}" bindinput="onWorkerProjectCodeInput" />
      <view class="staff-dialog-actions">
        <button class="staff-dialog-btn staff-dialog-cancel" bindtap="hideWorkerProjectBind" disabled="{{workerProjectBinding}}">取消</button>
        <button class="staff-dialog-btn staff-dialog-confirm" bindtap="confirmWorkerProjectBind" loading="{{workerProjectBinding}}" disabled="{{workerProjectBinding || workerProjectCode.length < 6}}">绑定</button>
      </view>
    </view>
  </view>
</view>
