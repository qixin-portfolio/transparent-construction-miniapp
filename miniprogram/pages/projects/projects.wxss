/* ================================================================
   工地列表 / 门店展示页
   ================================================================ */

/* ========== 门店展示页（业主） ========== */
.store-page {
  padding: 0 32rpx 48rpx;
}

/* 品牌 Banner */
.store-banner {
  margin: 24rpx 0 24rpx;
  padding: 48rpx 36rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #1B7A56 0%, #2AA876 100%);
  color: #FFFFFF;
}

.store-banner-brand {
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: 2rpx;
}

.store-banner-tags {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.store-banner-tag {
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 24rpx;
  font-weight: 500;
}

/* 进度快捷入口 */
.store-progress-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #1B7A56 0%, #2AA876 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 32rpx rgba(15, 106, 74, 0.2);
}

.store-progress-entry:active {
  opacity: 0.92;
}

.store-progress-left {
  flex: 1;
}

.store-progress-label {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.3;
}

.store-progress-hint {
  margin-top: 8rpx;
  font-size: 24rpx;
  opacity: 0.82;
}

.store-progress-arrow {
  font-size: 48rpx;
  line-height: 1;
  opacity: 0.7;
}

/* 品牌优势 */
.store-advantage-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.store-advantage-item {
  padding: 28rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 20rpx rgba(17, 24, 39, 0.03);
  box-sizing: border-box;
}

.advantage-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: #E8F5EE;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  line-height: 1;
  margin-bottom: 16rpx;
}

.advantage-title {
  color: #111827;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.3;
}

.advantage-desc {
  margin-top: 6rpx;
  color: #9CA3AF;
  font-size: 22rpx;
  line-height: 1.4;
}

/* 区块通用 */
.store-section {
  margin-bottom: 28rpx;
}

.store-section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 18rpx;
  padding: 0 8rpx;
}

/* 抖音账号 */
.douyin-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.douyin-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 20rpx rgba(17, 24, 39, 0.03);
}

.douyin-card:active {
  opacity: 0.92;
}

.douyin-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.douyin-avatar-text {
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
}

.douyin-info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.douyin-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
  line-height: 1.3;
}

.douyin-desc {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #6B7280;
  line-height: 1.35;
}

.douyin-id-row {
  margin-top: 8rpx;
  font-size: 24rpx;
}

.douyin-id-label {
  color: #9CA3AF;
}

.douyin-id-value {
  color: #1B7A56;
  font-weight: 600;
}

.douyin-copy {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: #1B7A56;
  color: #FFFFFF;
  font-size: 24rpx;
  line-height: 1.3;
  font-weight: 500;
}

/* 完工案例 */
.case-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.case-card {
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 24rpx rgba(17, 24, 39, 0.05);
  overflow: hidden;
}

.case-image-wrap {
  width: 100%;
  height: 400rpx;
  overflow: hidden;
}

.case-image {
  width: 100%;
  height: 100%;
}

.case-image-placeholder {
  width: 100%;
  height: 400rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #E8F5EE 0%, #F3F4F6 100%);
}

.case-image-ph-text {
  color: #9CA3AF;
  font-size: 26rpx;
}

.case-info {
  padding: 28rpx 28rpx 32rpx;
}

.case-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
  line-height: 1.35;
}

.case-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6B7280;
}

.case-budget {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #D9534F;
  font-weight: 600;
}

.case-highlight {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #6B7280;
  line-height: 1.5;
}

.case-plan {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #1B7A56;
  font-weight: 500;
}

.case-ref-badge {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(0, 0, 0, 0.6);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 600;
}

.case-auth-badge {
  position: absolute;
  bottom: 20rpx;
  left: 20rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(27, 122, 86, 0.92);
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 600;
}

.case-image-wrap {
  position: relative;
}

.case-actions-inline {
  display: flex;
  gap: 16rpx;
  margin-top: 18rpx;
}

.case-action-btn {
  flex: 1;
  height: 68rpx;
  line-height: 68rpx;
  text-align: center;
  border-radius: 16rpx;
  font-size: 24rpx;
  font-weight: 600;
}

.case-action-btn.primary {
  background: linear-gradient(135deg, #1B7A56, #2AA876);
  color: #FFFFFF;
}

.case-action-btn.outline {
  background: #FFFFFF;
  color: #1B7A56;
  border: 2rpx solid #1B7A56;
}

.case-more-entry {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  color: #1B7A56;
  font-size: 26rpx;
  font-weight: 600;
  box-shadow: 0 4rpx 16rpx rgba(13, 77, 54, 0.04);
}

.case-more-entry:active {
  opacity: 0.85;
}

.case-more-arrow {
  font-size: 32rpx;
}

/* 门店信息 */
.store-info-card {
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 20rpx rgba(17, 24, 39, 0.03);
  overflow: hidden;
}

.store-info-row {
  display: flex;
  align-items: center;
  padding: 28rpx;
  border-bottom: 1rpx solid #F3F4F6;
}

.store-info-row:last-child {
  border-bottom: none;
}

.store-info-row:active {
  background: #F9FAFB;
}

.store-info-icon {
  width: 56rpx;
  font-size: 32rpx;
  text-align: center;
  flex-shrink: 0;
}

.store-info-body {
  flex: 1;
  margin-left: 16rpx;
}

.store-info-text {
  font-size: 28rpx;
  color: #111827;
  line-height: 1.4;
}

.store-info-action {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #1B7A56;
  font-weight: 500;
}

/* 联系顾问 */
.store-contact-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 28rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 20rpx rgba(17, 24, 39, 0.03);
}

.store-contact-card:active {
  opacity: 0.92;
}

.store-contact-left {
  flex: 1;
}

.store-contact-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
}

.store-contact-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6B7280;
}

.store-contact-btn {
  flex-shrink: 0;
  padding: 16rpx 40rpx;
  border-radius: 999rpx;
  background: #1B7A56;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 500;
}

/* 底部 */
.store-footer {
  text-align: center;
  padding: 32rpx 0 16rpx;
}

.store-footer-text {
  font-size: 22rpx;
  color: #9CA3AF;
}

/* ========== 工地列表（内部员工） ========== */
.projects-page {
  padding: 32rpx;
  padding-bottom: 200rpx;
}

.projects-header {
  margin-bottom: 24rpx;
}

.projects-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #111827;
  line-height: 1.3;
}

.projects-subtitle {
  margin-top: 8rpx;
  color: #6B7280;
  font-size: 26rpx;
  line-height: 1.4;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 28rpx;
  height: 88rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 20rpx rgba(17, 24, 39, 0.04);
  margin-bottom: 20rpx;
}

.search-icon {
  font-size: 28rpx;
  color: #9CA3AF;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #111827;
  height: 100%;
}

/* 状态筛选 */
.status-filter {
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.status-filter::-webkit-scrollbar {
  display: none;
}

.status-filter-inner {
  display: flex;
  gap: 16rpx;
  width: max-content;
  padding-bottom: 4rpx;
}

/* 工地列表 */
.project-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.project-card {
  padding: 28rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 24rpx rgba(17, 24, 39, 0.04);
  box-sizing: border-box;
}

.project-card:active {
  opacity: 0.94;
}

.project-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.project-card-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
  line-height: 1.3;
  flex: 1;
  min-width: 0;
}

.project-card-address {
  margin-top: 8rpx;
  color: #6B7280;
  font-size: 24rpx;
  line-height: 1.4;
}

.project-progress {
  height: 16rpx;
  margin: 22rpx 0 14rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #E5E7EB;
}

.project-progress-bar {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #1B7A56 0%, #2AA876 100%);
}

.project-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.project-stage {
  color: #6B7280;
  font-size: 24rpx;
}

.project-percent {
  color: #1B7A56;
  font-size: 28rpx;
  font-weight: 700;
}

/* 空状态 */
.project-empty {
  padding: 80rpx 32rpx;
  text-align: center;
}

/* 悬浮新增按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 168rpx;
  z-index: 100;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #1B7A56 0%, #2AA876 100%);
  box-shadow: 0 8rpx 24rpx rgba(27, 122, 86, 0.3), 0 16rpx 40rpx rgba(27, 122, 86, 0.15);
}

.fab:active {
  opacity: 0.88;
  transform: scale(0.96);
}

.fab-icon {
  font-size: 44rpx;
  line-height: 1;
  color: #FFFFFF;
  font-weight: 300;
}

.fab-text {
  font-size: 20rpx;
  color: #FFFFFF;
  margin-top: 2rpx;
}

/* UI 1.1 · 工地列表 / 门店展示 */
.store-page,
.projects-page {
  min-height: 100vh;
  padding: 24rpx 28rpx calc(136rpx + env(safe-area-inset-bottom));
  background: #FAFBFC;
  box-sizing: border-box;
}

.store-banner {
  display: none;
}

.store-progress-entry {
  margin: 0 0 26rpx;
  padding: 24rpx 26rpx;
  border: 1rpx solid #E8ECF0;
  border-radius: 12rpx;
  background: #FFFFFF;
  color: #1A1A1A;
  box-shadow: 0 8rpx 22rpx rgba(24, 57, 45, 0.05);
}

.store-progress-label {
  color: #1A1A1A;
  font-size: 28rpx;
  font-weight: 800;
}

.store-progress-hint {
  color: #5C5C5C;
  font-size: 22rpx;
  opacity: 1;
}

.store-progress-arrow {
  color: #1B7A56;
  opacity: 1;
}

.store-advantage-grid {
  display: none;
}

.store-section {
  margin-bottom: 28rpx;
}

.store-section-head {
  padding: 0;
  margin-bottom: 14rpx;
}

.douyin-card,
.store-info-card,
.case-card,
.store-contact-card {
  border: 1rpx solid #E8ECF0;
  border-radius: 12rpx;
  background: #FFFFFF;
  box-shadow: none;
}

.douyin-avatar {
  width: 58rpx;
  height: 58rpx;
  background: #111111 !important;
}

.douyin-avatar-text {
  font-size: 22rpx;
}

.douyin-name,
.case-title,
.store-contact-title,
.projects-title,
.project-card-name {
  color: #1A1A1A;
  font-weight: 800;
}

.douyin-desc,
.case-meta,
.case-highlight,
.store-contact-desc,
.projects-subtitle,
.project-card-address,
.project-stage {
  color: #5C5C5C;
}

.douyin-copy,
.store-contact-btn {
  border-radius: 10rpx;
  background: #F3F4F6;
  color: #1B7A56;
  font-weight: 800;
}

.store-info-row {
  border-bottom-color: #F1E8D8;
}

.store-info-icon {
  color: #1B7A56;
}

.case-card {
  padding: 18rpx;
}

.case-image-wrap,
.case-image-placeholder {
  height: 260rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.case-image-placeholder {
  background: #E8ECF0;
}

.case-info {
  padding: 18rpx 2rpx 4rpx;
}

.projects-header {
  margin: 0 0 22rpx;
  padding: 0 4rpx;
}

.projects-title {
  font-size: 40rpx;
}

.search-bar {
  border: 1rpx solid #E8ECF0;
  border-radius: 10rpx;
  background: #FFFFFF;
  box-shadow: none;
}

.status-filter {
  margin: 18rpx 0;
}

.project-list {
  gap: 16rpx;
}

.project-card {
  border: 1rpx solid #E8ECF0;
  border-radius: 12rpx;
  background: #FFFFFF;
  box-shadow: none;
}

.project-progress {
  height: 10rpx;
  background: #E8ECF0;
}

.project-progress-bar {
  background: #1B7A56;
}

.project-card-footer {
  color: #5C5C5C;
}

.project-percent {
  color: #1B7A56;
  font-weight: 800;
}

.project-empty {
  border: 1rpx solid #E8ECF0;
  border-radius: 12rpx;
  background: #FFFFFF;
}

.fab {
  right: 34rpx;
  bottom: calc(132rpx + env(safe-area-inset-bottom));
  width: 106rpx;
  height: 106rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #1B7A56 0%, #2AA876 100%);
  box-shadow: 0 8rpx 24rpx rgba(27, 122, 86, 0.3), 0 16rpx 40rpx rgba(27, 122, 86, 0.15);
}

/* UI 1.2 · 对齐 figma-import 工地列表 / 门店展示 */
.store-page,
.projects-page {
  min-height: 100vh;
  padding: 0 32rpx calc(148rpx + env(safe-area-inset-bottom));
  background: #FAFBFC;
  box-sizing: border-box;
}

.store-banner {
  display: block;
  margin: 0 -32rpx 0;
  padding: 96rpx 48rpx 72rpx;
  border-radius: 0;
  background: linear-gradient(150deg, #0D4D36 0%, #1B7A56 50%, #2AA876 100%);
  color: #FFFFFF;
  box-shadow: none;
}

.store-banner-brand {
  font-size: 56rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.store-banner-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 36rpx;
}

.store-banner-tag {
  padding: 8rpx 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  font-size: 22rpx;
  font-weight: 700;
}

.brand-data-marquee {
  position: relative;
  z-index: 2;
  display: flex;
  justify-content: space-around;
  margin: -40rpx 0 40rpx;
  padding: 36rpx 20rpx;
  border-radius: 40rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.02);
}

.data-cell {
  flex: 1;
  text-align: center;
}

.data-num {
  color: #1B7A56;
  font-size: 40rpx;
  line-height: 1.15;
  font-weight: 800;
}

.data-label {
  margin-top: 6rpx;
  color: #6B7280;
  font-size: 22rpx;
  font-weight: 600;
}

.selling-points-card {
  margin-bottom: 40rpx;
  padding: 40rpx;
  border-radius: 40rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.02);
}

.selling-title {
  margin-bottom: 36rpx;
  color: #111827;
  font-size: 32rpx;
  font-weight: 800;
}

.point-row {
  display: flex;
  gap: 28rpx;
  margin-bottom: 32rpx;
}

.point-row:last-child {
  margin-bottom: 0;
}

.point-icon {
  flex-shrink: 0;
  font-size: 42rpx;
  line-height: 1;
}

.point-text {
  flex: 1;
}

.point-title {
  color: #111827;
  font-size: 28rpx;
  font-weight: 800;
}

.point-desc {
  margin-top: 8rpx;
  color: #6B7280;
  font-size: 24rpx;
  line-height: 1.5;
}

.store-progress-entry,
.douyin-card,
.store-info-card,
.case-card,
.store-contact-card {
  border: none;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.02);
}

.projects-page {
  padding-top: 32rpx;
}

.projects-header {
  margin-bottom: 28rpx;
}

.projects-title {
  color: #111827;
  font-size: 44rpx;
  font-weight: 800;
}

.search-bar,
.project-card,
.project-empty {
  border: none;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.02);
}

.project-card {
  padding: 36rpx;
}

.project-card-name {
  color: #111827;
  font-size: 32rpx;
  font-weight: 800;
}

.project-card-address {
  margin: 16rpx 0 24rpx;
  color: #6B7280;
}

.project-meta-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 28rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: #FAFBFC;
}

.project-meta-item {
  min-width: 0;
}

.meta-label {
  color: #9CA3AF;
  font-size: 22rpx;
}

.meta-value {
  margin-top: 4rpx;
  color: #111827;
  font-size: 24rpx;
  font-weight: 700;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.meta-value.emphasis {
  color: #1B7A56;
}

.project-progress {
  height: 12rpx;
  background: #E5E7EB;
}

.project-progress-bar {
  background: #1B7A56;
}

.project-percent {
  color: #1B7A56;
}

.fab {
  border-radius: 50%;
  background: linear-gradient(135deg, #1B7A56 0%, #2AA876 100%);
}

/* Stage 1 · 工地核心链路入口 */
.project-flow-panel {
  margin-bottom: 28rpx;
  padding: 32rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.02);
}

.project-flow-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 28rpx;
}

.project-flow-title {
  color: #111827;
  font-size: 30rpx;
  font-weight: 800;
}

.project-flow-desc {
  margin-top: 8rpx;
  color: #6B7280;
  font-size: 24rpx;
  line-height: 1.4;
}

.project-flow-action {
  flex-shrink: 0;
  padding: 12rpx 22rpx;
  border-radius: 18rpx;
  background: #1B7A56;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 800;
}

.project-stat-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.project-stat-item {
  padding: 20rpx 12rpx;
  border-radius: 24rpx;
  background: #FAFBFC;
  text-align: center;
}

.project-stat-item.active {
  background: #E8F5EE;
  box-shadow: inset 0 0 0 2rpx rgba(27, 122, 86, 0.12);
}

.project-stat-item:active {
  opacity: 0.85;
}

.project-stat-num {
  color: #1B7A56;
  font-size: 38rpx;
  line-height: 1.1;
  font-weight: 800;
}

.project-stat-num.warn {
  color: #F59E0B;
}

.project-stat-label {
  margin-top: 8rpx;
  color: #6B7280;
  font-size: 22rpx;
  font-weight: 700;
}

.project-card-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #F3F4F6;
}

.project-mini-btn,
.project-mini-badge {
  min-width: 128rpx;
  padding: 14rpx 20rpx;
  border-radius: 18rpx;
  background: #FAFBFC;
  color: #111827;
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 800;
  text-align: center;
}

.project-mini-btn.primary {
  background: #E8F5EE;
  color: #1B7A56;
}

.project-mini-btn.checkin {
  background: #FFF8E1;
  color: #8A5A00;
}

.project-mini-btn.danger {
  background: #FEE2E2;
  color: #D9534F;
}

.project-mini-badge {
  background: #E8F5EE;
  color: #1B7A56;
}

.projects-page.worker-page {
  display: flex;
  flex-direction: column;
}

.worker-page .projects-header {
  order: 1;
}

.worker-page .project-list {
  order: 2;
}

.worker-page .project-flow-panel {
  order: 3;
}

.worker-page .project-empty {
  order: 2;
}

.worker-page .fab,
.worker-page .worker-bind-mask {
  order: 4;
}

/* Stage 2 · 门店预约转化 */
.store-page {
  padding-bottom: calc(360rpx + env(safe-area-inset-bottom));
}

.store-conversion-card {
  margin-bottom: 32rpx;
  padding: 36rpx 32rpx;
  border-radius: 40rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.02);
}

.conversion-title {
  color: #111827;
  font-size: 32rpx;
  line-height: 1.3;
  font-weight: 800;
}

.conversion-steps {
  display: flex;
  align-items: flex-start;
  margin-top: 30rpx;
}

.conversion-step {
  width: 108rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.conversion-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #E5E7EB;
  color: #6B7280;
  font-size: 22rpx;
  line-height: 44rpx;
  font-weight: 800;
  text-align: center;
}

.conversion-step.active .conversion-dot {
  background: #1B7A56;
  color: #FFFFFF;
}

.conversion-text {
  margin-top: 12rpx;
  color: #6B7280;
  font-size: 22rpx;
  line-height: 1.25;
  font-weight: 700;
  text-align: center;
}

.conversion-line {
  flex: 1;
  height: 4rpx;
  margin-top: 20rpx;
  background: #E5E7EB;
}

.conversion-main-btn {
  height: 88rpx;
  margin-top: 34rpx;
  border-radius: 28rpx;
  background: #1B7A56;
  color: #FFFFFF;
  font-size: 28rpx;
  line-height: 88rpx;
  font-weight: 800;
}

.conversion-main-btn::after {
  border: none;
}

.store-contact-card {
  gap: 24rpx;
}

.store-contact-actions {
  flex-shrink: 0;
  display: flex;
  gap: 12rpx;
}

.store-contact-btn.secondary {
  background: #E8F5EE;
  color: #1B7A56;
}

.store-bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(128rpx + env(safe-area-inset-bottom));
  z-index: 900;
  display: grid;
  grid-template-columns: 0.78fr 1.22fr;
  gap: 20rpx;
  padding: 18rpx 32rpx 20rpx;
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid #E5E7EB;
  box-sizing: border-box;
}

.store-bottom-btn {
  height: 88rpx;
  margin: 0;
  border-radius: 28rpx;
  font-size: 28rpx;
  line-height: 88rpx;
  font-weight: 800;
}

.store-bottom-btn::after {
  border: none;
}

.store-bottom-btn.secondary {
  background: #E8F5EE;
  color: #1B7A56;
}

.store-bottom-btn.primary {
  background: #1B7A56;
  color: #FFFFFF;
}

.appointment-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 30000;
  display: flex;
  align-items: flex-end;
  padding: 0;
  background: rgba(17, 24, 39, 0.48);
  box-sizing: border-box;
}

.appointment-panel {
  width: 100%;
  max-height: calc(100vh - 160rpx);
  padding: 36rpx 32rpx calc(52rpx + env(safe-area-inset-bottom));
  border-radius: 40rpx 40rpx 0 0;
  background: #FFFFFF;
  box-sizing: border-box;
  overflow-y: auto;
  position: relative;
  z-index: 30001;
  -webkit-overflow-scrolling: touch;
}

.appointment-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 28rpx;
}

.appointment-title {
  color: #111827;
  font-size: 34rpx;
  line-height: 1.3;
  font-weight: 800;
}

.appointment-desc {
  margin-top: 8rpx;
  color: #6B7280;
  font-size: 24rpx;
  line-height: 1.45;
}

.appointment-close {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #F3F4F6;
  color: #6B7280;
  font-size: 36rpx;
  line-height: 52rpx;
  text-align: center;
}

.appointment-form {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.appointment-input,
.appointment-textarea {
  border: none;
  border-radius: 24rpx;
  background: #FAFBFC;
}

.appointment-textarea {
  min-height: 160rpx;
}

.appointment-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  height: 88rpx;
  margin-top: 28rpx;
  margin-bottom: 8rpx;
  border-radius: 24rpx;
  box-sizing: border-box;
  line-height: 88rpx;
}

.project-worker-tip {
  margin-top: 24rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #E8F5EE;
}

.project-worker-tip-main {
  color: #1B7A56;
  font-size: 28rpx;
  line-height: 1.35;
  font-weight: 900;
}

.project-worker-tip-sub {
  margin-top: 8rpx;
  color: #5C5C5C;
  font-size: 24rpx;
  line-height: 1.45;
}

.worker-bind-inline-btn,
.worker-bind-empty-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  height: 84rpx;
  margin: 22rpx 0 0;
  padding: 0 18rpx;
  border-radius: 24rpx;
  box-sizing: border-box;
  background: #1B7A56;
  color: #FFFFFF;
  font-size: 28rpx;
  line-height: 84rpx;
  font-weight: 900;
  overflow: hidden;
  text-align: center;
  white-space: nowrap;
}

.worker-bind-empty-btn {
  width: 360rpx;
  max-width: 100%;
  margin-left: auto;
  margin-right: auto;
}

.worker-bind-inline-btn::after,
.worker-bind-empty-btn::after,
.worker-bind-btn::after {
  border: none;
}

.worker-bind-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 3000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  background: rgba(17, 24, 39, 0.52);
  box-sizing: border-box;
}

.worker-bind-dialog {
  width: 100%;
  max-width: 620rpx;
  padding: 48rpx 40rpx 36rpx;
  overflow: hidden;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-sizing: border-box;
}

.worker-bind-title {
  color: #1A1A1A;
  font-size: 36rpx;
  line-height: 1.3;
  font-weight: 900;
  text-align: center;
}

.worker-bind-desc {
  margin-top: 14rpx;
  color: #5C5C5C;
  font-size: 25rpx;
  line-height: 1.5;
  text-align: center;
}

.worker-bind-code-input {
  width: 100%;
  margin: 36rpx 0 32rpx;
  height: 104rpx;
  padding: 0 24rpx;
  border: 2rpx solid #E8ECF0;
  border-radius: 24rpx;
  background: #FAFBFC;
  color: #1A1A1A;
  font-size: 48rpx;
  letter-spacing: 20rpx;
  font-weight: 900;
  text-align: center;
  box-sizing: border-box;
}

.worker-bind-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16rpx;
  width: 100%;
  box-sizing: border-box;
}

.worker-bind-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-width: 0;
  max-width: 100%;
  height: 88rpx;
  margin: 0;
  padding: 0;
  border-radius: 26rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  line-height: 88rpx;
  font-weight: 900;
  overflow: hidden;
  text-align: center;
}

.worker-bind-cancel {
  background: #F3F4F6;
  color: #5C5C5C;
}

.worker-bind-confirm {
  background: #1B7A56;
  color: #FFFFFF;
}

.worker-bind-confirm[disabled] {
  background: #C8DBD2;
  color: rgba(255, 255, 255, 0.72);
}

/* UI 4.2 · P2 门店展示 / 预约转化 */
.store-page {
  background: #F7F8F4;
}

.store-banner {
  position: relative;
  margin: 0 -32rpx 0;
  padding: 60rpx 44rpx 48rpx;
  overflow: hidden;
  border-radius: 0 0 36rpx 36rpx;
  background: linear-gradient(150deg, #0B573D 0%, #127A55 56%, #23966C 100%);
  box-sizing: border-box;
}

.store-banner-copy {
  position: relative;
  z-index: 2;
  min-width: 0;
}

.store-banner-kicker {
  display: inline-flex;
  align-items: center;
  min-height: 40rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  color: rgba(255, 255, 255, 0.86);
  font-size: 22rpx;
  line-height: 40rpx;
  font-weight: 700;
}

.store-banner-brand {
  margin-top: 16rpx;
  font-size: 52rpx;
  line-height: 1.15;
  font-weight: 900;
  color: #FFFFFF;
  letter-spacing: 4rpx;
}

.store-banner-address-row {
  margin-top: 10rpx;
}

.store-banner-address {
  color: rgba(255, 255, 255, 0.72);
  font-size: 24rpx;
  line-height: 1.4;
}

.store-banner-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.store-banner-tag {
  padding: 6rpx 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.12);
  color: rgba(255, 255, 255, 0.9);
  font-size: 22rpx;
  font-weight: 600;
}

/* 顾问双人卡片 */
.advisor-duo {
  position: relative;
  z-index: 3;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
  margin: -30rpx 0 24rpx;
  padding: 0 8rpx;
}

.advisor-card {
  display: flex;
  align-items: center;
  padding: 22rpx 18rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 32rpx rgba(15, 55, 39, 0.06);
  box-sizing: border-box;
}

.advisor-card:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.advisor-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  flex-shrink: 0;
  border: 2rpx solid #E8F5EE;
}

.advisor-info {
  flex: 1;
  margin-left: 16rpx;
  min-width: 0;
}

.advisor-name {
  color: #111827;
  font-size: 26rpx;
  font-weight: 700;
  line-height: 1.3;
}

.advisor-subtitle {
  margin-top: 2rpx;
  color: #6B7280;
  font-size: 20rpx;
  line-height: 1.3;
}

.advisor-role {
  margin-top: 2rpx;
  color: #9CA3AF;
  font-size: 18rpx;
  line-height: 1.3;
}

.advisor-arrow {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 4rpx;
  margin-left: 8rpx;
}

.advisor-douyin-label {
  color: #127A55;
  font-size: 20rpx;
  font-weight: 600;
}

.advisor-arrow-icon {
  color: #127A55;
  font-size: 28rpx;
  line-height: 1;
  font-weight: 600;
}

.brand-data-marquee,
.selling-points-card,
.store-conversion-card,
.store-progress-entry,
.store-info-card,
.store-contact-card,
.case-card,
.douyin-card {
  border-radius: 28rpx;
  box-shadow: 0 10rpx 34rpx rgba(15, 55, 39, 0.045);
}

.brand-data-marquee {
  margin: -34rpx 0 28rpx;
  padding: 30rpx 14rpx;
}

.data-num {
  color: #127A55;
}

.store-conversion-card {
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(18, 122, 85, 0.08);
}

.conversion-main-btn,
.store-bottom-btn.primary {
  background: #127A55;
}

.store-progress-entry {
  border: 1rpx solid rgba(18, 122, 85, 0.08);
}

.case-image-wrap,
.case-image-placeholder {
  height: 300rpx;
  border-radius: 22rpx;
}

.case-card {
  padding: 20rpx;
}

.case-info {
  padding: 20rpx 4rpx 2rpx;
}

.store-bottom-bar {
  box-shadow: 0 -10rpx 36rpx rgba(15, 55, 39, 0.08);
}
