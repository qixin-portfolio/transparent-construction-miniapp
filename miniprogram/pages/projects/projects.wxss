/* ================================================================
   工地列表 / 门店展示页
   ================================================================ */

/* ========== 门店展示页（业主） ========== */
.store-page {
  padding: 0 32rpx 48rpx;
}

/* 品牌 Banner */
.store-banner {
  margin: 24rpx 0 24rpx;
  padding: 48rpx 36rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #0F6A4A 0%, #1F8B61 100%);
  color: #FFFFFF;
}

.store-banner-brand {
  font-size: 52rpx;
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: 2rpx;
}

.store-banner-slogan {
  margin-top: 12rpx;
  font-size: 30rpx;
  opacity: 0.88;
}

.store-banner-tags {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.store-banner-tag {
  padding: 8rpx 24rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.18);
  font-size: 24rpx;
  font-weight: 500;
}

/* 进度快捷入口 */
.store-progress-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #0F6A4A 0%, #1F8B61 100%);
  color: #FFFFFF;
  box-shadow: 0 8rpx 32rpx rgba(15, 106, 74, 0.2);
}

.store-progress-entry:active {
  opacity: 0.92;
}

.store-progress-left {
  flex: 1;
}

.store-progress-label {
  font-size: 34rpx;
  font-weight: 600;
  line-height: 1.3;
}

.store-progress-hint {
  margin-top: 8rpx;
  font-size: 24rpx;
  opacity: 0.82;
}

.store-progress-arrow {
  font-size: 48rpx;
  line-height: 1;
  opacity: 0.7;
}

/* 品牌优势 */
.store-advantage-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.store-advantage-item {
  padding: 28rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 20rpx rgba(17, 24, 39, 0.03);
  box-sizing: border-box;
}

.advantage-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  background: #EAF7F1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  line-height: 1;
  margin-bottom: 16rpx;
}

.advantage-title {
  color: #111827;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.3;
}

.advantage-desc {
  margin-top: 6rpx;
  color: #9CA3AF;
  font-size: 22rpx;
  line-height: 1.4;
}

/* 区块通用 */
.store-section {
  margin-bottom: 28rpx;
}

.store-section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 18rpx;
  padding: 0 8rpx;
}

/* 抖音账号 */
.douyin-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.douyin-card {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 20rpx rgba(17, 24, 39, 0.03);
}

.douyin-card:active {
  opacity: 0.92;
}

.douyin-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.douyin-avatar-text {
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
}

.douyin-info {
  flex: 1;
  margin-left: 20rpx;
  min-width: 0;
}

.douyin-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #111827;
  line-height: 1.3;
}

.douyin-desc {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #6B7280;
  line-height: 1.35;
}

.douyin-id-row {
  margin-top: 8rpx;
  font-size: 24rpx;
}

.douyin-id-label {
  color: #9CA3AF;
}

.douyin-id-value {
  color: #0F6A4A;
  font-weight: 600;
}

.douyin-copy {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  background: #0F6A4A;
  color: #FFFFFF;
  font-size: 24rpx;
  line-height: 1.3;
  font-weight: 500;
}

/* 完工案例 */
.case-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.case-card {
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 24rpx rgba(17, 24, 39, 0.05);
  overflow: hidden;
}

.case-image-wrap {
  width: 100%;
  height: 400rpx;
  overflow: hidden;
}

.case-image {
  width: 100%;
  height: 100%;
}

.case-image-placeholder {
  width: 100%;
  height: 400rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #EAF7F1 0%, #F3F4F6 100%);
}

.case-image-ph-text {
  color: #9CA3AF;
  font-size: 26rpx;
}

.case-info {
  padding: 28rpx 28rpx 32rpx;
}

.case-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
  line-height: 1.35;
}

.case-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6B7280;
}

.case-budget {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #D9534F;
  font-weight: 600;
}

.case-highlight {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #6B7280;
  line-height: 1.5;
}

/* 门店信息 */
.store-info-card {
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 20rpx rgba(17, 24, 39, 0.03);
  overflow: hidden;
}

.store-info-row {
  display: flex;
  align-items: center;
  padding: 28rpx;
  border-bottom: 1rpx solid #F3F4F6;
}

.store-info-row:last-child {
  border-bottom: none;
}

.store-info-row:active {
  background: #F9FAFB;
}

.store-info-icon {
  width: 56rpx;
  font-size: 32rpx;
  text-align: center;
  flex-shrink: 0;
}

.store-info-body {
  flex: 1;
  margin-left: 16rpx;
}

.store-info-text {
  font-size: 28rpx;
  color: #111827;
  line-height: 1.4;
}

.store-info-action {
  margin-top: 4rpx;
  font-size: 24rpx;
  color: #0F6A4A;
  font-weight: 500;
}

/* 联系顾问 */
.store-contact-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 28rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 20rpx rgba(17, 24, 39, 0.03);
}

.store-contact-card:active {
  opacity: 0.92;
}

.store-contact-left {
  flex: 1;
}

.store-contact-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
}

.store-contact-desc {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #6B7280;
}

.store-contact-btn {
  flex-shrink: 0;
  padding: 16rpx 40rpx;
  border-radius: 999rpx;
  background: #0F6A4A;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 500;
}

/* 底部 */
.store-footer {
  text-align: center;
  padding: 32rpx 0 16rpx;
}

.store-footer-text {
  font-size: 22rpx;
  color: #9CA3AF;
}

/* ========== 工地列表（内部员工） ========== */
.projects-page {
  padding: 32rpx;
  padding-bottom: 200rpx;
}

.projects-header {
  margin-bottom: 24rpx;
}

.projects-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #111827;
  line-height: 1.3;
}

.projects-subtitle {
  margin-top: 8rpx;
  color: #6B7280;
  font-size: 26rpx;
  line-height: 1.4;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 0 28rpx;
  height: 88rpx;
  border-radius: 28rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 20rpx rgba(17, 24, 39, 0.04);
  margin-bottom: 20rpx;
}

.search-icon {
  font-size: 28rpx;
  color: #9CA3AF;
  flex-shrink: 0;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #111827;
  height: 100%;
}

/* 状态筛选 */
.status-filter {
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.status-filter::-webkit-scrollbar {
  display: none;
}

.status-filter-inner {
  display: flex;
  gap: 16rpx;
  width: max-content;
  padding-bottom: 4rpx;
}

/* 工地列表 */
.project-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.project-card {
  padding: 28rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 4rpx 24rpx rgba(17, 24, 39, 0.04);
  box-sizing: border-box;
}

.project-card:active {
  opacity: 0.94;
}

.project-card-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}

.project-card-name {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
  line-height: 1.3;
  flex: 1;
  min-width: 0;
}

.project-card-address {
  margin-top: 8rpx;
  color: #6B7280;
  font-size: 24rpx;
  line-height: 1.4;
}

.project-progress {
  height: 16rpx;
  margin: 22rpx 0 14rpx;
  overflow: hidden;
  border-radius: 999rpx;
  background: #E5E7EB;
}

.project-progress-bar {
  height: 100%;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #0F6A4A 0%, #1F8B61 100%);
}

.project-card-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.project-stage {
  color: #6B7280;
  font-size: 24rpx;
}

.project-percent {
  color: #0F6A4A;
  font-size: 28rpx;
  font-weight: 700;
}

/* 空状态 */
.project-empty {
  padding: 80rpx 32rpx;
  text-align: center;
}

/* 悬浮新增按钮 */
.fab {
  position: fixed;
  right: 40rpx;
  bottom: 168rpx;
  z-index: 100;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  background: #0F6A4A;
  box-shadow: 0 12rpx 32rpx rgba(15, 106, 74, 0.35);
}

.fab:active {
  opacity: 0.88;
  transform: scale(0.96);
}

.fab-icon {
  font-size: 44rpx;
  line-height: 1;
  color: #FFFFFF;
  font-weight: 300;
}

.fab-text {
  font-size: 20rpx;
  color: #FFFFFF;
  margin-top: 2rpx;
}

/* UI 1.1 · 工地列表 / 门店展示 */
.store-page,
.projects-page {
  min-height: 100vh;
  padding: 24rpx 28rpx calc(136rpx + env(safe-area-inset-bottom));
  background: #F8F4EA;
  box-sizing: border-box;
}

.store-banner {
  display: none;
}

.store-progress-entry {
  margin: 0 0 26rpx;
  padding: 24rpx 26rpx;
  border: 1rpx solid #E9DDC8;
  border-radius: 12rpx;
  background: #FFFDF7;
  color: #173E33;
  box-shadow: 0 8rpx 22rpx rgba(24, 57, 45, 0.05);
}

.store-progress-label {
  color: #173E33;
  font-size: 28rpx;
  font-weight: 800;
}

.store-progress-hint {
  color: #6C776F;
  font-size: 22rpx;
  opacity: 1;
}

.store-progress-arrow {
  color: #147657;
  opacity: 1;
}

.store-advantage-grid {
  display: none;
}

.store-section {
  margin-bottom: 28rpx;
}

.store-section-head {
  padding: 0;
  margin-bottom: 14rpx;
}

.douyin-card,
.store-info-card,
.case-card,
.store-contact-card {
  border: 1rpx solid #E9DDC8;
  border-radius: 12rpx;
  background: #FFFDF7;
  box-shadow: none;
}

.douyin-avatar {
  width: 58rpx;
  height: 58rpx;
  background: #111111 !important;
}

.douyin-avatar-text {
  font-size: 22rpx;
}

.douyin-name,
.case-title,
.store-contact-title,
.projects-title,
.project-card-name {
  color: #173E33;
  font-weight: 800;
}

.douyin-desc,
.case-meta,
.case-highlight,
.store-contact-desc,
.projects-subtitle,
.project-card-address,
.project-stage {
  color: #6C776F;
}

.douyin-copy,
.store-contact-btn {
  border-radius: 10rpx;
  background: #F1E7D4;
  color: #147657;
  font-weight: 800;
}

.store-info-row {
  border-bottom-color: #F1E8D8;
}

.store-info-icon {
  color: #147657;
}

.case-card {
  padding: 18rpx;
}

.case-image-wrap,
.case-image-placeholder {
  height: 260rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.case-image-placeholder {
  background: #D7CDB8;
}

.case-info {
  padding: 18rpx 2rpx 4rpx;
}

.projects-header {
  margin: 0 0 22rpx;
  padding: 0 4rpx;
}

.projects-title {
  font-size: 40rpx;
}

.search-bar {
  border: 1rpx solid #E9DDC8;
  border-radius: 10rpx;
  background: #FFFDF7;
  box-shadow: none;
}

.status-filter {
  margin: 18rpx 0;
}

.project-list {
  gap: 16rpx;
}

.project-card {
  border: 1rpx solid #E9DDC8;
  border-radius: 12rpx;
  background: #FFFDF7;
  box-shadow: none;
}

.project-progress {
  height: 10rpx;
  background: #E4DCCB;
}

.project-progress-bar {
  background: #147657;
}

.project-card-footer {
  color: #6C776F;
}

.project-percent {
  color: #147657;
  font-weight: 800;
}

.project-empty {
  border: 1rpx solid #E9DDC8;
  border-radius: 12rpx;
  background: #FFFDF7;
}

.fab {
  right: 34rpx;
  bottom: calc(132rpx + env(safe-area-inset-bottom));
  width: 106rpx;
  height: 106rpx;
  border-radius: 28rpx;
  background: #147657;
  box-shadow: 0 10rpx 24rpx rgba(20, 118, 87, 0.22);
}

/* UI 1.2 · 对齐 figma-import 工地列表 / 门店展示 */
.store-page,
.projects-page {
  min-height: 100vh;
  padding: 0 32rpx calc(148rpx + env(safe-area-inset-bottom));
  background: #F8FAF9;
  box-sizing: border-box;
}

.store-banner {
  display: block;
  margin: 0 -32rpx 0;
  padding: 96rpx 48rpx 72rpx;
  border-radius: 0;
  background: linear-gradient(180deg, #073B28 0%, #0F6A4A 100%);
  color: #FFFFFF;
  box-shadow: none;
}

.store-banner-brand {
  font-size: 56rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.store-banner-slogan {
  margin-top: 12rpx;
  font-size: 28rpx;
  opacity: 0.82;
}

.store-banner-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 36rpx;
}

.store-banner-tag {
  padding: 8rpx 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.24);
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.14);
  font-size: 22rpx;
  font-weight: 700;
}

.brand-data-marquee {
  position: relative;
  z-index: 2;
  display: flex;
  justify-content: space-around;
  margin: -40rpx 0 40rpx;
  padding: 36rpx 20rpx;
  border-radius: 40rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.02);
}

.data-cell {
  flex: 1;
  text-align: center;
}

.data-num {
  color: #0F6A4A;
  font-size: 40rpx;
  line-height: 1.15;
  font-weight: 800;
}

.data-label {
  margin-top: 6rpx;
  color: #6B7280;
  font-size: 22rpx;
  font-weight: 600;
}

.selling-points-card {
  margin-bottom: 40rpx;
  padding: 40rpx;
  border-radius: 40rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.02);
}

.selling-title {
  margin-bottom: 36rpx;
  color: #111827;
  font-size: 32rpx;
  font-weight: 800;
}

.point-row {
  display: flex;
  gap: 28rpx;
  margin-bottom: 32rpx;
}

.point-row:last-child {
  margin-bottom: 0;
}

.point-icon {
  flex-shrink: 0;
  font-size: 42rpx;
  line-height: 1;
}

.point-text {
  flex: 1;
}

.point-title {
  color: #111827;
  font-size: 28rpx;
  font-weight: 800;
}

.point-desc {
  margin-top: 8rpx;
  color: #6B7280;
  font-size: 24rpx;
  line-height: 1.5;
}

.store-progress-entry,
.douyin-card,
.store-info-card,
.case-card,
.store-contact-card {
  border: none;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.02);
}

.projects-page {
  padding-top: 32rpx;
}

.projects-header {
  margin-bottom: 28rpx;
}

.projects-title {
  color: #111827;
  font-size: 44rpx;
  font-weight: 800;
}

.search-bar,
.project-card,
.project-empty {
  border: none;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.02);
}

.project-card {
  padding: 36rpx;
}

.project-card-name {
  color: #111827;
  font-size: 32rpx;
  font-weight: 800;
}

.project-card-address {
  margin: 16rpx 0 24rpx;
  color: #6B7280;
}

.project-meta-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
  margin-bottom: 28rpx;
  padding: 20rpx;
  border-radius: 24rpx;
  background: #F8FAF9;
}

.project-meta-item {
  min-width: 0;
}

.meta-label {
  color: #9CA3AF;
  font-size: 22rpx;
}

.meta-value {
  margin-top: 4rpx;
  color: #111827;
  font-size: 24rpx;
  font-weight: 700;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.meta-value.emphasis {
  color: #0F6A4A;
}

.project-progress {
  height: 12rpx;
  background: #E5E7EB;
}

.project-progress-bar {
  background: #0F6A4A;
}

.project-percent {
  color: #0F6A4A;
}

.fab {
  border-radius: 50%;
  background: #0F6A4A;
}

/* Stage 1 · 工地核心链路入口 */
.project-flow-panel {
  margin-bottom: 28rpx;
  padding: 32rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.02);
}

.project-flow-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 28rpx;
}

.project-flow-title {
  color: #111827;
  font-size: 30rpx;
  font-weight: 800;
}

.project-flow-desc {
  margin-top: 8rpx;
  color: #6B7280;
  font-size: 24rpx;
  line-height: 1.4;
}

.project-flow-action {
  flex-shrink: 0;
  padding: 12rpx 22rpx;
  border-radius: 18rpx;
  background: #0F6A4A;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 800;
}

.project-stat-row {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.project-stat-item {
  padding: 20rpx 12rpx;
  border-radius: 24rpx;
  background: #F8FAF9;
  text-align: center;
}

.project-stat-num {
  color: #0F6A4A;
  font-size: 38rpx;
  line-height: 1.1;
  font-weight: 800;
}

.project-stat-num.warn {
  color: #F59E0B;
}

.project-stat-label {
  margin-top: 8rpx;
  color: #6B7280;
  font-size: 22rpx;
  font-weight: 700;
}

.project-card-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #F3F4F6;
}

.project-mini-btn,
.project-mini-badge {
  min-width: 128rpx;
  padding: 14rpx 20rpx;
  border-radius: 18rpx;
  background: #F8FAF9;
  color: #111827;
  font-size: 24rpx;
  line-height: 1.2;
  font-weight: 800;
  text-align: center;
}

.project-mini-btn.primary {
  background: #EAF7F1;
  color: #0F6A4A;
}

.project-mini-badge {
  background: #EAF7F1;
  color: #0F6A4A;
}

/* Stage 2 · 门店预约转化 */
.store-page {
  padding-bottom: calc(220rpx + env(safe-area-inset-bottom));
}

.store-conversion-card {
  margin-bottom: 32rpx;
  padding: 36rpx 32rpx;
  border-radius: 40rpx;
  background: #FFFFFF;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.02);
}

.conversion-title {
  color: #111827;
  font-size: 32rpx;
  line-height: 1.3;
  font-weight: 800;
}

.conversion-steps {
  display: flex;
  align-items: flex-start;
  margin-top: 30rpx;
}

.conversion-step {
  width: 108rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.conversion-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #E5E7EB;
  color: #6B7280;
  font-size: 22rpx;
  line-height: 44rpx;
  font-weight: 800;
  text-align: center;
}

.conversion-step.active .conversion-dot {
  background: #0F6A4A;
  color: #FFFFFF;
}

.conversion-text {
  margin-top: 12rpx;
  color: #6B7280;
  font-size: 22rpx;
  line-height: 1.25;
  font-weight: 700;
  text-align: center;
}

.conversion-line {
  flex: 1;
  height: 4rpx;
  margin-top: 20rpx;
  background: #E5E7EB;
}

.conversion-main-btn {
  height: 88rpx;
  margin-top: 34rpx;
  border-radius: 28rpx;
  background: #0F6A4A;
  color: #FFFFFF;
  font-size: 28rpx;
  line-height: 88rpx;
  font-weight: 800;
}

.conversion-main-btn::after {
  border: none;
}

.store-contact-card {
  gap: 24rpx;
}

.store-contact-actions {
  flex-shrink: 0;
  display: flex;
  gap: 12rpx;
}

.store-contact-btn.secondary {
  background: #EAF7F1;
  color: #0F6A4A;
}

.store-bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 120;
  display: grid;
  grid-template-columns: 0.78fr 1.22fr;
  gap: 20rpx;
  padding: 20rpx 32rpx calc(24rpx + env(safe-area-inset-bottom));
  background: rgba(255, 255, 255, 0.96);
  border-top: 1rpx solid #E5E7EB;
}

.store-bottom-btn {
  height: 88rpx;
  margin: 0;
  border-radius: 28rpx;
  font-size: 28rpx;
  line-height: 88rpx;
  font-weight: 800;
}

.store-bottom-btn::after {
  border: none;
}

.store-bottom-btn.secondary {
  background: #EAF7F1;
  color: #0F6A4A;
}

.store-bottom-btn.primary {
  background: #0F6A4A;
  color: #FFFFFF;
}

.appointment-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 300;
  display: flex;
  align-items: flex-end;
  background: rgba(17, 24, 39, 0.48);
}

.appointment-panel {
  width: 100%;
  padding: 36rpx 32rpx calc(36rpx + env(safe-area-inset-bottom));
  border-radius: 40rpx 40rpx 0 0;
  background: #FFFFFF;
  box-sizing: border-box;
}

.appointment-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 28rpx;
}

.appointment-title {
  color: #111827;
  font-size: 34rpx;
  line-height: 1.3;
  font-weight: 800;
}

.appointment-desc {
  margin-top: 8rpx;
  color: #6B7280;
  font-size: 24rpx;
  line-height: 1.45;
}

.appointment-close {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #F3F4F6;
  color: #6B7280;
  font-size: 36rpx;
  line-height: 52rpx;
  text-align: center;
}

.appointment-form {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.appointment-input,
.appointment-textarea {
  border: none;
  border-radius: 24rpx;
  background: #F8FAF9;
}

.appointment-textarea {
  min-height: 160rpx;
}

.appointment-submit {
  margin-top: 28rpx;
}
