<!-- ========== 业主端：品牌营销首页 ========== -->
<view wx:if="{{isOwner}}" class="store-page">
  <!-- 品牌 Banner — 实景门店展示 -->
  <view class="store-banner">
    <view class="store-banner-copy">
      <view class="store-banner-kicker">🏠 交城本地老品牌</view>
      <view class="store-banner-brand">{{storeBrandName}}</view>
      <view class="store-banner-address-row">
        <text class="store-banner-address">📍 {{storeInfo.address}}</text>
      </view>
      <view class="store-banner-tags">
        <text wx:for="{{storeTags}}" wx:key="*this" class="store-banner-tag">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 顾问双人卡片 -->
  <view class="advisor-duo">
    <view
      wx:for="{{advisors}}"
      wx:key="name"
      class="advisor-card"
      data-douyin="{{item.douyinId}}"
      data-name="{{item.name}}"
      bindtap="copyAdvisorDouyin">
      <image class="advisor-avatar" src="{{item.avatar}}" mode="aspectFill"></image>
      <view class="advisor-info">
        <view class="advisor-name">{{item.name}}</view>
        <view class="advisor-subtitle">{{item.subtitle}}</view>
        <view class="advisor-role">{{item.role}}</view>
      </view>
      <view class="advisor-arrow">
        <text class="advisor-douyin-label">抖音</text>
        <text class="advisor-arrow-icon">›</text>
      </view>
    </view>
  </view>

  <!-- 品牌数据 -->
  <view class="brand-data-marquee">
    <view class="data-cell">
      <view class="data-num">28年</view>
      <view class="data-label">交城本地服务</view>
    </view>
    <view class="data-cell">
      <view class="data-num">100%</view>
      <view class="data-label">透明工地标准</view>
    </view>
    <view class="data-cell">
      <view class="data-num">5000+</view>
      <view class="data-label">本土落地样板</view>
    </view>
  </view>

  <view class="selling-points-card">
    <view class="selling-title">为什么选择晟景透明工地？</view>
    <view class="point-row">
      <view class="point-icon">👁</view>
      <view class="point-text">
        <view class="point-title">0 距离云端监工</view>
        <view class="point-desc">不用频繁跑工地，关键节点照片和日报集中沉淀。</view>
      </view>
    </view>
    <view class="point-row">
      <view class="point-icon">🛡</view>
      <view class="point-text">
        <view class="point-title">28 年本土实体闭环</view>
        <view class="point-desc">交城本土实体老品牌，设计、施工、售后责任清晰。</view>
      </view>
    </view>
  </view>

  <view class="store-conversion-card">
    <view class="conversion-title">从了解晟景到开工交付</view>
    <view class="conversion-steps">
      <view class="conversion-step active">
        <view class="conversion-dot">1</view>
        <view class="conversion-text">预约咨询</view>
      </view>
      <view class="conversion-line"></view>
      <view class="conversion-step">
        <view class="conversion-dot">2</view>
        <view class="conversion-text">到店量房</view>
      </view>
      <view class="conversion-line"></view>
      <view class="conversion-step">
        <view class="conversion-dot">3</view>
        <view class="conversion-text">报价签约</view>
      </view>
      <view class="conversion-line"></view>
      <view class="conversion-step">
        <view class="conversion-dot">4</view>
        <view class="conversion-text">透明工地</view>
      </view>
    </view>
    <button class="conversion-main-btn" bindtap="showAppointment">预约免费量房设计</button>
  </view>

  <!-- 进度快捷入口 -->
  <view class="store-progress-entry" bindtap="goOwnerProgress">
    <view class="store-progress-left">
      <view class="store-progress-label">我的施工进度</view>
      <view class="store-progress-hint">{{hasOwnerProject ? '点击查看最新工地进展' : '点击绑定工地查看进度'}}</view>
    </view>
    <view class="store-progress-arrow">›</view>
  </view>

  <!-- 品牌优势 -->
  <view class="store-advantage-grid">
    <view class="store-advantage-item">
      <view class="advantage-icon">🏗</view>
      <view class="advantage-title">透明工地</view>
      <view class="advantage-desc">每个节点照片留痕</view>
    </view>
    <view class="store-advantage-item">
      <view class="advantage-icon">✓</view>
      <view class="advantage-title">审核机制</view>
      <view class="advantage-desc">审核后业主可见</view>
    </view>
    <view class="store-advantage-item">
      <view class="advantage-icon">📅</view>
      <view class="advantage-title">28年经验</view>
      <view class="advantage-desc">交城本地老品牌</view>
    </view>
    <view class="store-advantage-item">
      <view class="advantage-icon">🎨</view>
      <view class="advantage-title">整装定制</view>
      <view class="advantage-desc">设计施工一体化</view>
    </view>
  </view>

  <!-- 完工案例 -->
  <view class="store-section">
    <view class="store-section-head">
      <view class="sub-title">完工案例</view>
      <view class="muted">{{caseSource === 'real' ? '真实完工 · 业主授权' : '品牌参考案例'}}</view>
    </view>
    <view class="case-list">
      <view
        wx:for="{{showcaseCases}}"
        wx:key="_id"
        class="case-card"
        data-id="{{item._id}}"
        bindtap="goCaseDetail">
        <view class="case-image-wrap">
          <image wx:if="{{item.coverImage}}" class="case-image" src="{{item.coverImage}}" mode="aspectFill" lazy-load></image>
          <view wx:else class="case-image-placeholder">
            <view class="case-image-ph-text">照片待上传</view>
          </view>
          <view wx:if="{{item.isReference}}" class="case-ref-badge">品牌参考</view>
          <view wx:if="{{item.authorizationLabel}}" class="case-auth-badge">{{item.authorizationLabel}}</view>
        </view>
        <view class="case-info">
          <view class="case-title">{{item.displayTitle}}</view>
          <view class="case-meta">{{item.displaySubtitle}}</view>
          <view class="case-plan">方案类型：{{item.displayPlanType}}</view>
          <view wx:if="{{item.displayHighlights}}" class="case-highlight">{{item.displayHighlights}}</view>
          <view class="case-actions-inline">
            <view class="case-action-btn primary" catchtap="goCaseDetail" data-id="{{item._id}}">查看案例</view>
            <view class="case-action-btn outline" catchtap="showAppointment">预约量房</view>
          </view>
        </view>
      </view>
    </view>
    <view class="case-more-entry" bindtap="goCaseList">
      <text>查看全部完工案例</text>
      <text class="case-more-arrow">›</text>
    </view>
  </view>

  <!-- 门店信息 -->
  <view class="store-section">
    <view class="store-section-head">
      <view class="sub-title">门店信息</view>
    </view>
    <view class="store-info-card">
      <view class="store-info-row" bindtap="openMap">
        <view class="store-info-icon">📍</view>
        <view class="store-info-body">
          <view class="store-info-text">{{storeInfo.address}}</view>
          <view class="store-info-action">点击导航</view>
        </view>
      </view>
      <view class="store-info-row" bindtap="callStore">
        <view class="store-info-icon">📞</view>
        <view class="store-info-body">
          <view class="store-info-text">{{storeInfo.phone}}</view>
          <view class="store-info-action">点击拨打</view>
        </view>
      </view>
      <view class="store-info-row">
        <view class="store-info-icon">🕐</view>
        <view class="store-info-body">
          <view class="store-info-text">{{storeInfo.hours}}</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 联系专属顾问 -->
  <view class="store-section">
    <view class="store-contact-card">
      <view class="store-contact-left">
        <view class="store-contact-title">联系专属顾问</view>
        <view class="store-contact-desc">{{contactInfo.name}} · 有装修问题随时咨询</view>
      </view>
      <view class="store-contact-actions">
        <view class="store-contact-btn secondary" bindtap="contactAdvisor">电话</view>
        <view class="store-contact-btn" bindtap="showAppointment">预约</view>
      </view>
    </view>
  </view>

  <view class="store-footer">
    <view class="store-footer-text">{{storeBrandName}} · 透明工地</view>
  </view>

  <view class="store-bottom-bar">
    <button class="store-bottom-btn secondary" bindtap="contactAdvisor">电话咨询</button>
    <button class="store-bottom-btn primary" bindtap="showAppointment">预约量房设计</button>
  </view>

  <view wx:if="{{appointmentVisible}}" class="appointment-mask" bindtap="hideAppointment">
    <view class="appointment-panel" catchtap="noop">
      <view class="appointment-head">
        <view>
          <view class="appointment-title">预约免费量房设计</view>
          <view class="appointment-desc">留下基本信息，顾问会联系确认时间。</view>
        </view>
        <view class="appointment-close" bindtap="hideAppointment">×</view>
      </view>
      <view class="appointment-form">
        <input class="input appointment-input" placeholder="您的姓名" value="{{appointmentForm.name}}" data-key="name" bindinput="onAppointmentInput" />
        <input class="input appointment-input" placeholder="手机号" type="number" maxlength="11" value="{{appointmentForm.phone}}" data-key="phone" bindinput="onAppointmentInput" />
        <input class="input appointment-input" placeholder="小区/地址，可不填" value="{{appointmentForm.address}}" data-key="address" bindinput="onAppointmentInput" />
        <textarea class="textarea appointment-textarea" placeholder="装修需求、户型面积、预算，可不填" value="{{appointmentForm.need}}" data-key="need" bindinput="onAppointmentInput"></textarea>
      </view>
      <button class="button-primary appointment-submit" loading="{{appointmentSubmitting}}" disabled="{{appointmentSubmitting}}" bindtap="submitAppointment">提交预约</button>
    </view>
  </view>
</view>

<!-- ========== 内部员工端：工地列表 ========== -->
<view wx:else class="projects-page {{isWorker ? 'worker-page' : ''}}">
  <view class="projects-header">
    <view class="projects-title">{{isWorker ? '我的工地' : '工地'}}</view>
    <view class="projects-subtitle">{{isWorker ? '只显示已绑定的工地，每个工地由管理端发码加入' : '内部人员按权限查看相关工地'}}</view>
  </view>

  <view class="project-flow-panel">
    <view class="project-flow-head">
      <view>
        <view class="project-flow-title">{{isWorker ? '今日主要任务' : '核心业务链路'}}</view>
        <view class="project-flow-desc">{{isWorker ? '到场打卡 → 拍照 → 上传日报' : '建工地 → 上传日报 → 审核发布 → 业主查看'}}</view>
      </view>
      <view wx:if="{{canCreate}}" class="project-flow-action" bindtap="goCreate">新建工地</view>
    </view>
    <view wx:if="{{!isWorker}}" class="project-stat-row">
      <view class="project-stat-item {{statusFilter === '' ? 'active' : ''}}" data-status="" bindtap="onStatusFilter">
        <view class="project-stat-num">{{projectStats.total}}</view>
        <view class="project-stat-label">全部工地</view>
      </view>
      <view class="project-stat-item {{statusFilter === '施工中' ? 'active' : ''}}" data-status="施工中" bindtap="onStatusFilter">
        <view class="project-stat-num">{{projectStats.active}}</view>
        <view class="project-stat-label">施工中</view>
      </view>
      <view class="project-stat-item {{statusFilter === 'unbound' ? 'active' : ''}}" data-status="unbound" bindtap="onStatusFilter">
        <view class="project-stat-num warn">{{projectStats.unbound}}</view>
        <view class="project-stat-label">未绑业主</view>
      </view>
    </view>
    <view wx:else class="project-worker-tip">
      <view class="project-worker-tip-main">当前可查看 {{projectStats.total}} 个绑定工地</view>
      <view class="project-worker-tip-sub">当前账号没有全部工地权限，只能操作已绑定工地。</view>
      <button class="worker-bind-inline-btn" bindtap="showWorkerProjectBind">{{projectStats.total === 0 ? '输入工地绑定码' : '绑定新工地'}}</button>
    </view>
  </view>

  <!-- 搜索栏 -->
  <view wx:if="{{!isWorker}}" class="search-bar">
    <view class="search-icon">🔍</view>
    <input class="search-input" placeholder="搜索工地名称或地址" value="{{searchKeyword}}" bindinput="onSearch" confirm-type="search" />
  </view>

  <!-- 状态筛选 -->
  <scroll-view wx:if="{{!isWorker}}" class="status-filter" scroll-x enable-flex>
    <view class="status-filter-inner">
      <view class="filter-tab {{statusFilter === '' ? 'filter-tab-active' : ''}}" data-status="" bindtap="onStatusFilter">全部</view>
      <view class="filter-tab {{statusFilter === '施工中' ? 'filter-tab-active' : ''}}" data-status="施工中" bindtap="onStatusFilter">施工中</view>
      <view class="filter-tab {{statusFilter === '待审核' ? 'filter-tab-active' : ''}}" data-status="待审核" bindtap="onStatusFilter">待审核</view>
      <view class="filter-tab {{statusFilter === '已完工' ? 'filter-tab-active' : ''}}" data-status="已完工" bindtap="onStatusFilter">已完工</view>
    </view>
  </scroll-view>

  <!-- 工地列表 -->
  <view wx:if="{{projects.length}}" class="project-list">
    <view wx:for="{{projects}}" wx:key="_id" class="project-card" data-id="{{item._id}}" bindtap="goDetail">
      <view class="project-card-head">
        <view class="project-card-name">{{item.name}}</view>
        <view class="tag {{item.statusCode === 'completed' || item.statusCode === 'delivered' ? 'tag-info' : 'tag-success'}}">{{item.statusText || item.status || '施工中'}}</view>
      </view>
      <view class="project-card-address">{{item.address || '未填写地址'}}</view>
      <view class="project-meta-grid">
        <view class="project-meta-item">
          <view class="meta-label">当前阶段</view>
          <view class="meta-value">{{item.currentStage || '未设置'}}</view>
        </view>
        <view class="project-meta-item">
          <view class="meta-label">进度</view>
          <view class="meta-value emphasis">{{item.progress || 0}}%</view>
        </view>
        <view class="project-meta-item">
          <view class="meta-label">状态</view>
          <view class="meta-value">{{item.statusText || item.status || '施工中'}}</view>
        </view>
      </view>
      <view class="project-progress">
        <view class="project-progress-bar" style="width: {{item.progress || 0}}%;"></view>
      </view>
      <view class="project-card-footer">
        <view class="project-stage">当前节点：{{item.currentStage || '未设置'}}</view>
        <view class="project-percent">{{item.progress || 0}}%</view>
      </view>
      <view class="project-card-actions">
        <view class="project-mini-btn primary" wx:if="{{canUpload}}" data-id="{{item._id}}" data-name="{{item.name}}" catchtap="goUploadFromProject">写日报</view>
        <view class="project-mini-btn checkin" wx:if="{{isWorker}}" data-id="{{item._id}}" catchtap="recordWorkerCheckinFromProject">{{workerCheckingProjectId === item._id ? '打卡中' : '到场打卡'}}</view>
        <view class="project-mini-btn" data-id="{{item._id}}" catchtap="goDetail">看详情</view>
        <view class="project-mini-btn" wx:if="{{canManageOwner && !item.ownerOpenid}}" data-id="{{item._id}}" catchtap="goBindFromProject">绑业主</view>
        <view class="project-mini-badge" wx:if="{{item.ownerOpenid}}">业主已绑定</view>
        <view class="project-mini-btn danger" wx:if="{{canDelete}}" data-id="{{item._id}}" data-name="{{item.name}}" catchtap="deleteProject">删除</view>
      </view>
    </view>
  </view>

  <view wx:else class="project-empty">
    <view class="empty-title">{{loading ? '正在加载' : '暂无工地'}}</view>
    <view class="muted">{{loading ? '工地数据加载中...' : (isWorker ? '请输入管理端发放的工地绑定码' : (searchKeyword ? '没有匹配的工地' : '点击右下角按钮新增工地'))}}</view>
    <button wx:if="{{!loading && isWorker}}" class="worker-bind-empty-btn" bindtap="showWorkerProjectBind">输入工地绑定码</button>
  </view>

  <!-- 悬浮新增按钮 -->
  <view wx:if="{{canCreate}}" class="fab" bindtap="goCreate">
    <view class="fab-icon">+</view>
    <view class="fab-text">新增</view>
  </view>

  <view wx:if="{{workerProjectCodeVisible}}" class="worker-bind-mask" bindtap="hideWorkerProjectBind">
    <view class="worker-bind-dialog" catchtap="noop">
      <view class="worker-bind-title">绑定我的工地</view>
      <view class="worker-bind-desc">输入管理员、老板或项目经理在工地详情里生成的 6 位工长绑定码。</view>
      <input class="worker-bind-code-input" type="number" maxlength="6" placeholder="请输入 6 位绑定码" value="{{workerProjectCode}}" bindinput="onWorkerProjectCodeInput" />
      <view class="worker-bind-actions">
        <button class="worker-bind-btn worker-bind-cancel" bindtap="hideWorkerProjectBind" disabled="{{workerProjectBinding}}">取消</button>
        <button class="worker-bind-btn worker-bind-confirm" bindtap="confirmWorkerProjectBind" loading="{{workerProjectBinding}}" disabled="{{workerProjectBinding || workerProjectCode.length < 6}}">绑定</button>
      </view>
    </view>
  </view>
</view>
