<view class="page">
  <view class="section row">
    <view>
      <view class="title">审核日报</view>
      <view class="muted">通过后业主才能看到该工序和照片。</view>
    </view>
    <view class="tag">{{items.length}} 条</view>
  </view>

  <view wx:if="{{items.length}}" class="list">
    <view wx:for="{{items}}" wx:key="_id" class="card">
      <view class="row">
        <view class="sub-title">{{item.projectName || '未命名工地'}}</view>
        <view class="tag">{{item.stage}}</view>
      </view>
      <view class="muted">{{item.workContent}}</view>
      <view wx:if="{{item.issue}}" class="muted danger">问题：{{item.issue}}</view>
      <view class="review-actions">
        <button class="button-secondary" data-id="{{item._id}}" data-action="reject" bindtap="review">退回</button>
        <button class="button-primary" data-id="{{item._id}}" data-action="approve" bindtap="review">通过</button>
      </view>
    </view>
  </view>

  <view wx:else class="card empty">
    {{loading ? '正在加载待审核日报...' : '暂无待审核日报'}}
  </view>
</view>
