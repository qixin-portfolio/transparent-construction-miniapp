.owner-page {
  padding-bottom: 54rpx;
}

.bind-panel {
  margin-top: 12rpx;
}

.bind-input {
  margin: 24rpx 0;
  text-align: center;
  font-size: 34rpx;
  font-weight: 700;
  letter-spacing: 0;
}

.owner-hero {
  position: relative;
  overflow: hidden;
  background: #fffaf2;
}

.hero-head {
  align-items: flex-start;
}

.progress-number {
  margin-top: 34rpx;
  color: #1f6f54;
  font-size: 70rpx;
  line-height: 1;
  font-weight: 800;
}

.progress {
  height: 16rpx;
  margin: 24rpx 0 16rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: #e5ded0;
}

.progress-bar {
  height: 100%;
  border-radius: 8rpx;
  background: #1f6f54;
}

.current-stage {
  color: #1f3f34;
  font-size: 30rpx;
  line-height: 1.4;
  font-weight: 700;
}

.owner-metrics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 28rpx;
}

.owner-metric {
  min-height: 112rpx;
  padding: 18rpx 12rpx;
  box-sizing: border-box;
  border-radius: 8rpx;
  background: #f4eddf;
}

.metric-value {
  color: #1f3f34;
  font-size: 34rpx;
  line-height: 1.2;
  font-weight: 800;
}

.metric-value.short {
  display: -webkit-box;
  min-height: 40rpx;
  overflow: hidden;
  font-size: 25rpx;
  line-height: 1.25;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}

.metric-label {
  margin-top: 8rpx;
  color: #718076;
  font-size: 22rpx;
  line-height: 1.3;
}

.section-head {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 18rpx;
  margin: 4rpx 0 18rpx;
}

.photo-wall {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 14rpx;
}

.photo-tile {
  position: relative;
  height: 220rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: #e5ded0;
}

.photo {
  width: 100%;
  height: 100%;
}

.photo-caption {
  position: absolute;
  right: 10rpx;
  bottom: 10rpx;
  max-width: 220rpx;
  min-height: 42rpx;
  padding: 0 12rpx;
  overflow: hidden;
  border-radius: 8rpx;
  background: rgba(31, 63, 52, 0.82);
  color: #fffaf2;
  font-size: 22rpx;
  line-height: 42rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.timeline {
  position: relative;
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.timeline-item {
  position: relative;
  margin-left: 22rpx;
}

.timeline-dot {
  position: absolute;
  top: 34rpx;
  left: -32rpx;
  width: 18rpx;
  height: 18rpx;
  border: 6rpx solid #f6f3ed;
  border-radius: 50%;
  background: #1f6f54;
}

.log-content {
  margin-top: 18rpx;
  color: #24342d;
  font-size: 28rpx;
  line-height: 1.55;
}

.inline-photos {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 12rpx;
  margin-top: 20rpx;
}

.inline-photo {
  width: 100%;
  height: 170rpx;
  border-radius: 8rpx;
  background: #e5ded0;
}
