<view class="page">
  <view class="section">
    <view class="title">新增客户</view>
    <view class="muted">先把来源、需求和跟进状态记下来。</view>
  </view>

  <view class="section list">
    <input class="input" placeholder="客户姓名" value="{{form.name}}" data-key="name" bindinput="onInput" />
    <input class="input" placeholder="手机号" type="number" value="{{form.phone}}" data-key="phone" bindinput="onInput" />
    <input class="input" placeholder="客户来源，如抖音、老客户介绍" value="{{form.source}}" data-key="source" bindinput="onInput" />
    <input class="input" placeholder="小区/地址" value="{{form.address}}" data-key="address" bindinput="onInput" />
    <textarea class="textarea" placeholder="客户需求、预算、风格偏好" value="{{form.need}}" data-key="need" bindinput="onInput"></textarea>
  </view>

  <button class="button-primary" loading="{{submitting}}" disabled="{{submitting}}" bindtap="submit">保存客户</button>
</view>
