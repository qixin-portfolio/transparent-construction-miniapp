/* 晟景透明工地 · 自定义底部导航 */
/* 干净、轻量、有呼吸感 · 选中绿色圆形背景 */

.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: space-around;
  height: 128rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #FFFFFF;
  box-shadow: 0 -2rpx 20rpx rgba(17, 24, 39, 0.05);
  border-top: none;
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 100%;
  gap: 6rpx;
  position: relative;
}

.tab-icon {
  width: 48rpx;
  height: 48rpx;
  background-size: 48rpx 48rpx;
  background-repeat: no-repeat;
  background-position: center;
  transition: all 0.2s ease;
}

.tab-text {
  font-size: 20rpx;
  line-height: 1.2;
  color: #9CA3AF;
  font-weight: 500;
  transition: color 0.2s ease;
}

/* 图标 - 默认态 */
.tab-icon-home {
  background-image: url("data:image/svg+xml;base64,");
}

.tab-icon-site {
  background-image: url("data:image/svg+xml;base64,");
}

.tab-icon-user {
  background-image: url("data:image/svg+xml;base64,");
}

/* 选中态 - 图标变绿 */
.tab-item-active .tab-icon-home {
  background-image: url("data:image/svg+xml;base64,");
}

.tab-item-active .tab-icon-site {
  background-image: url("data:image/svg+xml;base64,");
}

.tab-item-active .tab-icon-user {
  background-image: url("data:image/svg+xml;base64,");
}

.tab-item-active .tab-text {
  color: #0F6A4A;
  font-weight: 600;
}

.tab-item:active {
  opacity: 0.7;
}

/* UI 1.1 · 底部导航贴合总览图：轻白底、深绿选中、保留安全区 */
.tab-bar {
  height: 112rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(255, 253, 247, 0.96);
  box-shadow: 0 -8rpx 24rpx rgba(24, 57, 45, 0.06);
  border-top: 1rpx solid #E9DDC8;
}

.tab-item {
  gap: 4rpx;
}

.tab-icon {
  width: 38rpx;
  height: 38rpx;
  background-size: 38rpx 38rpx;
  opacity: 0.72;
}

.tab-text {
  color: #98A098;
  font-size: 22rpx;
  font-weight: 600;
}

.tab-item-active::before {
  content: "";
  position: absolute;
  top: 12rpx;
  width: 44rpx;
  height: 6rpx;
  border-radius: 999rpx;
  background: #147657;
}

.tab-item-active .tab-icon {
  opacity: 1;
}

.tab-item-active .tab-text {
  color: #147657;
  font-weight: 800;
}

/* UI 1.2 · 对齐 figma-import BottomTabBar */
.tab-bar {
  height: 128rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: #FFFFFF;
  border-top: 1rpx solid #E5E7EB;
  box-shadow: none;
}

.tab-item {
  gap: 4rpx;
}

.tab-item-active::before {
  display: none;
}

.tab-icon {
  width: 42rpx;
  height: 42rpx;
  background-size: 42rpx 42rpx;
  opacity: 1;
}

.tab-text {
  color: #9CA3AF;
  font-size: 22rpx;
  font-weight: 500;
}

.tab-item-active .tab-text {
  color: #0F6A4A;
  font-weight: 700;
}
